---
import SkillsGrid from "./SkillsGrid.astro";
import { PROFILE } from "../data/profile";
import { ptBrDict } from "../i18n/dictionaries";
import { getLocalizedCareer, getLocalizedEducation } from "../data/career";
import P5Title from "./p5/P5Title.astro";
import P5Badge from "./p5/P5Badge.astro";

const career = getLocalizedCareer("pt-br");
const education = getLocalizedEducation("pt-br");
---

<section
  id="about"
  class="relative bg-space-base px-4 pb-16 sm:px-8 sm:pb-20 md:px-12 md:pb-24 text-paper-white select-none overflow-hidden"
  aria-label={ptBrDict.about.sectionAria}
  data-i18n="about.sectionAria"
  data-i18n-attr="aria-label"
>
  <div
    data-p5-section-cut="works-to-about"
    aria-hidden="true"
    class="p5-section-cut p5-section-cut--right -mx-4 sm:-mx-8 md:-mx-12 mb-12 sm:mb-16 bg-paper-white"
  ></div>

  <div class="mx-auto mb-12 sm:mb-16 max-w-[140rem]">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 pb-4 border-b-4 border-bebop-red">
      <div>
        <span
          class="mb-2 block font-mono text-xs sm:text-sm font-bold tracking-widest text-bebop-red uppercase"
          data-i18n="about.actTag"
        >
          {ptBrDict.about.actTag}
        </span>
        <P5Title
          text={ptBrDict.about.title}
          data-about-title
          data-i18n="about.title"
          class="font-display text-[clamp(2.2rem,6vw,5rem)] font-black tracking-tight text-paper-white leading-none uppercase"
        />
      </div>

      <div class="flex flex-col sm:items-end text-left sm:text-right font-mono text-xs text-muted-gray">
        <P5Badge class="font-bold text-space-base bg-bebop-red px-2.5 py-0.5 border border-paper-white" data-i18n="about.statusBadge">
          {ptBrDict.about.statusBadge}
        </P5Badge>
        <span class="mt-1.5 text-[10px] sm:text-xs text-muted-gray tracking-wider" data-i18n="about.domainLine">
          {ptBrDict.about.domainLine}
        </span>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-[140rem] grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
    <div
      data-about-avatar-panel
      class="lg:col-span-5 flex flex-col items-center lg:items-start"
    >
      <div
        class="relative w-full max-w-[24rem] sm:max-w-[26rem] mx-auto lg:mx-0 border-4 border-paper-white bg-space-surface-1 p-3 sm:p-4 shadow-[8px_8px_0_var(--color-bebop-red)] overflow-hidden group transition-transform duration-300 hover:-translate-y-1"
      >
        <div class="relative overflow-hidden border-2 border-paper-white bg-space-base">
          <img
            id="about-official-avatar"
            src="/assets/brinu-avatar.jpg"
            alt={ptBrDict.about.portraitAlt}
            data-i18n="about.portraitAlt"
            data-i18n-attr="alt"
            width={341}
            height={394}
            class="w-full h-auto aspect-[341/394] object-cover contrast-125 transition-transform duration-500 group-hover:scale-[1.03]"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="mt-3 flex items-center justify-between font-mono text-xs">
          <span
            class="inline-flex items-center gap-1.5 border-2 border-paper-white bg-bebop-red px-2.5 py-1 text-[11px] font-display font-black text-paper-white uppercase tracking-wide"
            data-i18n="about.operatorTag"
          >
            {ptBrDict.about.operatorTag}
          </span>
          <span class="text-[10px] sm:text-xs text-paper-white uppercase font-bold">
            ID: {PROFILE.operatorId} // {PROFILE.location.label}
          </span>
        </div>
      </div>
    </div>

    <div
      data-about-content-panel
      class="lg:col-span-7 flex flex-col justify-between border-4 border-paper-white bg-space-surface-1 p-6 sm:p-8 md:p-10 shadow-[8px_8px_0_var(--color-bebop-red)]"
    >
      <div>
        <div class="mb-6 border-b-2 border-bebop-red pb-5">
          <h3
            class="font-display text-2xl sm:text-3xl md:text-4xl font-black text-paper-white leading-tight uppercase"
            data-i18n="about.roleHeading"
          >
            {ptBrDict.about.roleHeading}
          </h3>
        </div>

        <div class="space-y-4 font-body text-sm sm:text-base text-paper-white/95 leading-relaxed mb-8">
          <p data-i18n="about.bioP1">{ptBrDict.about.bioP1}</p>
          <p data-i18n="about.bioP2">{ptBrDict.about.bioP2}</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 border-2 border-paper-white bg-space-base p-4 font-mono text-xs">
          <div class="border-b sm:border-b-0 sm:border-r border-paper-white/25 pb-2 sm:pb-0 sm:pr-3">
            <span class="block text-bebop-red font-bold uppercase tracking-wider" data-i18n="about.stats.roleLabel">
              {ptBrDict.about.stats.roleLabel}
            </span>
            <span class="text-paper-white font-semibold" data-i18n="about.stats.roleValue">
              {ptBrDict.about.stats.roleValue}
            </span>
          </div>
          <div>
            <span class="block text-bebop-red font-bold uppercase tracking-wider" data-i18n="about.stats.baseLabel">
              {ptBrDict.about.stats.baseLabel}
            </span>
            <span class="text-paper-white font-semibold" data-i18n="about.stats.baseValue">
              {ptBrDict.about.stats.baseValue}
            </span>
          </div>
          <div class="border-t border-paper-white/25 pt-2 sm:pr-3 sm:border-r">
            <span class="block text-bebop-red font-bold uppercase tracking-wider" data-i18n="about.stats.coreLabel">
              {ptBrDict.about.stats.coreLabel}
            </span>
            <span class="text-paper-white font-semibold" data-i18n="about.stats.coreValue">
              {ptBrDict.about.stats.coreValue}
            </span>
          </div>
          <div class="border-t border-paper-white/25 pt-2">
            <span class="block text-bebop-red font-bold uppercase tracking-wider" data-i18n="about.stats.stackLabel">
              {ptBrDict.about.stats.stackLabel}
            </span>
            <span class="text-paper-white font-semibold" data-i18n="about.stats.stackValue">
              {ptBrDict.about.stats.stackValue}
            </span>
          </div>
        </div>

        <div data-career class="mt-8">
          <h4 class="mb-4 font-mono text-xs font-black uppercase tracking-widest text-bebop-red" data-i18n="about.careerTitle">
            {ptBrDict.about.careerTitle}
          </h4>
          <ol class="flex flex-col gap-4 border-l-4 border-bebop-red pl-4">
            {career.map((entry) => (
              <li id={`career-${entry.id}`} data-career-entry class="flex flex-col gap-1">
                <span data-career-period class="font-mono text-[11px] font-bold uppercase text-muted-gray">{entry.period}</span>
                <span class="font-display text-base sm:text-lg font-black uppercase text-paper-white">
                  <span data-career-role>{entry.role}</span> <span class="text-bebop-red">@</span> <span data-career-org>{entry.org}</span>
                </span>
                <p data-career-summary class="font-body text-sm text-paper-white/90 leading-relaxed">{entry.summary}</p>
                {entry.automations.length > 0 && (
                  <div class="mt-1 flex flex-wrap items-center gap-2 font-mono text-[11px]">
                    <span class="font-black uppercase text-bebop-red" data-i18n="about.automationsLabel">{ptBrDict.about.automationsLabel}</span>
                    {entry.automations.map((automation) => (
                      <a
                        href={automation.repoUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        data-automation-link={automation.id}
                        class="border border-paper-white px-2 py-0.5 font-bold uppercase text-paper-white transition-colors duration-150 hover:bg-paper-white hover:text-space-base"
                      >
                        {automation.name} ↗
                      </a>
                    ))}
                  </div>
                )}
              </li>
            ))}
          </ol>
        </div>

        <div data-education class="mt-8">
          <h4 class="mb-4 font-mono text-xs font-black uppercase tracking-widest text-bebop-red" data-i18n="about.educationTitle">
            {ptBrDict.about.educationTitle}
          </h4>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {education.map((entry) => (
              <li id={`education-${entry.id}`} data-education-entry class="border-2 border-paper-white/40 p-3">
                <span class="block font-display text-sm font-black uppercase text-paper-white">{entry.institution}</span>
                <span data-education-course class="block font-body text-sm text-paper-white/90">{entry.course}</span>
                <span class="mt-1 flex flex-wrap gap-2 font-mono text-[10px] uppercase">
                  <span data-education-period class="text-muted-gray">{entry.period}</span>
                  <span data-education-status class="font-black text-bebop-red">{entry.status}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-[140rem]">
    <SkillsGrid />
  </div>
</section>

<script>
  import { gsap } from "../utils/motion";

  let isAboutInitialized = false;

  function setupAboutScroll() {
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (prefersReducedMotion) return;
    if (isAboutInitialized) return;
    isAboutInitialized = true;

    const aboutSection = document.getElementById("about");
    const avatarPanel = document.querySelector("[data-about-avatar-panel]");
    const contentPanel = document.querySelector("[data-about-content-panel]");
    const skillsMatrix = document.querySelector("[data-skills-matrix]");

    if (aboutSection && avatarPanel && contentPanel) {
      gsap.fromTo(
        [avatarPanel, contentPanel],
        { opacity: 0, y: 35 },
        {
          scrollTrigger: {
            trigger: aboutSection,
            start: "top 80%",
            once: true,
          },
          opacity: 1,
          y: 0,
          duration: 0.8,
          stagger: 0.2,
          ease: "power2.out",
          force3D: true,
        }
      );
    }

    if (skillsMatrix) {
      gsap.fromTo(
        skillsMatrix,
        { opacity: 0, y: 30 },
        {
          scrollTrigger: {
            trigger: skillsMatrix,
            start: "top 85%",
            once: true,
          },
          opacity: 1,
          y: 0,
          duration: 0.8,
          ease: "power2.out",
          force3D: true,
        }
      );
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupAboutScroll);
  } else {
    setupAboutScroll();
  }
  document.addEventListener("astro:page-load", () => {
    isAboutInitialized = false;
    setupAboutScroll();
  });
</script>
