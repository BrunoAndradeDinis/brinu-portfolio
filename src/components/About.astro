---
import { PROFILE } from "../data/profile";
import { ptBrDict } from "../i18n/dictionaries";
import { CAREER, getLocalizedCareer, getLocalizedEducation } from "../data/career";
import P5Title from "./p5/P5Title.astro";
import P5Badge from "./p5/P5Badge.astro";
import P5Panel from "./p5/P5Panel.astro";

const career = getLocalizedCareer("pt-br");
const education = getLocalizedEducation("pt-br");
const currentId = CAREER.find((entry) => entry.end === "present")?.id;
---

<section
  id="about"
  class="relative bg-space-base px-4 pb-16 sm:px-8 sm:pb-20 md:px-12 md:pb-24 text-paper-white select-none overflow-hidden"
  aria-label={ptBrDict.about.sectionAria}
  data-i18n="about.sectionAria"
  data-i18n-attr="aria-label"
>
  <div
    data-p5-section-cut="works-to-about"
    aria-hidden="true"
    class="p5-section-cut p5-section-cut--right -mx-4 sm:-mx-8 md:-mx-12 mb-12 sm:mb-16 bg-paper-white"
  ></div>

  <div class="mx-auto mb-12 sm:mb-16 max-w-[140rem]">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 pb-4 border-b-4 border-bebop-red">
      <div>
        <span
          class="mb-2 block font-mono text-xs sm:text-sm font-bold tracking-widest text-bebop-red uppercase"
          data-i18n="about.actTag"
        >
          {ptBrDict.about.actTag}
        </span>
        <P5Title
          text={ptBrDict.about.title}
          data-about-title
          data-i18n="about.title"
          class="font-display text-[clamp(2.2rem,6vw,5rem)] font-black tracking-tight text-paper-white leading-none uppercase"
        />
      </div>

      <div class="flex flex-col sm:items-end text-left sm:text-right font-mono text-xs text-muted-gray">
        <P5Badge class="font-bold text-space-base bg-bebop-red px-2.5 py-0.5 border border-paper-white" data-i18n="about.statusBadge">
          {ptBrDict.about.statusBadge}
        </P5Badge>
        <span class="mt-1.5 text-[10px] sm:text-xs text-muted-gray tracking-wider" data-i18n="about.domainLine">
          {ptBrDict.about.domainLine}
        </span>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-[140rem] grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
    <div
      data-about-avatar-panel
      class="lg:col-span-5 flex flex-col items-center lg:items-start"
    >
      <div class="relative w-full max-w-[24rem] sm:max-w-[26rem] mx-auto lg:mx-0 py-4">
        <div
          data-about-portrait-frame
          class="relative rotate-[-4deg] bg-bebop-red p-[0.45rem] sm:p-[0.6rem] [clip-path:polygon(7%_0%,100%_5%,93%_100%,0%_95%)]"
        >
          <div class="relative overflow-hidden bg-space-base [clip-path:polygon(7%_0%,100%_5%,93%_100%,0%_95%)]">
            <img
              id="about-official-avatar"
              src="/assets/brinu-avatar.jpg"
              alt={ptBrDict.about.portraitAlt}
              data-i18n="about.portraitAlt"
              data-i18n-attr="alt"
              width={341}
              height={394}
              class="w-full h-auto aspect-[341/394] object-cover contrast-125 rotate-[4deg] scale-[1.12]"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
        <div class="mt-4 flex items-center justify-between gap-3 font-mono text-xs">
          <span
            class="inline-flex items-center gap-1.5 border-2 border-paper-white bg-bebop-red px-2.5 py-1 text-[11px] font-display font-black text-space-base uppercase tracking-wider"
            data-i18n="about.operatorTag"
          >
            {ptBrDict.about.operatorTag}
          </span>
          <span class="text-[10px] sm:text-xs text-paper-white uppercase font-bold">
            ID: {PROFILE.operatorId} // {PROFILE.location.label}
          </span>
        </div>
      </div>
    </div>

    <div data-about-content-panel class="lg:col-span-7 flex flex-col gap-6">
      <P5Panel as="div" cut="a" data-about-card="bio" class="bg-space-surface-1 border-l-8 border-bebop-red p-6 sm:p-8 text-paper-white">
        <p data-about-bio-line data-i18n="about.bioLine1" class="font-display text-lg sm:text-2xl font-black uppercase leading-tight">
          {ptBrDict.about.bioLine1}
        </p>
        <p data-about-bio-line data-i18n="about.bioLine2" class="mt-3 font-body text-sm sm:text-base leading-relaxed text-paper-white">
          {ptBrDict.about.bioLine2}
        </p>
        <p data-about-base-line data-i18n="about.baseLine" class="mt-5 inline-block bg-bebop-red px-3 py-1 font-mono text-[11px] sm:text-xs font-black uppercase tracking-wider text-space-base">
          {ptBrDict.about.baseLine}
        </p>
      </P5Panel>

      <P5Panel as="div" cut="b" data-about-card="career" class="bg-space-surface-1 p-6 sm:p-8 text-paper-white">
        <h4 class="mb-5 font-mono text-xs font-black uppercase tracking-widest text-bebop-red" data-i18n="about.careerTitle">
          {ptBrDict.about.careerTitle}
        </h4>
        <ol data-career class="flex flex-col gap-5 border-l-4 border-bebop-red pl-4">
          {career.map((entry, index) => (
            <li id={`career-${entry.id}`} data-career-entry class="flex flex-col gap-1">
              <span class="flex flex-wrap items-center gap-2 font-mono text-[11px] font-black uppercase">
                <span data-career-rank class="bg-paper-white px-2 py-0.5 text-space-base">
                  <span data-i18n="about.rankLabel">{ptBrDict.about.rankLabel}</span> {career.length - index}
                </span>
                {entry.id === currentId && (
                  <span data-career-current class="bg-bebop-red px-2 py-0.5 text-space-base" data-i18n="about.currentMarker">{ptBrDict.about.currentMarker}</span>
                )}
                <span data-career-period class="text-paper-white">{entry.period}</span>
              </span>
              <span class="font-display text-base sm:text-lg font-black uppercase text-paper-white">
                <span data-career-role>{entry.role}</span> <span class="text-bebop-red">@</span> <span data-career-org>{entry.org}</span>
              </span>
              <p data-career-summary class="font-body text-sm text-paper-white leading-relaxed">{entry.summary}</p>
              {entry.automations.length > 0 && (
                <div class="mt-1 flex flex-wrap items-center gap-2 font-mono text-[11px]">
                  <span class="font-black uppercase text-bebop-red" data-i18n="about.automationsLabel">{ptBrDict.about.automationsLabel}</span>
                  {entry.automations.map((automation) => (
                    <a
                      href={automation.repoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      data-automation-link={automation.id}
                      class="border border-paper-white px-2 py-0.5 font-bold uppercase text-paper-white transition-colors duration-150 hover:bg-paper-white hover:text-space-base focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-paper-white"
                    >
                      {automation.name} ↗
                    </a>
                  ))}
                </div>
              )}
            </li>
          ))}
        </ol>
      </P5Panel>

      <P5Panel as="div" cut="a" data-about-card="education" class="bg-space-surface-1 p-6 sm:p-8 text-paper-white">
        <h4 class="mb-5 font-mono text-xs font-black uppercase tracking-widest text-bebop-red" data-i18n="about.educationTitle">
          {ptBrDict.about.educationTitle}
        </h4>
        <ul data-education class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {education.map((entry) => (
            <li id={`education-${entry.id}`} data-education-entry class="border-2 border-paper-white/60 p-3">
              <span class="block font-display text-sm font-black uppercase text-paper-white">{entry.institution}</span>
              <span data-education-course class="block font-body text-sm text-paper-white">{entry.course}</span>
              <span class="mt-1 flex flex-wrap gap-2 font-mono text-[10px] uppercase">
                <span data-education-period class="text-paper-white">{entry.period}</span>
                <span data-education-status class="font-black text-bebop-red">{entry.status}</span>
              </span>
            </li>
          ))}
        </ul>
      </P5Panel>
    </div>
  </div>
</section>

<script>
  import { onPageReady } from "../utils/page-lifecycle";
  import { initDossier } from "./about/dossier";

  function boot() {
    const about = document.getElementById("about");
    return about ? (initDossier(about) ?? undefined) : undefined;
  }

  onPageReady(boot);
</script>
