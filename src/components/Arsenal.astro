---
import SkillsGrid from "./SkillsGrid.astro";
import { ptBrDict } from "../i18n/dictionaries";
---

<section
  id="arsenal"
  class="relative bg-space-base px-4 pb-16 sm:px-8 sm:pb-20 md:px-12 md:pb-24 text-paper-white select-none overflow-hidden"
  aria-label={ptBrDict.about.skillsTitle}
  data-i18n="about.skillsTitle"
  data-i18n-attr="aria-label"
>
  <div class="mx-auto max-w-[140rem]">
    <SkillsGrid />
  </div>
</section>

<script>
  import { onPageReady } from "../utils/page-lifecycle";
  import { gsap } from "../utils/motion";

  function setupArsenalReveal() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const matrix = document.querySelector<HTMLElement>("[data-skills-matrix]");
    if (!matrix || matrix.dataset.revealBound === "true") return;
    matrix.dataset.revealBound = "true";
    gsap.fromTo(
      matrix,
      { opacity: 0, y: 30 },
      {
        scrollTrigger: { trigger: matrix, start: "top 85%", once: true },
        opacity: 1,
        y: 0,
        duration: 0.8,
        ease: "power2.out",
        force3D: true,
      }
    );
  }

  onPageReady(setupArsenalReveal);
</script>
