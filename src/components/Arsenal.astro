---
import SkillsGrid from "./SkillsGrid.astro";
import { ptBrDict } from "../i18n/dictionaries";
import PanelClose from "./p5/PanelClose.astro";
---

<section
  id="arsenal"
  class="relative bg-space-base px-4 pb-16 sm:px-8 sm:pb-20 md:px-12 md:pb-24 text-paper-white select-none overflow-hidden"
  aria-label={ptBrDict.about.skillsTitle}
  data-i18n="about.skillsTitle"
  data-i18n-attr="aria-label"
>
  <div class="mx-auto max-w-[140rem]">
    <SkillsGrid />
  </div>

  <dialog
    data-skill-panel
    data-lenis-prevent
    aria-labelledby="skill-panel-title"
    class="fixed inset-y-0 right-0 left-auto m-0 h-dvh max-h-none w-full max-w-[36rem] overflow-hidden border-0 border-l-8 border-bebop-red bg-paper-white p-0 text-space-base select-text backdrop:bg-space-base/40"
  >
    <div data-skill-panel-body class="scroll-area scrollbar-paper relative h-full overflow-y-auto overscroll-contain p-5 sm:p-8">
      <PanelClose />
      <div class="border-b-4 border-space-base pb-4 pr-14 sm:pr-16">
        <div class="min-w-0 max-w-full">
          <p data-skill-panel-domain data-type="label" class="font-mono text-xs font-bold uppercase tracking-widest text-space-base"></p>
          <h3
            id="skill-panel-title"
            data-skill-panel-title
            data-type="label"
            class="mt-1 font-display text-2xl sm:text-3xl font-black uppercase leading-tight break-words text-space-base"
          >
          </h3>
          <p
            data-skill-panel-summary
            data-type="paragraph"
            class="mt-3 font-body text-sm sm:text-base leading-relaxed text-space-base"
          >
          </p>
        </div>
      </div>
      <ul data-skill-panel-evidence class="mt-6 flex list-none flex-col gap-6 p-0"></ul>
      <template data-skill-panel-item>
        <li class="border-l-4 border-space-base pl-4">
          <a
            data-skill-panel-link
            class="inline-flex items-center gap-2 border-2 border-space-base px-3 py-1.5 font-mono text-xs font-black uppercase text-space-base transition-colors duration-100 hover:bg-bebop-red focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-space-base"
          >
            <span data-skill-panel-link-label data-type="label"></span>
            <span aria-hidden="true">→</span>
          </a>
          <p data-skill-panel-description data-type="paragraph" class="mt-3 font-body text-sm sm:text-base leading-relaxed text-space-base"></p>
        </li>
      </template>
    </div>
  </dialog>
</section>

<script>
  import { onPageReady } from "../utils/page-lifecycle";
  import { gsap } from "../utils/motion";
  import { getLocale } from "../i18n/index";
  import { getEvidenceDescription, getLocalizedArsenal } from "../data/arsenal";
  import { createPanelTransition } from "../utils/panel-transition";
  import { bindPanelDismiss } from "../utils/panel-dismiss";
  import { typeText } from "../utils/text-type-bind";

  function setupArsenalReveal() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const matrix = document.querySelector<HTMLElement>("[data-skills-matrix]");
    if (!matrix || matrix.dataset.revealBound === "true") return;
    matrix.dataset.revealBound = "true";
    gsap.fromTo(
      matrix,
      { opacity: 0, y: 30 },
      {
        scrollTrigger: { trigger: matrix, start: "top 85%", once: true },
        opacity: 1,
        y: 0,
        duration: 0.8,
        ease: "power2.out",
        force3D: true,
      }
    );
  }

  function setupSkillPanel() {
    const panel = document.querySelector<HTMLDialogElement>("[data-skill-panel]");
    const grid = document.querySelector<HTMLElement>("[data-skills-grid]");
    const itemTemplate = panel?.querySelector<HTMLTemplateElement>("[data-skill-panel-item]");
    const list = panel?.querySelector<HTMLElement>("[data-skill-panel-evidence]");
    if (!panel || !grid || !itemTemplate || !list) return;

    const tiles = Array.from(grid.querySelectorAll<HTMLButtonElement>("[data-skill-tile]"));
    const rows = tiles.flatMap((tile) => tile.closest<HTMLElement>("[data-skill-badge]") ?? []);
    const transition = createPanelTransition(panel, grid, rows);
    let opener: HTMLButtonElement | null = null;

    const setText = (root: ParentNode, selector: string, value: string) => {
      const node = root.querySelector<HTMLElement>(selector);
      if (node) node.textContent = value;
    };

    const fill = (tile: HTMLButtonElement) => {
      const locale = getLocale();
      const domain = getLocalizedArsenal(locale).find((entry) => entry.id === tile.dataset.skillDomain);
      const skill = domain?.skills[Number(tile.dataset.skillIndex)];
      if (!domain || !skill) return false;
      setText(panel, "[data-skill-panel-domain]", domain.title);
      setText(panel, "[data-skill-panel-title]", skill.name);
      setText(panel, "[data-skill-panel-summary]", skill.description);
      list.replaceChildren(
        ...skill.evidence.map((evidence) => {
          const item = itemTemplate.content.cloneNode(true) as DocumentFragment;
          item.querySelector("[data-skill-panel-link]")?.setAttribute("href", `#${evidence.anchor}`);
          setText(item, "[data-skill-panel-link-label]", evidence.label);
          const description = getEvidenceDescription(evidence.ref, locale);
          if (description) setText(item, "[data-skill-panel-description]", description);
          else item.querySelector("[data-skill-panel-description]")?.remove();
          return item;
        })
      );
      return true;
    };

    const onTileClick = (event: Event) => {
      const tile = event.currentTarget as HTMLButtonElement;
      if (panel.open || !fill(tile)) return;
      opener = tile;
      transition.open();
      panel.querySelectorAll<HTMLElement>("[data-type]").forEach(typeText);
    };
    const onPanelClick = (event: Event) => {
      if ((event.target as HTMLElement).closest("[data-skill-panel-link]")) panel.close();
    };
    const onClose = () => opener?.focus();

    tiles.forEach((tile) => tile.addEventListener("click", onTileClick));
    panel.addEventListener("click", onPanelClick);
    const unbindDismiss = bindPanelDismiss(panel, () => transition.close());
    panel.addEventListener("close", onClose);

    return () => {
      tiles.forEach((tile) => tile.removeEventListener("click", onTileClick));
      panel.removeEventListener("click", onPanelClick);
      unbindDismiss();
      panel.removeEventListener("close", onClose);
      transition.destroy();
    };
  }

  onPageReady(setupArsenalReveal);
  onPageReady(setupSkillPanel);
</script>
