---
/**
 * CrtOverlay.astro
 * Retro-futuristic 90s CRT monitor scanlines, vignette curvature, and analog telemetry layer.
 * Strictly non-interactive (pointer-events: none) with accessible toggle and state persistence.
 */
---

<div id="crt-overlay" class="crt-overlay" aria-hidden="true">
  <div class="crt-overlay__scanlines"></div>
  <div class="crt-overlay__vignette"></div>
  <div class="crt-overlay__bezel"></div>
</div>

<style>
  .crt-overlay {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    pointer-events: none;
    overflow: hidden;
    opacity: 1;
    visibility: visible;
    transition: opacity var(--transition-smooth), visibility var(--transition-smooth);
    will-change: opacity;
  }

  /* Scanlines pattern */
  .crt-overlay__scanlines {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      rgba(18, 16, 16, 0) 50%,
      rgba(0, 0, 0, 0.28) 50%
    ),
    linear-gradient(
      90deg,
      rgba(255, 0, 0, 0.02),
      rgba(0, 255, 0, 0.01),
      rgba(0, 0, 255, 0.02)
    );
    background-size: 100% 4px, 6px 100%;
  }

  /* Vignette & phosphor curvature */
  .crt-overlay__vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      circle at 50% 50%,
      transparent 60%,
      rgba(7, 6, 18, 0.45) 85%,
      rgba(7, 6, 18, 0.85) 100%
    );
  }

  /* Subtitle screen curvature border */
  .crt-overlay__bezel {
    position: absolute;
    inset: 0;
    pointer-events: none;
    box-shadow: inset 0 0 80px rgba(0, 0, 0, 0.65);
  }

  /* Deactivation state */
  :global(html[data-crt="false"]) .crt-overlay {
    opacity: 0;
    visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .crt-overlay {
      transition: none;
    }
  }
</style>

<script is:inline>
  (function () {
    // Read persisted CRT state or default to enabled
    const saved = localStorage.getItem('crt_mode');
    const isEnabled = saved !== 'false';
    document.documentElement.setAttribute('data-crt', isEnabled ? 'true' : 'false');

    // Global helper for toggling CRT effect across pages/components
    window.toggleCrtMode = function () {
      const current = document.documentElement.getAttribute('data-crt') !== 'false';
      const next = !current;
      const nextStr = next ? 'true' : 'false';

      document.documentElement.setAttribute('data-crt', nextStr);
      try {
        localStorage.setItem('crt_mode', nextStr);
      } catch (e) {
        // LocalStorage might be disabled in private navigation
      }

      window.dispatchEvent(
        new CustomEvent('crt-mode-change', {
          detail: { enabled: next }
        })
      );
      return next;
    };
  })();
</script>
