---
import { getLocalizedHobbies, type HobbyId } from "../../data/hobbies";
import { ptBrDict } from "../../i18n/dictionaries";

const text = ptBrDict.contact;
const scenes = getLocalizedHobbies("pt-br");
const total = String(scenes.length).padStart(2, "0");
const channel = (index: number) => `CH ${String(index + 1).padStart(2, "0")}/${total}`;
const ticker = (labels: readonly string[]) => labels.join("  ✦  ");
const darkScene = (index: number) => index % 2 === 1;

const STARS = Array.from({ length: 22 }, (_, index) => ({
  x: (index * 83 + 37) % 390 + 5,
  y: (index * 47 + 19) % 230 + 10,
  r: index % 4 === 0 ? 3.2 : 1.8,
}));
const BARS = Array.from({ length: 14 }, (_, index) => ({ x: 160 + index * 16, h: 30 + ((index * 37) % 70) }));
const CELLS = Array.from({ length: 9 }, (_, index) => ({ x: 152 + (index % 3) * 34, y: 70 + Math.floor(index / 3) * 34 }));
const STRINGS = Array.from({ length: 6 }, (_, index) => 70 + index * 12);
const FALLS = Array.from({ length: 5 }, (_, index) => 238 + index * 9);

const details: Record<HobbyId, string> = {
  animes: "stars",
  musica: "vinyl",
  violao: "fire",
  skate: "deck",
  jogos: "phone",
  natureza: "falls",
};
---

<div
  data-brinu-fm
  data-fm-state="idle"
  class="brinu-fm relative hidden min-h-[30rem] flex-1 flex-col border-4 border-space-base bg-paper-white shadow-[8px_8px_0_var(--color-bebop-red)] lg:flex"
>
  <div data-fm-stage aria-hidden="true" class="fm-stage relative min-h-0 flex-1 overflow-hidden">
    <div class="fm-hud flex items-center justify-between gap-3 border-b-4 border-space-base bg-space-base px-4 py-2 font-mono font-bold uppercase text-paper-white">
      <span class="flex min-w-0 items-center gap-2">
        <span class="fm-onair inline-flex shrink-0 items-center gap-1.5 bg-bebop-red px-1.5 py-0.5 text-space-base"><span class="fm-dot"></span><span data-i18n="contact.fmOnAir">{text.fmOnAir}</span></span>
        <span class="truncate" data-i18n="contact.fmTitle">{text.fmTitle}</span>
      </span>
      <span data-fm-channel class="shrink-0 tracking-widest">{channel(0)}</span>
    </div>

    <div class="fm-screen relative">
      {scenes.map((scene, index) => (
        <article data-fm-scene={scene.id} data-fm-index={index} class:list={["fm-scene", darkScene(index) ? "fm-scene--dark" : "fm-scene--paper"]}>
          <div class="fm-halftone"></div>
          <svg class="fm-detail" data-fm-detail={details[scene.id]} viewBox="0 0 400 300" fill="none">
            {scene.id === "animes" && (
              <g>
                {STARS.map((star) => <circle data-fm-star cx={star.x} cy={star.y} r={star.r} fill="currentColor" />)}
                <circle cx="300" cy="120" r="46" fill="#fe0000" />
                <ellipse cx="300" cy="120" rx="86" ry="16" stroke="currentColor" stroke-width="5" transform="rotate(-18 300 120)" />
                <g data-fm-comet>
                  <path d="M150 40l70 34" stroke="currentColor" stroke-width="4" stroke-linecap="square" />
                  <rect x="214" y="68" width="14" height="14" fill="#fe0000" transform="rotate(45 221 75)" />
                </g>
              </g>
            )}
            {scene.id === "musica" && (
              <g>
                <g data-fm-vinyl>
                  <circle cx="300" cy="120" r="92" fill="#080808" />
                  <circle cx="300" cy="120" r="72" stroke="#fbfaf4" stroke-opacity=".25" stroke-width="2" />
                  <circle cx="300" cy="120" r="54" stroke="#fbfaf4" stroke-opacity=".25" stroke-width="2" />
                  <circle cx="300" cy="120" r="30" fill="#fe0000" />
                  <rect x="296" y="94" width="8" height="18" fill="#080808" />
                  <circle cx="300" cy="120" r="5" fill="#fbfaf4" />
                </g>
                {BARS.map((bar) => <rect data-fm-bar x={bar.x} y={280 - bar.h} width="10" height={bar.h} fill="currentColor" />)}
              </g>
            )}
            {scene.id === "violao" && (
              <g>
                <circle cx="330" cy="54" r="30" fill="currentColor" />
                <g data-fm-fire>
                  <path data-fm-flame d="M290 250c-30-34-8-60 8-88 6 28 34 40 22 88z" fill="#fe0000" />
                  <path data-fm-flame d="M300 250c-14-20-2-36 6-52 4 18 18 26 10 52z" fill="currentColor" />
                </g>
                <path d="M250 262l110-18M250 244l110 18" stroke="currentColor" stroke-width="10" />
                {STRINGS.map((y) => <line data-fm-string x1="150" y1={y} x2="400" y2={y} stroke="currentColor" stroke-width="2.5" />)}
              </g>
            )}
            {scene.id === "skate" && (
              <g>
                <line x1="120" y1="276" x2="400" y2="276" stroke="currentColor" stroke-width="6" />
                <g data-fm-deck>
                  <rect x="210" y="190" width="170" height="22" rx="11" fill="#fe0000" stroke="currentColor" stroke-width="5" />
                  <circle cx="240" cy="222" r="10" fill="currentColor" />
                  <circle cx="350" cy="222" r="10" fill="currentColor" />
                </g>
                <path data-fm-speed d="M150 170h50M130 190h60M160 210h40" stroke="currentColor" stroke-width="5" />
              </g>
            )}
            {scene.id === "jogos" && (
              <g>
                <rect x="136" y="40" width="134" height="230" rx="16" stroke="currentColor" stroke-width="6" />
                <rect x="186" y="252" width="34" height="6" fill="currentColor" />
                {CELLS.map((cell) => <rect data-fm-cell x={cell.x} y={cell.y} width="28" height="28" fill="currentColor" />)}
                <g data-fm-lvl>
                  <rect x="280" y="96" width="112" height="40" fill="#fe0000" stroke="currentColor" stroke-width="4" />
                  <text x="292" y="123" fill="#080808" font-size="20" font-weight="700" style="font-family: var(--font-mono)">LVL UP!</text>
                </g>
              </g>
            )}
            {scene.id === "natureza" && (
              <g>
                <circle data-fm-sun cx="318" cy="70" r="36" fill="#fe0000" />
                <path d="M120 300l90-120 70 70 50-60 70 110z" fill="currentColor" />
                {FALLS.map((x) => <line data-fm-fall x1={x} y1="150" x2={x} y2="300" stroke="#fbfaf4" stroke-width="4" stroke-dasharray="14 10" />)}
              </g>
            )}
          </svg>
          <img class="fm-sticker" data-fm-sticker src={scene.sticker} alt="" width="400" height="400" loading="lazy" decoding="async" />
          <div class="fm-copy">
            <h3 data-fm-name class="fm-name font-display font-black uppercase leading-[0.9]">{scene.name}</h3>
            <p data-fm-tag class="fm-tag font-mono font-bold uppercase">
              <span data-fm-position>{scene.position.code} // {scene.position.label}</span>
              <span class="fm-ovr">OVR {scene.rating}</span>
            </p>
          </div>
          <div class="fm-ticker font-mono font-bold uppercase">
            <span data-fm-ticker class="fm-ticker-track">{ticker(scene.stats.map((stat) => stat.label))}</span>
          </div>
        </article>
      ))}
      <div data-fm-wipe-ink class="fm-wipe fm-wipe--ink"></div>
      <div data-fm-wipe class="fm-wipe"></div>
    </div>

    <ul data-fm-sheet class="fm-sheet">
      {scenes.map((scene, index) => (
        <li class:list={["fm-card", darkScene(index) ? "fm-scene--dark" : "fm-scene--paper"]}>
          <img src={scene.sticker} alt="" width="400" height="400" loading="lazy" decoding="async" />
          <span data-fm-sheet-name={scene.id} class="font-display font-black uppercase">{scene.name}</span>
          <span class="font-mono font-bold">{channel(index)}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="fm-controls flex items-center gap-3 border-t-4 border-space-base bg-space-base px-3 py-2">
    <button
      type="button"
      data-fm-toggle
      aria-pressed="false"
      aria-label={text.fmToggleAria}
      data-i18n="contact.fmToggleAria"
      data-i18n-attr="aria-label"
      class="fm-toggle inline-flex h-9 min-w-24 shrink-0 cursor-pointer items-center justify-center gap-2 border-2 border-paper-white bg-space-base px-3 font-mono text-xs font-bold uppercase text-paper-white transition-colors duration-100 hover:bg-bebop-red hover:text-space-base focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-paper-white"
    >
      <span data-fm-pause-label data-i18n="contact.fmPause">{text.fmPause}</span>
      <span data-fm-play-label data-i18n="contact.fmPlay" hidden>{text.fmPlay}</span>
    </button>
    <span aria-hidden="true" class="fm-progress relative h-2 flex-1 overflow-hidden bg-paper-white/20">
      <span data-fm-progress class="absolute inset-0 origin-left scale-x-0 bg-bebop-red"></span>
    </span>
  </div>
</div>

<style>
  .brinu-fm {
    container-type: inline-size;
  }

  .fm-hud {
    font-size: clamp(10px, 1.3cqw, 14px);
  }

  .fm-dot {
    width: 0.6em;
    height: 0.6em;
    background: var(--color-space-base);
  }

  .fm-screen {
    position: absolute;
    inset: calc(clamp(10px, 1.3cqw, 14px) * 1.5 + 1.25rem) 0 0;
  }

  .fm-scene {
    position: absolute;
    inset: 0;
    overflow: hidden;
    visibility: hidden;
  }

  .fm-scene[data-fm-index="0"] {
    visibility: visible;
  }

  .fm-scene--paper {
    background: var(--color-paper-white);
    color: var(--color-space-base);
  }

  .fm-scene--dark {
    background: var(--color-space-base);
    color: var(--color-paper-white);
  }

  .fm-halftone {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(currentColor 1.2px, transparent 1.4px);
    background-size: 12px 12px;
    opacity: 0.08;
    clip-path: polygon(55% 0, 100% 0, 100% 100%, 30% 100%);
  }

  .fm-detail {
    position: absolute;
    right: 2%;
    top: 4%;
    width: 64%;
    height: 78%;
  }

  .fm-sticker {
    position: absolute;
    left: 30%;
    bottom: 16%;
    width: min(30cqw, 44%);
    aspect-ratio: 1;
    height: auto;
    filter: drop-shadow(6px 6px 0 var(--color-bebop-red));
  }

  .fm-copy {
    position: absolute;
    left: 5%;
    top: 7%;
    max-width: 52%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
  }

  .fm-name {
    font-size: clamp(2rem, 6.4cqw, 6rem);
    overflow-wrap: anywhere;
  }

  .fm-tag {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: clamp(11px, 1.25cqw, 15px);
  }

  .fm-tag > span {
    padding: 0.2rem 0.5rem;
  }

  .fm-scene--paper .fm-tag > span:first-child {
    background: var(--color-space-base);
    color: var(--color-paper-white);
  }

  .fm-scene--dark .fm-tag > span:first-child {
    background: var(--color-paper-white);
    color: var(--color-space-base);
  }

  .fm-ovr {
    background: var(--color-bebop-red);
    color: var(--color-space-base);
  }

  .fm-ticker {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
    white-space: nowrap;
    border-top: 4px solid var(--color-space-base);
    background: var(--color-bebop-red);
    color: var(--color-space-base);
    font-size: clamp(11px, 1.3cqw, 15px);
    padding: 0.45rem 0;
  }

  .fm-ticker-track {
    display: inline-block;
    padding-left: 1.25rem;
  }

  .fm-wipe {
    position: absolute;
    inset: -2px;
    background: var(--color-bebop-red);
    clip-path: polygon(0 0, 0 0, -30% 100%, -30% 100%);
    pointer-events: none;
  }

  .fm-wipe--ink {
    background: var(--color-space-base);
  }

  .fm-sheet {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .fm-screen {
      display: none;
    }

    .fm-controls,
    [data-fm-channel] {
      visibility: hidden;
    }

    .fm-sheet {
      position: absolute;
      inset: calc(clamp(10px, 1.3cqw, 14px) * 1.5 + 1.25rem) 0 0;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-rows: 1fr;
      gap: 4px;
      margin: 0;
      padding: 4px;
      list-style: none;
      background: var(--color-space-base);
    }

    .fm-card {
      display: flex;
      min-width: 0;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.75rem;
      text-align: center;
    }

    .fm-card img {
      width: min(60%, 9rem);
      height: auto;
    }

    .fm-card span:first-of-type {
      font-size: clamp(0.9rem, 1.8cqw, 1.5rem);
      line-height: 1;
      overflow-wrap: anywhere;
    }

    .fm-card span:last-of-type {
      font-size: 11px;
    }
  }
</style>

<script>
  import { onPageReady } from "../../utils/page-lifecycle";

  onPageReady(() => {
    const root = document.querySelector<HTMLElement>("[data-brinu-fm]");
    if (!root || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    let teardown: (() => void) | null = null;
    let disposed = false;
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        void import("./brinu-fm-reel").then(({ startBrinuFm }) => {
          if (!disposed) teardown = startBrinuFm(root);
        });
      },
      { rootMargin: "600px 0px" }
    );
    observer.observe(root);

    return () => {
      disposed = true;
      observer.disconnect();
      teardown?.();
    };
  });
</script>
