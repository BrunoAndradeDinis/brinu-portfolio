---
import ArcanaDeck from "./ArcanaDeck.astro";
import { ptBrDict } from "../i18n/dictionaries";
import P5Title from "./p5/P5Title.astro";
import P5Badge from "./p5/P5Badge.astro";
---

<section
  id="lab"
  class="relative border-t-4 border-paper-white bg-space-base px-4 py-16 sm:px-8 sm:py-20 md:px-12 md:py-24 text-paper-white select-none overflow-hidden"
  aria-label={ptBrDict.lab.sectionAria}
  data-i18n="lab.sectionAria"
  data-i18n-attr="aria-label"
>
  <div class="mx-auto mb-12 sm:mb-16 max-w-[140rem]">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 pb-4 border-b-4 border-bebop-red">
      <div>
        <span
          class="mb-2 block font-mono text-xs sm:text-sm font-bold tracking-widest text-bebop-red uppercase"
          data-i18n="lab.actTag"
        >
          {ptBrDict.lab.actTag}
        </span>
        <P5Title
          text={ptBrDict.lab.title}
          data-lab-title
          data-i18n="lab.title"
          class="font-display text-[clamp(2.2rem,6vw,5rem)] font-black tracking-tight text-paper-white leading-none uppercase"
        />
      </div>

      <div class="flex flex-col sm:items-end text-left sm:text-right font-mono text-xs text-muted-gray">
        <P5Badge
          class="font-bold text-space-base bg-bebop-red px-2.5 py-0.5 border border-paper-white"
          data-i18n="lab.statusBadge"
        >
          {ptBrDict.lab.statusBadge}
        </P5Badge>
        <span class="mt-1.5 text-[10px] sm:text-xs text-muted-gray tracking-wider" data-i18n="lab.domainLine">
          {ptBrDict.lab.domainLine}
        </span>
      </div>
    </div>

  </div>

  <ArcanaDeck />
</section>
