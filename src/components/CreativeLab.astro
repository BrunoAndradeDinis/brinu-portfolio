---
import CrtTuner from "./lab/CrtTuner";
import SonarRadar from "./lab/SonarRadar";
import CyberDeck from "./lab/CyberDeck";
import { ptBrDict } from "../i18n/dictionaries";
---

<section
  id="lab"
  class="relative border-t-4 border-paper-white bg-space-base px-4 py-16 sm:px-8 sm:py-20 md:px-12 md:py-24 text-paper-white select-none overflow-hidden"
  aria-label={ptBrDict.lab.sectionAria}
  data-i18n="lab.sectionAria"
  data-i18n-attr="aria-label"
>
  <div class="mx-auto mb-12 sm:mb-16 max-w-[140rem]">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 pb-4 border-b-4 border-bebop-red">
      <div>
        <span
          class="mb-2 block font-mono text-xs sm:text-sm font-bold tracking-widest text-bebop-red uppercase"
          data-i18n="lab.actTag"
        >
          {ptBrDict.lab.actTag}
        </span>
        <h2
          data-lab-title
          data-i18n="lab.title"
          class="font-display text-[clamp(2.2rem,6vw,5rem)] font-black tracking-tight text-paper-white leading-none uppercase"
        >
          {ptBrDict.lab.title}
        </h2>
      </div>

      <div class="flex flex-col sm:items-end text-left sm:text-right font-mono text-xs text-muted-gray">
        <span
          class="font-bold text-paper-white bg-bebop-red px-2.5 py-0.5 border border-paper-white -skew-x-6"
          data-i18n="lab.statusBadge"
        >
          {ptBrDict.lab.statusBadge}
        </span>
        <span class="mt-1.5 text-[10px] sm:text-xs text-muted-gray tracking-wider" data-i18n="lab.domainLine">
          {ptBrDict.lab.domainLine}
        </span>
      </div>
    </div>

    <div
      data-lab-nav
      class="mt-6 flex flex-wrap items-center gap-2.5 sm:gap-3 text-xs font-mono"
      aria-label={ptBrDict.a11y.labNavAria}
      data-i18n="a11y.labNavAria"
      data-i18n-attr="aria-label"
    >
      <span class="text-bebop-red uppercase text-[11px] font-bold mr-1" data-i18n="lab.indexLabel">
        {ptBrDict.lab.indexLabel}
      </span>

      <a
        href="#lab-crt-tuner"
        data-nav-tuner
        data-i18n="lab.navTuner"
        class="px-3 py-1.5 border-2 border-paper-white bg-space-surface-1 text-paper-white font-bold hover:bg-bebop-red hover:text-paper-white transition-all shadow-[3px_3px_0_var(--color-bebop-red)]"
      >
        {ptBrDict.lab.navTuner}
      </a>

      <a
        href="#lab-sonar-radar"
        data-nav-sonar
        data-i18n="lab.navSonar"
        class="px-3 py-1.5 border-2 border-paper-white bg-space-surface-1 text-paper-white font-bold hover:bg-bebop-red hover:text-paper-white transition-all shadow-[3px_3px_0_var(--color-bebop-red)]"
      >
        {ptBrDict.lab.navSonar}
      </a>

      <a
        href="#lab-cyber-deck"
        data-nav-deck
        data-i18n="lab.navDeck"
        class="px-3 py-1.5 border-2 border-paper-white bg-space-surface-1 text-paper-white font-bold hover:bg-bebop-red hover:text-paper-white transition-all shadow-[3px_3px_0_var(--color-bebop-red)]"
      >
        {ptBrDict.lab.navDeck}
      </a>
    </div>
  </div>

  <div class="mx-auto max-w-[140rem] space-y-16">
    <div id="lab-crt-tuner" class="scroll-mt-28">
      <CrtTuner client:visible />
    </div>

    <div id="lab-sonar-radar" class="scroll-mt-28">
      <SonarRadar client:visible />
    </div>

    <div id="lab-cyber-deck" class="scroll-mt-28">
      <CyberDeck client:visible />
    </div>
  </div>
</section>
