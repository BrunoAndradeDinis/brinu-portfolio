---
import BountyDispatch from "./BountyDispatch";
import { PROFILE } from "../data/profile";
import { ptBrDict } from "../i18n/dictionaries";
import P5Title from "./p5/P5Title.astro";
import P5Badge from "./p5/P5Badge.astro";
---

<section
  id="contact"
  class="relative bg-paper-white px-4 pb-16 sm:px-8 sm:pb-24 md:px-12 md:pb-32 text-space-base select-none overflow-hidden"
  aria-label={ptBrDict.contact.sectionAria}
  data-i18n="contact.sectionAria"
  data-i18n-attr="aria-label"
>
  <div
    data-p5-section-cut="lab-to-contact"
    aria-hidden="true"
    class="p5-section-cut p5-section-cut--left -mx-4 sm:-mx-8 md:-mx-12 mb-12 sm:mb-16 bg-space-base"
  ></div>

  <div class="mx-auto max-w-[140rem]">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 pb-6 border-b-4 border-space-base">
      <div>
        <span
          class="mb-2 block font-mono text-xs sm:text-sm font-bold tracking-widest text-space-base uppercase"
          data-i18n="contact.actTag"
        >
          {ptBrDict.contact.actTag}
        </span>
        <P5Title
          text={ptBrDict.contact.title}
          data-contact-title
          data-i18n="contact.title"
          class="font-display text-[clamp(2.4rem,7vw,6.5rem)] font-black tracking-tight text-space-base leading-none uppercase"
        />
      </div>

      <div class="flex items-center gap-2.5 font-mono text-xs">
        <span class="w-3 h-3 bg-bebop-red animate-ping" />
        <P5Badge
          class="font-bold text-space-base bg-bebop-red px-2.5 py-0.5 border-2 border-space-base tracking-wider uppercase"
          data-i18n="contact.availableBadge"
        >
          {ptBrDict.contact.availableBadge}
        </P5Badge>
      </div>
    </div>

    <div class="mt-12 sm:mt-16 grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-7 space-y-8">
        <div class="space-y-4">
          <p
            class="font-sans text-base sm:text-lg md:text-xl text-space-base leading-relaxed font-semibold"
            data-i18n="contact.leadText"
          >
            {ptBrDict.contact.leadText}
          </p>
          <p
            class="font-mono text-xs sm:text-sm text-space-base leading-relaxed font-medium"
            data-i18n="contact.subText"
          >
            {ptBrDict.contact.subText}
          </p>
        </div>

        <div class="pt-2">
          <a
            href={`mailto:${PROFILE.email}?subject=${encodeURIComponent("[Bounty Contract] Proposta de Projeto // Bruno Dinis")}`}
            data-primary-contact-btn
            class="group inline-flex flex-col sm:flex-row sm:items-center justify-between gap-4 w-full p-6 sm:p-8 border-4 border-space-base bg-bebop-red text-space-base shadow-[8px_8px_0_var(--color-space-base)] hover:bg-space-base hover:text-paper-white transition-all duration-150 active:translate-x-1 active:translate-y-1"
          >
            <div class="space-y-1">
              <span
                class="font-mono text-xs font-bold tracking-widest text-space-base group-hover:text-bebop-red uppercase block"
                data-i18n="contact.directTag"
              >
                {ptBrDict.contact.directTag}
              </span>
              <span
                class="font-display text-2xl sm:text-3xl font-black uppercase tracking-tight block text-space-base group-hover:text-paper-white"
                data-i18n="contact.directCta"
              >
                {ptBrDict.contact.directCta}
              </span>
              <span class="font-mono text-xs font-bold text-space-base group-hover:text-paper-white block">
                {PROFILE.email}
              </span>
            </div>

            <div class="flex items-center gap-2 self-end sm:self-center font-mono text-sm font-bold bg-space-base text-paper-white px-4 py-2 border-2 border-paper-white transition-colors">
              <span data-i18n="contact.dispatchPill">{ptBrDict.contact.dispatchPill}</span>
              <svg class="size-4 shrink-0 text-bebop-red" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4 font-mono text-xs">
          <a
            href={PROFILE.github.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group p-4 border-2 border-space-base bg-space-base text-paper-white hover:bg-bebop-red hover:text-space-base transition-all shadow-[4px_4px_0_var(--color-bebop-red)] block"
          >
            <span class="text-[10px] text-muted-gray group-hover:text-space-base uppercase block mb-1" data-i18n="contact.codeBaseLabel">
              {ptBrDict.contact.codeBaseLabel}
            </span>
            <span class="font-bold block break-words">GitHub {PROFILE.github.handle}</span>
          </a>

          <a
            href={PROFILE.linkedin.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group p-4 border-2 border-space-base bg-space-base text-paper-white hover:bg-bebop-red hover:text-space-base transition-all shadow-[4px_4px_0_var(--color-bebop-red)] block"
          >
            <span class="text-[10px] text-muted-gray group-hover:text-space-base uppercase block mb-1" data-i18n="contact.careerLogLabel">
              {ptBrDict.contact.careerLogLabel}
            </span>
            <span class="font-bold block break-words">LinkedIn {PROFILE.linkedin.handle}</span>
          </a>

          <div class="p-4 border-2 border-space-base bg-space-base text-paper-white shadow-[4px_4px_0_var(--color-bebop-red)]">
            <span class="text-[10px] text-muted-gray uppercase block mb-1" data-i18n="contact.stationBaseLabel">
              {ptBrDict.contact.stationBaseLabel}
            </span>
            <span class="font-bold text-bebop-red block" data-i18n="contact.stationBaseValue">
              {ptBrDict.contact.stationBaseValue}
            </span>
          </div>
        </div>
      </div>

      <div id="bounty-dispatch-container" class="lg:col-span-5">
        <BountyDispatch client:visible />
      </div>
    </div>
  </div>
</section>
