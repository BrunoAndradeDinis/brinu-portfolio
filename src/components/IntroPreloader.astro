---
import { ptBrDict } from "../i18n/dictionaries";
---

<div
  id="intro-preloader"
  class="intro-preloader"
  aria-label="Abertura Cinemática"
>
  <div class="intro-preloader__backdrop"></div>

  <!-- SVG com Máscara Tipográfica Monumental "BRINU" -->
  <div class="intro-preloader__canvas-wrapper">
    <svg
      class="intro-preloader__svg"
      viewBox="0 0 2000 450"
      preserveAspectRatio="xMidYMid meet"
      aria-hidden="true"
    >
      <defs>
        <!-- Máscara de Recorte com o Nome "BRINU" -->
        <clipPath id="brinu-letters-clip">
          <text x="50%" y="74%" text-anchor="middle" class="svg-clip-text">
            BRINU
          </text>
        </clipPath>
      </defs>

      <!-- Grupo com as Imagens Deslizando Horizontalmente Por Dentro das Letras -->
      <g clip-path="url(#brinu-letters-clip)">
        <!-- Fundo escuro interno -->
        <rect
          x="0"
          y="0"
          width="2000"
          height="450"
          fill="var(--color-space-base)"></rect>

        <!-- Trilha de Imagens em Movimento Horizontal Contínuo -->
        <g class="intro-filmstrip-track">
          <image
            href="/assets/brinu-avatar.jpg"
            x="-250"
            y="-50"
            width="550"
            height="520"
            preserveAspectRatio="xMidYMid slice"
          />
          <image
            href="/assets/brinu-avatar.jpg"
            x="300"
            y="-50"
            width="550"
            height="520"
            preserveAspectRatio="xMidYMid slice"
          />
          <image
            href="/assets/brinu-avatar.jpg"
            x="850"
            y="-50"
            width="550"
            height="520"
            preserveAspectRatio="xMidYMid slice"
          />
          <image
            href="/assets/brinu-avatar.jpg"
            x="1400"
            y="-50"
            width="550"
            height="520"
            preserveAspectRatio="xMidYMid slice"
          />
          <image
            href="/assets/brinu-avatar.jpg"
            x="1950"
            y="-50"
            width="550"
            height="520"
            preserveAspectRatio="xMidYMid slice"
          />
        </g>

        <!-- Filtro e Textura Noir Estilizada Sobre as Imagens -->
        <rect
          x="0"
          y="0"
          width="2000"
          height="450"
          fill="rgba(var(--color-bebop-red-rgb), 0.15)"
          style="mix-blend-mode: color-burn;"></rect>
      </g>

      <!-- Contorno Externo das Letras Estilo Quadrinhos -->
      <text x="50%" y="74%" text-anchor="middle" class="svg-stroke-text">
        BRINU
      </text>
    </svg>

    <div class="intro-preloader__caption">
      <span class="caption-tag font-mono" data-i18n="preloader.sceneTag">{ptBrDict.preloader.sceneTag}</span>
      <span class="caption-prompt font-mono" data-i18n="preloader.skipPrompt"
        >{ptBrDict.preloader.skipPrompt}</span
      >
    </div>
  </div>
</div>

<style>
  .intro-preloader {
    position: fixed;
    inset: 0;
    z-index: var(--z-curtain, 100000);
    background-color: var(--color-space-base);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    cursor: pointer;
    transition: transform var(--transition-curtain);
    will-change: transform;
  }

  /* Estado de saída: cortina cinemática sobe revelando a Home */
  .intro-preloader.is-exiting {
    transform: translateY(-100%);
    pointer-events: none;
  }

  .intro-preloader__backdrop {
    position: absolute;
    inset: 0;
    background-color: var(--color-space-base);
    pointer-events: none;
  }

  .intro-preloader__canvas-wrapper {
    position: relative;
    width: 90vw;
    max-width: 1600px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .intro-preloader__svg {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 15px 40px rgba(var(--color-space-base-rgb), 0.9));
  }

  .svg-clip-text {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 260px;
    letter-spacing: -6px;
  }

  .svg-stroke-text {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 260px;
    letter-spacing: -6px;
    fill: none;
    stroke: rgba(var(--color-paper-white-rgb), 0.15);
    stroke-width: var(--border-comic-medium);
    pointer-events: none;
  }

  /* Animação horizontal das imagens deslizando dentro das letras */
  @keyframes filmstripPan {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-550px);
    }
  }

  .intro-filmstrip-track {
    animation: filmstripPan 3.5s linear infinite;
    will-change: transform;
  }

  .intro-preloader__caption {
    margin-top: var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-4);
    font-size: 1.2rem;
    letter-spacing: 0.15em;
    color: var(--color-muted-gray);
    text-transform: uppercase;
  }

  .caption-tag {
    color: var(--color-bebop-red);
    font-weight: 700;
  }

  .caption-prompt {
    opacity: 0.7;
    font-size: 1rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .intro-filmstrip-track {
      animation: none;
    }
    .intro-preloader {
      transition: opacity var(--transition-fast);
    }
    .intro-preloader.is-exiting {
      transform: none;
      opacity: 0;
    }
  }
</style>

<script>
  import { pauseScroll, resumeScroll } from "../utils/motion";

  const preloader = document.getElementById("intro-preloader");
  if (preloader) {
    const preloaderEl = preloader;
    let dismissed = false;

    // Trava o scroll no início da cortina
    pauseScroll();

    function dismissPreloader() {
      if (dismissed) return;
      dismissed = true;

      window.removeEventListener("keydown", onKeyDown);

      preloaderEl.classList.add("is-exiting");
      document.documentElement.classList.add("intro-completed");

      // Destrava o scroll ao concluir a cortina
      resumeScroll();

      // Dispara evento customizado na janela
      window.dispatchEvent(new CustomEvent("intro-complete"));

      // Remove do DOM após conclusão da animação
      setTimeout(() => {
        preloaderEl.remove();
      }, 900);
    }

    // Abertura com duração automática de ~3.8 segundos (pausada se ?freeze para inspeção e testes)
    const isFrozen = window.location.search.includes("freeze");
    const autoTimer = isFrozen ? null : setTimeout(dismissPreloader, 3800);

    function onKeyDown(e: KeyboardEvent) {
      if (e.key === "Escape" || e.key === " " || e.key === "Enter") {
        if (autoTimer) clearTimeout(autoTimer);
        dismissPreloader();
      }
    }

    // Permite ao usuário clicar ou pressionar qualquer tecla para avançar imediatamente
    preloader.addEventListener("click", () => {
      if (autoTimer) clearTimeout(autoTimer);
      dismissPreloader();
    });

    window.addEventListener("keydown", onKeyDown);
  }
</script>

