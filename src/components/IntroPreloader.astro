---
import { ptBrDict } from "../i18n/dictionaries";

const LETTERS = ["B", "R", "I", "N", "U"] as const;
---

<div
  id="intro-preloader"
  class="intro-preloader"
  data-intro-state="loading"
  data-intro-mode="full"
  aria-label={ptBrDict.a11y.preloaderAria}
  data-i18n="a11y.preloaderAria"
  data-i18n-attr="aria-label"
>
  <div class="intro-preloader__backdrop"></div>

  <div class="intro-preloader__stage">
    <div class="intro-letters" aria-hidden="true">
      {
        LETTERS.map((letter, index) => (
          <span class="intro-letter" data-intro-letter={letter} style={`--i:${index}`}>
            {letter}
          </span>
        ))
      }
    </div>

    <div class="intro-preloader__caption">
      <span class="caption-tag font-mono" data-i18n="preloader.sceneTag">{ptBrDict.preloader.sceneTag}</span>
      <span class="caption-counter font-display" aria-hidden="true">
        <span data-intro-counter>0</span><span class="caption-counter__unit">%</span>
      </span>
      <span class="caption-prompt font-mono" data-i18n="preloader.skipPrompt"
        >{ptBrDict.preloader.skipPrompt}</span
      >
    </div>
  </div>
</div>

<noscript>
  <style>
    #intro-preloader {
      display: none !important;
    }
  </style>
</noscript>

<style>
  .intro-preloader {
    position: fixed;
    inset: 0;
    z-index: var(--z-curtain, 100000);
    background-color: var(--color-space-base);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    cursor: pointer;
  }

  .intro-preloader__backdrop {
    position: absolute;
    inset: 0;
    background-color: var(--color-space-base);
    pointer-events: none;
  }

  .intro-preloader__stage {
    position: relative;
    width: 90vw;
    max-width: 1600px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .intro-letters {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.02em;
    font-size: clamp(3.5rem, 16vw, 17rem);
    line-height: 0.85;
    width: 100%;
  }

  .intro-letter {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 900;
    letter-spacing: -0.025em;
    color: transparent;
    background-image: url("/assets/brinu-avatar.jpg");
    background-size: 280% auto;
    background-position: 0% 30%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-stroke: 2px rgba(var(--color-paper-white-rgb), 0.35);
    animation: introFilm 3.5s linear infinite;
    animation-delay: calc(var(--i) * -0.7s);
    will-change: background-position;
  }

  @keyframes introFilm {
    to {
      background-position: 100% 30%;
    }
  }

  .intro-preloader[data-intro-mode="short"] .intro-letter {
    background-image: none;
    color: var(--color-paper-white);
    -webkit-text-stroke: 0;
    animation: none;
  }

  .intro-preloader__caption {
    margin-top: var(--space-4);
    display: flex;
    align-items: baseline;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-size: 1.2rem;
    letter-spacing: 0.15em;
    color: var(--color-muted-gray);
    text-transform: uppercase;
  }

  .caption-tag {
    color: var(--color-bebop-red);
    font-weight: 700;
  }

  .caption-counter {
    color: var(--color-paper-white);
    font-weight: 900;
    font-size: 2.4rem;
    letter-spacing: 0;
    min-width: 4.2ch;
    text-align: right;
    transform: skewX(-6deg);
  }

  .caption-counter__unit {
    color: var(--color-bebop-red);
    font-size: 1.4rem;
  }

  .caption-prompt {
    opacity: 0.7;
    font-size: 1rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .intro-letter {
      animation: none;
    }
  }
</style>

<script>
  import { pauseScroll, resumeScroll } from "../utils/motion";
  import { runTakeover, type TakeoverHandle } from "../utils/intro-takeover";
  import {
    INTRO_SEEN_KEY,
    computeExitDelay,
    counterValueAt,
    resolveIntroMode,
    type IntroMode,
  } from "../utils/intro-timing";

  const AVATAR_SRC = "/assets/brinu-avatar.jpg";

  function readSeenFlag(): boolean {
    try {
      return window.sessionStorage.getItem(INTRO_SEEN_KEY) === "1";
    } catch {
      return false;
    }
  }

  function writeSeenFlag(): void {
    try {
      window.sessionStorage.setItem(INTRO_SEEN_KEY, "1");
    } catch {
      /* storage unavailable: the long intro simply plays again */
    }
  }

  function initPreloader(): void {
    const preloader = document.getElementById("intro-preloader");
    if (!preloader || preloader.dataset.introBound === "true") return;
    preloader.dataset.introBound = "true";

    const counterEl = preloader.querySelector<HTMLElement>("[data-intro-counter]");
    const mode: IntroMode = resolveIntroMode({
      reducedMotion: window.matchMedia("(prefers-reduced-motion: reduce)").matches,
      seenThisSession: readSeenFlag(),
    });
    preloader.dataset.introMode = mode;
    performance.mark("intro:start");
    pauseScroll();

    const startedAt = performance.now();
    let fontsReady = false;
    let avatarReady = false;
    let exiting = false;
    let exitTimer: ReturnType<typeof setTimeout> | undefined;
    let counterFrame = 0;

    const setCounter = (value: number) => {
      if (counterEl) counterEl.textContent = String(value);
    };

    const tickCounter = () => {
      setCounter(counterValueAt(performance.now() - startedAt));
      counterFrame = requestAnimationFrame(tickCounter);
    };
    counterFrame = requestAnimationFrame(tickCounter);

    const finish = () => {
      window.removeEventListener("keydown", onKeyDown);
      document.documentElement.classList.add("intro-completed");
      preloader.remove();
      resumeScroll();
      performance.mark("intro:complete");
      window.dispatchEvent(new CustomEvent("intro-complete"));
    };

    let takeover: TakeoverHandle | null = null;

    const beginExit = (skip = false) => {
      if (exiting) {
        takeover?.skip();
        return;
      }
      exiting = true;
      clearTimeout(exitTimer);
      cancelAnimationFrame(counterFrame);
      setCounter(100);
      writeSeenFlag();
      performance.mark("intro:exit-start");
      preloader.dataset.introState = "exiting";
      preloader.classList.add("is-exiting");
      takeover = runTakeover({ preloader, mode, skip, onComplete: finish });
    };

    const schedule = () => {
      if (exiting) return;
      clearTimeout(exitTimer);
      const delay = computeExitDelay({
        elapsedMs: performance.now() - startedAt,
        fontsReady,
        avatarReady,
      });
      exitTimer = setTimeout(() => beginExit(false), delay);
    };

    function onKeyDown(event: KeyboardEvent) {
      if (event.key === "Escape" || event.key === " " || event.key === "Enter") {
        beginExit(true);
      }
    }

    const isFrozen = window.location.search.includes("freeze");

    document.fonts.ready.then(() => {
      fontsReady = true;
      if (!isFrozen) schedule();
    });

    const avatarProbe = new Image();
    avatarProbe.onload = () => {
      avatarReady = true;
      if (!isFrozen) schedule();
    };
    avatarProbe.src = AVATAR_SRC;

    if (!isFrozen) schedule();

    preloader.addEventListener("click", () => beginExit(true));
    window.addEventListener("keydown", onKeyDown);

    window.addEventListener("pageshow", (event) => {
      if (event.persisted && document.getElementById("intro-preloader")) {
        beginExit(true);
      }
    });
  }

  initPreloader();
</script>
