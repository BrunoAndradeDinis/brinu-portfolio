---
/**
 * IntroPreloader.astro
 * Transição de abertura inspirada no mew.xyz e na abertura clássica (Tank!) de Cowboy Bebop.
 * Exibe o nome colossal "BRINU" como máscara com imagens passando por dentro dos glifos,
 * finalizando com uma transição de saída deslizante para cima (curtain slide-up).
 */
---

<div id="intro-preloader" class="intro-preloader" aria-label="Abertura Cinemática">
  <div class="intro-preloader__backdrop"></div>

  <!-- SVG com Máscara Tipográfica Monumental "BRINU" -->
  <div class="intro-preloader__canvas-wrapper">
    <svg
      class="intro-preloader__svg"
      viewBox="0 0 1400 420"
      preserveAspectRatio="xMidYMid meet"
      aria-hidden="true"
    >
      <defs>
        <!-- Máscara de Recorte com o Nome "BRINU" -->
        <clipPath id="brinu-letters-clip">
          <text
            x="50%"
            y="72%"
            text-anchor="middle"
            class="svg-clip-text"
          >
            BRINU
          </text>
        </clipPath>
      </defs>

      <!-- Grupo com as Imagens Deslizando Horizontalmente Por Dentro das Letras -->
      <g clip-path="url(#brinu-letters-clip)">
        <!-- Fundo escuro interno -->
        <rect x="0" y="0" width="1400" height="420" fill="#0A0A14" />

        <!-- Trilha de Imagens em Movimento Horizontal Contínuo -->
        <g class="intro-filmstrip-track">
          <image
            href="/assets/brinu-avatar.jpg"
            x="-200"
            y="-50"
            width="550"
            height="500"
            preserveAspectRatio="xMidYMid slice"
          />
          <image
            href="/assets/brinu-avatar.jpg"
            x="350"
            y="-50"
            width="550"
            height="500"
            preserveAspectRatio="xMidYMid slice"
          />
          <image
            href="/assets/brinu-avatar.jpg"
            x="900"
            y="-50"
            width="550"
            height="500"
            preserveAspectRatio="xMidYMid slice"
          />
          <image
            href="/assets/brinu-avatar.jpg"
            x="1450"
            y="-50"
            width="550"
            height="500"
            preserveAspectRatio="xMidYMid slice"
          />
        </g>

        <!-- Filtro e Textura Noir Estilizada Sobre as Imagens -->
        <rect
          x="0"
          y="0"
          width="1400"
          height="420"
          fill="rgba(254, 0, 0, 0.15)"
          style="mix-blend-mode: color-burn;"
        />
      </g>

      <!-- Contorno Externo das Letras Estilo Quadrinhos -->
      <text
        x="50%"
        y="72%"
        text-anchor="middle"
        class="svg-stroke-text"
      >
        BRINU
      </text>
    </svg>

    <div class="intro-preloader__caption">
      <span class="caption-tag">[ 1996 // SCENE 01 ]</span>
      <span class="caption-prompt">CLIQUE OU PRESSIONE QUALQUER TECLA PARA PULAR</span>
    </div>
  </div>
</div>

<style>
  .intro-preloader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background-color: var(--color-space-base);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.85s cubic-bezier(0.85, 0, 0.15, 1);
    will-change: transform;
  }

  /* Estado de saída: cortina cinemática sobe revelando a Home */
  .intro-preloader.is-exiting {
    transform: translateY(-100%);
    pointer-events: none;
  }

  .intro-preloader__backdrop {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, #141324 0%, #070612 80%);
    pointer-events: none;
  }

  .intro-preloader__canvas-wrapper {
    position: relative;
    width: 90vw;
    max-width: 1400px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .intro-preloader__svg {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 15px 40px rgba(0, 0, 0, 0.9));
  }

  .svg-clip-text {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 320px;
    letter-spacing: -12px;
  }

  .svg-stroke-text {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 320px;
    letter-spacing: -12px;
    fill: none;
    stroke: rgba(251, 250, 244, 0.12);
    stroke-width: 4px;
    pointer-events: none;
  }

  /* Animação horizontal das imagens deslizando dentro das letras */
  @keyframes filmstripPan {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-550px);
    }
  }

  .intro-filmstrip-track {
    animation: filmstripPan 3.5s linear infinite;
    will-change: transform;
  }

  .intro-preloader__caption {
    margin-top: 2rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    font-family: var(--font-mono);
    font-size: 1.2rem;
    letter-spacing: 0.15em;
    color: var(--color-muted-gray);
    text-transform: uppercase;
  }

  .caption-tag {
    color: var(--color-bebop-red);
    font-weight: 700;
  }

  .caption-prompt {
    opacity: 0.7;
    font-size: 1rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .intro-filmstrip-track {
      animation: none;
    }
    .intro-preloader {
      transition: opacity 0.3s ease;
    }
    .intro-preloader.is-exiting {
      transform: none;
      opacity: 0;
    }
  }
</style>

<script is:inline>
  (function () {
    const preloader = document.getElementById('intro-preloader');
    if (!preloader) return;

    let dismissed = false;

    function dismissPreloader() {
      if (dismissed) return;
      dismissed = true;

      preloader.classList.add('is-exiting');
      document.documentElement.classList.add('intro-completed');

      // Dispara evento na janela
      window.dispatchEvent(new CustomEvent('intro-complete'));

      // Remove do DOM após conclusão da animação
      setTimeout(() => {
        if (preloader.parentNode) {
          preloader.parentNode.removeChild(preloader);
        }
      }, 900);
    }

    // Abertura com duração automática de ~2.4 segundos
    const autoTimer = setTimeout(dismissPreloader, 2400);

    // Permite ao usuário clicar ou pressionar qualquer tecla para avançar imediatamente
    preloader.addEventListener('click', () => {
      clearTimeout(autoTimer);
      dismissPreloader();
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' || e.key === ' ' || e.key === 'Enter') {
        clearTimeout(autoTimer);
        dismissPreloader();
      }
    });
  })();
</script>
