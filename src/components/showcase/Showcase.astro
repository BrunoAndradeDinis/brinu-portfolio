---
import { getLocalizedCases, MAIN_CASES } from "../../data/cases";
import { SHOWCASE_MEDIA } from "../../data/showcase";
import { ptBrDict } from "../../i18n/dictionaries";
import { casePath } from "../../utils/case-pages";
import { showcaseNeighbors, showcasePosition, showcaseTiles } from "../../utils/showcase-nav";

interface Props {
  caseId: string;
}

const { caseId: requestedId } = Astro.props;
const caseId = MAIN_CASES.find((definition) => definition.id === requestedId)?.id;
if (!caseId) throw new Error(`Unknown case: ${requestedId}`);
const cases = getLocalizedCases("pt-br");
const project = cases.find((entry) => entry.id === caseId);
const neighbors = showcaseNeighbors(caseId);
const position = showcasePosition(caseId);
if (!project || !neighbors || !position) throw new Error(`Unknown case: ${caseId}`);

const media = SHOWCASE_MEDIA[caseId];
const text = ptBrDict.showcase;
const siteLink = project.links.find((link) => link.type === "demo") ?? project.links[0];
const tiles = showcaseTiles(caseId).map((tile) => ({
  ...tile,
  title: cases.find((entry) => entry.id === tile.id)?.title ?? tile.id,
  image: SHOWCASE_MEDIA[tile.id].screenshot,
}));

const barButton =
  "inline-flex h-11 min-w-11 items-center justify-center border-2 border-space-base bg-paper-white px-3 font-mono text-sm font-black text-space-base hover:bg-space-base hover:text-paper-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-bebop-red";
---

<section data-showcase class="bg-paper-white text-space-base">
  <div
    data-showcase-bar
    role="group"
    aria-label={text.controlsAria}
    data-i18n="showcase.controlsAria"
    data-i18n-attr="aria-label"
    class="flex h-16 flex-nowrap items-center gap-2 border-b-4 border-space-base px-4 sm:gap-3 sm:px-8 md:h-20 md:px-9 lg:h-24"
  >
    <a
      data-showcase-prev
      href={casePath(neighbors.prev)}
      aria-label={text.prevAria}
      data-i18n="showcase.prevAria"
      data-i18n-attr="aria-label"
      class={barButton}
    ><span aria-hidden="true">←</span></a>
    <a
      data-showcase-next
      href={casePath(neighbors.next)}
      aria-label={text.nextAria}
      data-i18n="showcase.nextAria"
      data-i18n-attr="aria-label"
      class={barButton}
    ><span aria-hidden="true">→</span></a>
    <p data-showcase-position class="font-mono text-xs font-black tracking-wider whitespace-nowrap uppercase sm:text-sm sm:tracking-widest">
      <span data-i18n="showcase.caseLabel" class="max-sm:sr-only">{text.caseLabel}</span> {position}
    </p>
    <a
      data-showcase-site
      href={siteLink.url}
      target="_blank"
      rel="noopener noreferrer"
      class="ml-auto inline-flex h-11 items-center gap-1 border-2 border-space-base bg-bebop-red px-3 font-mono text-xs whitespace-nowrap sm:gap-2 sm:px-4 sm:text-sm font-black text-space-base uppercase hover:bg-space-base hover:text-paper-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-space-base"
    ><span data-i18n="showcase.liveSite" class="max-sm:hidden">{text.liveSite}</span><span data-i18n="showcase.site" class="sm:hidden">{text.site}</span> <span aria-hidden="true">↗</span></a>
  </div>

  <h1
    data-case-title
    style={`view-transition-name: case-title-${project.id}`}
    class="border-b-4 border-space-base bg-bebop-red px-4 pt-6 pb-5 font-display text-[clamp(1.25rem,6.8vw,3.5rem)] leading-[0.92] font-black tracking-tight text-space-base uppercase break-words sm:px-8 md:px-9 md:pt-7 md:text-[clamp(2.25rem,6.6vw,5.25rem)] lg:text-[clamp(3rem,5vw,5.25rem)]"
  >{project.title}</h1>

  <div data-showcase-stage class="relative border-b-4 border-space-base py-6 pr-0 pl-4 sm:pl-8 md:py-10 md:pl-9 lg:pr-9">
    <div
      data-showcase-track
      tabindex="0"
      role="region"
      aria-label={text.stageAria}
      data-i18n="showcase.stageAria"
      data-i18n-attr="aria-label"
      class="flex snap-x snap-mandatory gap-5 overflow-x-auto overscroll-x-contain pt-5 pr-4 pb-3 md:gap-9 md:pt-6 md:pr-9 md:pb-4 lg:grid lg:grid-cols-2 lg:gap-6 lg:overflow-visible lg:pt-0 lg:pr-0 lg:pb-0"
    >
    {media.video ? (
      <figure data-showcase-card="media" class="relative m-0 border-4 border-space-base bg-space-base w-[min(330px,calc(100vw-3rem))] shrink-0 snap-start md:w-[640px] lg:w-auto lg:shrink">
        <video
          data-showcase-video
          class="block h-auto w-full"
          width={media.video.width}
          height={media.video.height}
          poster={media.video.poster.src}
          preload="none"
          muted
          loop
          playsinline
          aria-label={media.video.poster.alt["pt-br"]}
        >
          <source src={media.video.webm} type="video/webm" />
          <source src={media.video.mp4} type="video/mp4" />
        </video>
        <figcaption class="flex items-center justify-between gap-3 bg-space-base px-3 py-2 text-paper-white">
          <span data-showcase-tag class="font-mono text-[11px] font-black tracking-widest uppercase">{media.video.tag["pt-br"]}</span>
          <button
            type="button"
            data-showcase-toggle
            aria-pressed="false"
            hidden
            class="inline-flex h-11 min-w-11 items-center justify-center border-2 border-paper-white px-3 font-mono text-[11px] font-black tracking-widest uppercase hover:bg-paper-white hover:text-space-base focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-bebop-red"
          ><span data-i18n="showcase.play">{text.play}</span> · <span data-i18n="showcase.pause">{text.pause}</span></button>
        </figcaption>
      </figure>
    ) : (
      <figure data-showcase-card="media" class="relative m-0 border-4 border-space-base bg-space-base w-[min(330px,calc(100vw-3rem))] shrink-0 snap-start md:w-[640px] lg:w-auto lg:shrink">
        <img
          class="block h-auto w-full"
          src={media.screenshot.src}
          width={media.screenshot.width}
          height={media.screenshot.height}
          data-showcase-alt
          alt={media.screenshot.alt["pt-br"]}
          decoding="async"
        />
      </figure>
    )}

    {media.highlight && !media.video ? (
      <div data-showcase-card="second" data-showcase-highlight class="flex flex-col justify-center gap-3 border-4 border-space-base bg-space-base p-6 text-paper-white w-[260px] shrink-0 snap-start md:w-[420px] lg:w-auto lg:shrink">
        <p data-showcase-highlight-label class="font-mono text-[11px] font-black tracking-widest uppercase">{media.highlight.label["pt-br"]}</p>
        <p class="font-display text-[clamp(3rem,10vw,5rem)] leading-none font-black text-bebop-red">{media.highlight.value}</p>
        <p class="font-mono text-xs font-bold break-words">{media.highlight.flow}</p>
        <p data-showcase-highlight-note class="font-mono text-xs font-bold uppercase">{media.highlight.note["pt-br"]}</p>
      </div>
    ) : (
      <figure data-showcase-card="second" class="relative m-0 border-4 border-space-base bg-space-base w-[260px] shrink-0 snap-start md:w-[420px] lg:w-auto lg:shrink">
        <img
          class="block h-auto w-full"
          src={media.screenshot.src}
          width={media.screenshot.width}
          height={media.screenshot.height}
          data-showcase-alt
          alt={media.screenshot.alt["pt-br"]}
          loading="lazy"
          decoding="async"
        />
      </figure>
    )}
    </div>

    <img
      data-showcase-sticker
      class="pointer-events-none absolute top-1.5 right-8 z-10 w-[84px] rotate-[10deg] sm:w-24 md:top-2.5 md:right-auto md:left-[560px] md:w-[120px] lg:top-0 lg:right-[44%] lg:left-auto lg:w-32"
      src={media.sticker.src}
      width="150"
      height="150"
      alt=""
      aria-hidden="true"
    />
  </div>

  <div class="px-4 pt-6 pb-6 sm:px-8 md:px-9 md:pt-8">
    <p data-case-description class="font-body text-base leading-relaxed font-medium sm:text-lg md:text-[19px]">{project.description}</p>
  <ul aria-label={text.stackAria} data-i18n="showcase.stackAria" data-i18n-attr="aria-label" class="mt-4 flex flex-wrap gap-2.5 font-mono text-[11px] font-bold uppercase md:text-[13px]">
    {project.stack.map((tech) => (
      <li data-case-stack-item class="border-[3px] border-space-base bg-paper-white px-2 py-1 md:px-3 md:py-1.5">{tech}</li>
    ))}
  </ul>
  </div>

  <nav
    data-showcase-tiles
    aria-label={text.tilesAria}
    data-i18n="showcase.tilesAria"
    data-i18n-attr="aria-label"
    class="grid grid-cols-2 gap-3 border-t-4 border-space-base px-4 py-6 sm:px-8 md:gap-4 md:px-9 md:py-7 lg:grid-cols-4"
  >
    {tiles.map((tile) => (
      <a
        href={tile.href}
        aria-current={tile.current ? "page" : undefined}
        class:list={[
          "block border-4 border-space-base bg-paper-white text-space-base focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-bebop-red",
          tile.current ? "bg-bebop-red" : "hover:bg-space-base hover:text-paper-white",
        ]}
      >
        <img
          class="block h-24 w-full object-cover object-top md:h-32 lg:h-36"
          src={tile.image.src}
          width={tile.image.width}
          height={tile.image.height}
          alt=""
          loading="lazy"
          decoding="async"
        />
        <span data-showcase-tile-title={tile.id} class="block px-2 py-1.5 font-mono text-[11px] font-black tracking-wider uppercase break-words">
          {String(tile.index).padStart(2, "0")} · {tile.title}
        </span>
      </a>
    ))}
  </nav>
</section>

<script>
  import { onPageReady } from "../../utils/page-lifecycle";
  import { initShowcaseVideo } from "./showcase-video-bind";

  onPageReady(() => {
    const showcase = document.querySelector<HTMLElement>("[data-showcase]");
    return showcase ? initShowcaseVideo(showcase) : undefined;
  });
</script>
