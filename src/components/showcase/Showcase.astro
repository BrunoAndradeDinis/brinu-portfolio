---
import { getLocalizedCases, MAIN_CASES } from "../../data/cases";
import { SHOWCASE_MEDIA } from "../../data/showcase";
import { SHOWCASE_LAYOUT } from "../../data/showcase-layout";
import { ptBrDict } from "../../i18n/dictionaries";
import PanelClose from "../p5/PanelClose.astro";
import { casePath } from "../../utils/case-pages";
import { showcaseNeighbors, showcasePosition, showcaseTiles } from "../../utils/showcase-nav";

interface Props {
  caseId: string;
}

const { caseId: requestedId } = Astro.props;
const caseId = MAIN_CASES.find((definition) => definition.id === requestedId)?.id;
if (!caseId) throw new Error(`Unknown case: ${requestedId}`);
const project = getLocalizedCases("pt-br").find((entry) => entry.id === caseId);
const neighbors = showcaseNeighbors(caseId);
const position = showcasePosition(caseId);
if (!project || !neighbors || !position) throw new Error(`Unknown case: ${caseId}`);

const media = SHOWCASE_MEDIA[caseId];
const { copy } = media;
const layout = SHOWCASE_LAYOUT[caseId];
const text = ptBrDict.showcase;
const siteLink = project.links.find((link) => link.type === "demo") ?? project.links[0];
const tiles = showcaseTiles(caseId).map((tile) => ({
  ...tile,
  name: SHOWCASE_LAYOUT[tile.id].name,
  image: SHOWCASE_MEDIA[tile.id].screenshot,
}));
const compactPosition = position.replace(/ /g, "");

const barArrow =
  "flex w-14 items-center justify-center border-r-4 border-space-base text-2xl font-extrabold hover:bg-space-base hover:text-paper-white focus-visible:outline-2 focus-visible:-outline-offset-4 focus-visible:outline-bebop-red md:w-20 md:text-3xl lg:w-32 lg:text-[40px]";
const nameClass =
  "font-display font-extrabold leading-[0.88] tracking-[-0.02em] uppercase";
const polygon = "[clip-path:polygon(0_1.5%,3%_0,100%_.8%,99.4%_100%,2%_99%)]";
const card = `relative shrink-0 snap-start overflow-hidden border-[5px] border-space-base bg-space-base ${polygon}`;
const sizeFirst = "h-[300px] w-[min(350px,calc(100vw-2rem))] md:h-[504px] md:w-[680px] lg:h-[580px] lg:w-[984px]";
const sizeSecond = "h-[300px] w-[280px] md:h-[504px] md:w-[460px] lg:h-[580px] lg:w-[640px]";
const tag =
  "absolute top-5 left-[22px] max-w-[calc(100%-44px)] bg-space-base px-3 py-1.5 font-mono text-xs font-bold tracking-[0.1em] text-paper-white uppercase";

const CASE_VIDEO_ATTRS = {
  muted: true,
  playsinline: true,
  disablepictureinpicture: true,
  disableremoteplayback: true,
  controlslist: "nofullscreen nodownload noremoteplayback noplaybackrate",
};

const videoList = media.video
  ? (media.videos && media.videos.length > 0 ? media.videos : [media.video, media.video, media.video])
  : [];
---

<section id={`case-${caseId}`} data-showcase={caseId} class="bg-paper-white text-space-base">
  <h1
    data-case-title
    class="sr-only"
  >{project.title}</h1>

  <div
    data-showcase-bar
    role="group"
    aria-label={text.controlsAria}
    data-i18n="showcase.controlsAria"
    data-i18n-attr="aria-label"
    class="flex h-16 flex-nowrap items-stretch overflow-hidden border-b-4 border-space-base bg-paper-white md:h-20 lg:h-24"
  >
    <a
      data-showcase-prev
      href={casePath(neighbors.prev)}
      aria-label={text.prevAria}
      data-i18n="showcase.prevAria"
      data-i18n-attr="aria-label"
      class={barArrow}
    ><span aria-hidden="true">←</span></a>
    <a
      data-showcase-next
      href={casePath(neighbors.next)}
      aria-label={text.nextAria}
      data-i18n="showcase.nextAria"
      data-i18n-attr="aria-label"
      class={barArrow}
    ><span aria-hidden="true">→</span></a>
    <p data-showcase-position class="flex w-[76px] items-center justify-center font-mono text-[11px] font-bold tracking-[0.08em] whitespace-nowrap uppercase md:w-[140px] md:border-r-4 md:border-space-base md:text-sm lg:w-[220px] lg:text-lg">
      <span><span data-i18n="showcase.caseLabel" class="max-lg:sr-only">{text.caseLabel}</span> <span class="max-md:hidden">{position}</span><span aria-hidden="true" class="md:hidden">{compactPosition}</span></span>
    </p>
    <ul aria-label={text.stackAria} data-i18n="showcase.stackAria" data-i18n-attr="aria-label" class="m-0 hidden min-w-[300px] list-none flex-col justify-center gap-1 border-r-4 border-space-base px-7 font-mono text-sm font-bold tracking-[0.08em] uppercase lg:flex">
      {layout.barStack.map((tech) => (<li data-showcase-bar-stack>■ {tech}</li>))}
    </ul>
    <a
      data-showcase-site
      data-prototype-contrast
      href={siteLink.url}
      target="_blank"
      rel="noopener noreferrer"
      class={`ml-auto flex items-center gap-1 bg-bebop-red px-3.5 font-display text-[13px] font-extrabold whitespace-nowrap text-paper-white uppercase hover:bg-space-base focus-visible:outline-2 focus-visible:-outline-offset-4 focus-visible:outline-space-base md:gap-2.5 md:px-7 md:text-lg lg:px-10 lg:text-[22px] [clip-path:polygon(8%_0,100%_0,100%_100%,0_100%)]`}
    ><span data-showcase-cta data-showcase-cta-full class="max-md:hidden">{copy.cta["pt-br"]}</span><span data-showcase-cta data-showcase-cta-short class="md:hidden">{layout.ctaShort}</span><span aria-hidden="true">↗</span></a>
  </div>

  <div data-showcase-banner class="@container border-b-4 border-space-base bg-bebop-red px-4 pt-5 pb-4 md:px-9 md:pt-7 md:pb-[22px] lg:hidden">
    <p
      data-showcase-name
      aria-hidden="true"
      style={`view-transition-name: case-title-${project.id}; --name-em: ${layout.nameEm}`}
      class={`${nameClass} text-[length:min(44px,calc(100cqw/var(--name-em)))] md:text-[length:min(84px,calc(100cqw/var(--name-em)))]`}
    >{layout.name}</p>
  </div>

  <div data-showcase-stage class="flex h-[330px] border-b-4 border-space-base bg-paper-white md:h-[540px] lg:h-[620px]">
    <div data-showcase-rail class="hidden w-32 shrink-0 items-center justify-center border-r-4 border-space-base bg-bebop-red lg:flex">
      <span
        data-showcase-name
        aria-hidden="true"
        style={`view-transition-name: case-title-${project.id}`}
        class={`${nameClass} rotate-180 text-[45px] whitespace-nowrap [writing-mode:vertical-rl]`}
      >{layout.name}</span>
    </div>
    <div data-showcase-viewport class="relative min-w-0 flex-1 overflow-hidden">
      <div
        data-showcase-track
        tabindex="0"
        role="region"
        aria-label={text.stageAria}
        data-i18n="showcase.stageAria"
        data-i18n-attr="aria-label"
        aria-describedby={videoList.length > 0 ? `showcase-fullscreen-hint-${caseId}` : undefined}
        aria-keyshortcuts={videoList.length > 0 ? "F Enter" : undefined}
        class="flex h-full scroll-pl-3 snap-x snap-mandatory items-center gap-3 overflow-x-auto overscroll-x-contain py-3 pl-3 [overflow-anchor:none] [scrollbar-width:none] md:scroll-pl-5 md:gap-5 md:py-4 md:pl-5 lg:scroll-pl-6 lg:gap-6 lg:py-5 lg:pl-6 [&::-webkit-scrollbar]:hidden"
      >
        {videoList.length > 0 ? (
          videoList.map((vid, idx) => {
            const slotName = idx === 0 ? "media" : idx === 1 ? "second" : idx === 2 ? "third" : undefined;
            return (
              <figure
                data-showcase-card={slotName}
                data-showcase-card-clone={slotName ? undefined : ""}
                aria-hidden={slotName ? undefined : "true"}
                data-video-index={idx}
                class={`${card} m-0 cursor-none ${sizeFirst}`}
              >
                <video
                  data-showcase-video={idx === 0 ? "" : undefined}
                  data-showcase-video-duplicate={idx > 0 ? "" : undefined}
                  class="block h-full w-full cursor-none object-cover object-top"
                  width={vid.width}
                  height={vid.height}
                  poster={vid.poster.src}
                  preload="none"
                  {...CASE_VIDEO_ATTRS}
                  loop
                  aria-label={vid.poster.alt["pt-br"]}
                  aria-description={text.hintTitle}
                  data-i18n="showcase.hintTitle"
                  data-i18n-attr="aria-description"
                >
                  <source src={vid.webm} type="video/webm" />
                  <source src={vid.mp4} type="video/mp4" />
                </video>
                <span data-showcase-hint aria-hidden="true" class="showcase-hint pointer-events-none absolute right-4 bottom-4 z-[5] flex max-w-[calc(100%-2rem)] items-center gap-2 border-2 border-paper-white bg-space-base px-2.5 py-1.5 font-mono text-[11px] font-bold tracking-[0.1em] whitespace-nowrap text-paper-white uppercase shadow-[3px_3px_0_var(--color-bebop-red)] md:right-6 md:bottom-6 md:text-xs">
                  <span data-hint-variant="dblclick" class="items-center gap-2">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" focusable="false"><path d="M7 3v9l-2.5-2L3 11.5 8 20h9l2-8-6-1.5V3z" /></svg>
                    <span data-i18n="showcase.hintDoubleClick">{text.hintDoubleClick}</span>
                  </span>
                  <span data-hint-variant="rotate" class="items-center gap-2">
                    <svg class="showcase-hint-phone" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" focusable="false"><rect x="7" y="3" width="10" height="18" /><path d="M11 18h2" /></svg>
                    <span data-i18n="showcase.hintRotate">{text.hintRotate}</span>
                  </span>
                </span>
              </figure>
            );
          })
        ) : (
          <>
            <figure data-showcase-card="media" class={`${card} m-0 ${sizeFirst}`}>
              <img
                class="block h-full w-full object-cover object-top"
                src={media.screenshot.src}
                srcset={media.screenshot.srcset}
                sizes="(min-width: 64rem) 50vw, 100vw"
                width={media.screenshot.width}
                height={media.screenshot.height}
                data-showcase-alt
                alt={media.screenshot.alt["pt-br"]}
                decoding="async"
              />
              {media.highlight && (<figcaption data-showcase-highlight-label class={tag}>{media.highlight.label["pt-br"]}</figcaption>)}
            </figure>
            {media.highlight ? (
              <div data-showcase-card="second" data-showcase-highlight class={`${card} flex flex-col justify-end gap-2.5 bg-space-base p-9 text-paper-white ${sizeSecond}`}>
                <p class={`${nameClass} text-[54px] text-bebop-red`}>{media.highlight.value}</p>
                <p class="font-mono text-[15px] tracking-[0.08em] break-words uppercase">{media.highlight.flow}</p>
                <p data-showcase-highlight-note class="font-mono text-[13px] tracking-[0.08em] uppercase opacity-70">{media.highlight.note["pt-br"]}</p>
              </div>
            ) : (
              <figure data-showcase-card="second" class={`${card} m-0 ${sizeSecond}`}>
                <img
                  class="block h-full w-full object-cover object-top"
                  src={media.screenshot.src}
                  width={media.screenshot.width}
                  height={media.screenshot.height}
                  data-showcase-alt
                  alt={media.screenshot.alt["pt-br"]}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            )}
          </>
        )}
        <span data-showcase-spacer aria-hidden="true" class="w-4 shrink-0 md:w-9"></span>
      </div>
      {media.video && (
        <button
          type="button"
          data-showcase-toggle
          data-prototype-contrast
          aria-pressed="false"
          hidden
          class="showcase-video-toggle absolute bottom-8 left-10 z-10 inline-flex min-h-11 min-w-11 cursor-none items-center justify-center border-0 bg-transparent p-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-bebop-red"
        ><span data-showcase-toggle-ball class="showcase-video-toggle-ball pointer-events-none inline-flex min-h-11 min-w-11 items-center justify-center border-[3px] border-space-base bg-bebop-red px-4 py-2 font-mono text-sm font-bold tracking-[0.1em] text-paper-white uppercase shadow-[4px_4px_0_#080808]"><span data-showcase-play data-i18n="showcase.play">{text.play}</span><span data-showcase-pause data-i18n="showcase.pause" hidden>{text.pause}</span></span></button>
      )}
    </div>
  </div>

  <div class="px-4 pt-6 md:px-9 md:pt-8 lg:flex lg:h-[236px] lg:gap-12 lg:pt-9 lg:pr-12 lg:pl-44">
    <div class="lg:flex-[1.2]">
      <p data-showcase-copy-title aria-hidden="true" class={`${nameClass} hidden text-[56px] lg:block`}>{layout.name}</p>
      <p data-showcase-kicker data-prototype-contrast class="font-mono text-[11px] font-bold tracking-[0.08em] text-bebop-red uppercase md:text-[13px] lg:mt-3.5 lg:text-sm">{copy.kicker?.["pt-br"] ?? project.subtitle.replace("•", "·")}</p>
    </div>
    <div class="lg:flex-1">
      <p data-showcase-lead class="mt-2 text-base leading-[1.4] font-medium md:mt-2.5 md:text-[19px] lg:mt-0">{copy.lead["pt-br"]}</p>
      <ul class="mt-3.5 flex list-none flex-wrap gap-2 p-0 font-mono text-[11px] font-bold tracking-[0.06em] uppercase md:mt-[18px] md:gap-2.5 md:text-[13px] lg:hidden">
        {layout.barStack.map((tech) => (<li data-showcase-chip class="border-[3px] border-space-base bg-paper-white px-2 py-1 md:px-3 md:py-1.5">{tech}</li>))}
      </ul>
      <p data-showcase-note-line class="mt-3.5 font-mono text-[11px] font-bold tracking-[0.08em] uppercase md:mt-[18px] md:text-[13px] lg:mt-3.5"><span aria-hidden="true">▸&nbsp;</span><span data-showcase-note>{copy.note["pt-br"]}</span></p>
    </div>
  </div>

  <nav
    data-showcase-tiles
    aria-label={text.tilesAria}
    data-i18n="showcase.tilesAria"
    data-i18n-attr="aria-label"
    class="grid grid-cols-2 gap-3 px-4 py-[22px] md:gap-4 md:px-9 md:py-7 lg:flex lg:h-[150px] lg:gap-5 lg:py-0 lg:pr-12 lg:pl-44"
  >
    {tiles.map((tile) => (
      <a
        href={tile.href}
        aria-current={tile.current ? "page" : undefined}
        class:list={[
          "group relative block h-24 overflow-hidden border-4 bg-space-base focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-bebop-red md:h-32 lg:h-[130px] lg:flex-1",
          tile.current ? "border-bebop-red shadow-[6px_6px_0_#080808]" : "border-space-base",
        ]}
      >
        <img
          class:list={["block h-full w-full object-cover object-top", tile.current ? "opacity-100" : "opacity-55 group-hover:opacity-100"]}
          src={tile.image.src}
          width={tile.image.width}
          height={tile.image.height}
          alt=""
          loading="lazy"
          decoding="async"
        />
        <b data-prototype-contrast class="absolute top-0 left-0 bg-bebop-red px-3 py-1 font-display text-base font-extrabold text-paper-white">{String(tile.index).padStart(2, "0")}</b>
        <i class="absolute bottom-2 left-2.5 font-mono text-xs font-bold tracking-[0.08em] text-paper-white uppercase not-italic [text-shadow:0_0_6px_#080808]">{tile.name}</i>
      </a>
    ))}
  </nav>

  {videoList.length > 0 && (
    <>
      <span id={`showcase-fullscreen-hint-${caseId}`} hidden data-i18n="showcase.fullscreenOpenAria">{text.fullscreenOpenAria}</span>
      <script type="application/json" data-showcase-videos-data set:html={JSON.stringify(videoList)} />
      <dialog
        data-showcase-fullscreen-modal
        data-lenis-prevent
        aria-label={text.stageAria}
        class="fixed inset-0 z-[10000] m-0 h-dvh max-h-none w-screen max-w-none border-0 bg-space-base/95 p-0 text-paper-white backdrop-blur-md flex flex-col justify-between items-center select-none overflow-hidden"
      >
        <div class="w-full shrink-0 flex items-center justify-between gap-3 px-4 py-3 sm:px-6 sm:py-4 bg-space-base border-b-2 border-bebop-red">
          <div class="flex items-center gap-3 min-w-0">
            <span class="shrink-0 inline-block px-2 py-0.5 border border-paper-white bg-bebop-red font-mono text-[10px] sm:text-xs font-black uppercase text-paper-white tracking-wider">
              {layout.name}
            </span>
            <span data-showcase-modal-tag class="font-mono text-xs sm:text-sm text-paper-white font-bold tracking-wider uppercase truncate"></span>
          </div>

          <div class="flex items-center gap-3 shrink-0">
            <span data-showcase-modal-counter class="font-mono text-xs sm:text-sm font-bold tracking-widest text-paper-white">
              01 / {String(videoList.length).padStart(2, "0")}
            </span>

            <PanelClose tone="paper" inline />
          </div>
        </div>

        <div class="relative w-full flex-1 min-h-0 flex items-center justify-center p-3 sm:p-6 md:p-10">
          <button
            type="button"
            data-showcase-modal-prev
            aria-label={text.fullscreenPrev}
            data-i18n="showcase.fullscreenPrev"
            data-i18n-attr="aria-label"
            class="absolute left-2 sm:left-6 md:left-10 z-30 flex h-12 w-12 sm:h-14 sm:w-14 md:h-16 md:w-16 items-center justify-center border-3 border-paper-white bg-space-base text-paper-white font-display text-2xl sm:text-3xl font-black uppercase hover:bg-bebop-red hover:text-paper-white transition-all cursor-pointer shadow-[4px_4px_0_var(--color-bebop-red)] active:translate-x-0.5 active:translate-y-0.5"
          >
            <span aria-hidden="true">←</span>
          </button>

          <div class="relative max-w-full max-h-full flex items-center justify-center border-4 border-paper-white bg-space-base shadow-[10px_10px_0_var(--color-bebop-red)] overflow-hidden">
            <video
              data-showcase-modal-video
              width={1920}
              height={1080}
              class="max-w-[85vw] sm:max-w-[78vw] md:max-w-[75vw] max-h-[65vh] sm:max-h-[72vh] md:max-h-[76vh] object-contain block bg-space-base"
              {...CASE_VIDEO_ATTRS}
              controls
              preload="auto"
            ></video>
          </div>

          <button
            type="button"
            data-showcase-modal-next
            aria-label={text.fullscreenNext}
            data-i18n="showcase.fullscreenNext"
            data-i18n-attr="aria-label"
            class="absolute right-2 sm:right-6 md:right-10 z-30 flex h-12 w-12 sm:h-14 sm:w-14 md:h-16 md:w-16 items-center justify-center border-3 border-paper-white bg-space-base text-paper-white font-display text-2xl sm:text-3xl font-black uppercase hover:bg-bebop-red hover:text-paper-white transition-all cursor-pointer shadow-[4px_4px_0_var(--color-bebop-red)] active:translate-x-0.5 active:translate-y-0.5"
          >
            <span aria-hidden="true">→</span>
          </button>
        </div>

        <div class="w-full shrink-0 flex items-center justify-center gap-4 py-2.5 px-4 bg-space-base border-t-2 border-space-base/50 font-mono text-[10px] sm:text-xs text-muted-gray uppercase">
          <span data-i18n="showcase.fullscreenHint">{text.fullscreenHint}</span>
        </div>
      </dialog>
    </>
  )}
</section>

<style>
  dialog[data-showcase-fullscreen-modal] {
    display: none;
  }

  dialog[data-showcase-fullscreen-modal][open] {
    display: flex;
  }

  dialog[data-showcase-fullscreen-modal]::backdrop {
    background-color: rgba(8, 8, 8, 0.95);
    backdrop-filter: blur(8px);
  }

  video::-webkit-media-controls-mute-button,
  video::-webkit-media-controls-volume-slider,
  video::-webkit-media-controls-volume-control-container,
  video::-webkit-media-controls-fullscreen-button,
  video::-webkit-media-controls-overflow-button {
    display: none;
  }

  .showcase-hint {
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
  }

  .showcase-hint [data-hint-variant] {
    display: none;
  }

  [data-showcase-hint-on] [data-showcase-card="media"] .showcase-hint {
    opacity: 1;
  }

  [data-showcase-hint-mode="dblclick"] [data-showcase-card="media"] [data-hint-variant="dblclick"],
  [data-showcase-hint-mode="rotate"] [data-showcase-card="media"] [data-hint-variant="rotate"] {
    display: inline-flex;
  }

  .showcase-hint-phone {
    transform-box: fill-box;
    transform-origin: center;
  }

  [data-showcase-hint-mode="rotate"][data-showcase-hint-on] .showcase-hint-phone {
    animation: showcase-hint-rotate 1.5s ease-in-out infinite;
  }

  @keyframes showcase-hint-rotate {
    0%, 20% { transform: rotate(0deg); }
    60%, 100% { transform: rotate(-90deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .showcase-hint {
      transition: none;
    }

    [data-showcase-hint-mode="rotate"] .showcase-hint-phone {
      animation: none;
      transform: rotate(-90deg);
    }
  }

  .showcase-video-toggle {
    cursor: none;
  }

  .showcase-video-toggle-ball {
    opacity: 0;
    border-radius: 9999px;
    transform: scale(0) rotate(-3deg);
    transform-origin: center center;
    transition:
      transform 0.3s ease-in-out,
      border-radius 0.3s ease-in-out,
      opacity 0.3s ease-in-out;
    will-change: transform, border-radius, opacity;
  }

  [data-showcase-viewport][data-video-hover="true"] .showcase-video-toggle-ball,
  .showcase-video-toggle:focus-visible .showcase-video-toggle-ball {
    opacity: 1;
    border-radius: 0px;
    transform: scale(1) rotate(-3deg);
  }
</style>

<script>
  import { onPageReady } from "../../utils/page-lifecycle";
  import { initShowcaseVideo } from "./showcase-video-bind";
  import { initShowcaseFullscreen } from "./showcase-fullscreen";
  import { initShowcaseHint } from "./showcase-hint";
  import { installShowcaseTransition } from "./showcase-transition";

  installShowcaseTransition();
  onPageReady(() => {
    const showcase = document.querySelector<HTMLElement>("[data-showcase]");
    if (!showcase) return undefined;
    const teardownVideo = initShowcaseVideo(showcase);
    const teardownFullscreen = initShowcaseFullscreen(showcase);
    const teardownHint = initShowcaseHint(showcase);
    return () => {
      teardownVideo?.();
      teardownFullscreen?.();
      teardownHint();
    };
  });
</script>
