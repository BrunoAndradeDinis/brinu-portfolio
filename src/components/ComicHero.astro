---
/**
 * ComicHero.astro
 * Hero Section Carmesim Monumental (#FE0000) com Tipografia Colossal "BRINU" em Preto Sólido.
 * Estilizada integralmente via Tailwind CSS v4 & Bebop Design Tokens.
 */
---

<!-- Fita Ticker Tape Contínua de Abertura -->
<div
  class="group flex h-[4.125rem] w-full items-center overflow-hidden border-t-3 border-b-6 border-space-base bg-bebop-red select-none box-border cursor-default"
  aria-hidden="true"
>
  <div
    class="inline-flex shrink-0 items-center whitespace-nowrap animate-marquee font-display text-base sm:text-xl lg:text-2xl tracking-wider text-space-base transition-colors duration-300 group-hover:text-paper-white leading-none"
  >
    <span class="inline-block shrink-0 whitespace-nowrap pr-12 sm:pr-16">
      • SOFTWARE ENGINEER • CREATIVE TECHNOLOGIST • DISTRIBUTED SYSTEMS
      ARCHITECTURE • FULL STACK DEVELOPMENT • HIGH PERFORMANCE (60 FPS) • CLOUD
      &amp; DEVOPS • TYPESCRIPT • NODE.JS • REACT • ASTRO • DOCKER • RESILIENT
      APIS •
    </span>
    <span class="inline-block shrink-0 whitespace-nowrap pr-12 sm:pr-16">
      • SOFTWARE ENGINEER • CREATIVE TECHNOLOGIST • DISTRIBUTED SYSTEMS
      ARCHITECTURE • FULL STACK DEVELOPMENT • HIGH PERFORMANCE (60 FPS) • CLOUD
      &amp; DEVOPS • TYPESCRIPT • NODE.JS • REACT • ASTRO • DOCKER • RESILIENT
      APIS •
    </span>
  </div>
</div>

<!-- Hero Monumental Carmesim com Tipografia Preta Colossal -->
<section
  class="relative flex min-h-[calc(100vh-7rem-4.125rem)] flex-col bg-bebop-red px-4 py-4 sm:px-8 sm:py-7 md:px-10 md:py-8 lg:px-20 lg:py-10"
  id="hero"
>
  <div
    class="mx-auto flex w-full max-w-[160rem] flex-1 flex-col justify-between"
  >
    <!-- Palco Tipográfico Centralizado com Letras Monumentais e Avatar Centralizado -->
    <div
      class="relative my-auto flex w-full items-center justify-center py-6 sm:py-8 md:py-10 lg:py-16"
    >
      <h1
        class="flex w-full select-none flex-row flex-nowrap items-center justify-between whitespace-nowrap font-display text-[clamp(3.5rem,16vw,5.5rem)] sm:text-[clamp(4.5rem,13.5vw,7rem)] md:text-[clamp(6.5rem,13.5vw,9.5rem)] lg:text-[clamp(9.5rem,14vw,14rem)] font-black leading-[0.85] tracking-tight text-space-base"
        aria-label="BRINU"
      >
        <span class="inline-block shrink-0 leading-[0.85]" aria-hidden="true">B</span>
        <span class="inline-block shrink-0 leading-[0.85]" aria-hidden="true">R</span>
        <span
          class="inline-block shrink-0 leading-[0.85] px-3.5 sm:px-7 md:px-11 lg:px-16 text-center"
          aria-hidden="true"
          >I</span
        >
        <span class="inline-block shrink-0 leading-[0.85]" aria-hidden="true">N</span>
        <span class="inline-block shrink-0 leading-[0.85]" aria-hidden="true">U</span>
      </h1>

      <!-- Personagem / Avatar Noir Centralizado Sobreposto ao Glifo Central 'I' -->
      <div
        class="pointer-events-none absolute left-1/2 top-1/2 z-10 flex -translate-x-1/2 -translate-y-1/2 flex-col items-center"
        aria-hidden="true"
      >
        <div
          class="pointer-events-auto h-[clamp(3.15rem,13vw,4.5rem)] w-[clamp(3.15rem,13vw,4.5rem)] sm:h-[clamp(5.5rem,12vw,7.5rem)] sm:w-[clamp(5.5rem,12vw,7.5rem)] md:h-[clamp(8rem,13vw,11.5rem)] md:w-[clamp(8rem,13vw,11.5rem)] lg:h-[clamp(11.5rem,14vw,15.5rem)] lg:w-[clamp(11.5rem,14vw,15.5rem)] overflow-hidden rounded-xl sm:rounded-2xl border-2 sm:border-4 md:border-[0.45rem] lg:border-[0.5rem] border-space-base bg-paper-white shadow-[0_3px_0_var(--color-space-base)] sm:shadow-[0_4px_0_var(--color-space-base)] md:shadow-[0_6px_0_var(--color-space-base)] lg:shadow-[0_8px_0_var(--color-space-base)] mr-3"
        >
          <img
            src="/assets/brinu-avatar.jpg"
            alt="Retrato Noir do Bruno"
            class="h-full w-full object-cover contrast-125"
          />
        </div>
        <span
          class="pointer-events-auto -mt-1 sm:-mt-2.5 md:-mt-3 -rotate-4 rounded sm:rounded-md border-[1.5px] sm:border-2 md:border-[0.25rem] border-space-base bg-bebop-amber px-1.5 sm:px-2.5 md:px-3 py-0.5 sm:py-0.5 md:py-1 font-spray text-[9px] sm:text-xs md:text-sm lg:text-base font-bold whitespace-nowrap text-space-base shadow-[0_2px_0_var(--color-space-base)] sm:shadow-[0_3px_0_var(--color-space-base)]"
        >
          É uma cilada Brinu!
        </span>
      </div>
    </div>

    <!-- Textos de Canto Estilo Editorial de Quadrinhos (Quarta Imagem) -->
    <div
      class="mt-4 sm:mt-8 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-5 sm:gap-6 md:gap-8 pt-2 sm:pt-4"
    >
      <!-- Canto Inferior Esquerdo -->
      <div
        class="flex flex-col items-start text-left max-w-full sm:max-w-[48%] lg:max-w-md shrink-0"
      >
        <p
          class="mb-2 sm:mb-4 font-display text-xs sm:text-base md:text-lg lg:text-2xl font-black leading-snug tracking-tight text-space-base"
        >
          FOR TOO LONG<br />
          BORING CODE<br />
          HAS RULED THE WEB
        </p>
        <a
          href="#works"
          class="inline-flex items-center gap-1.5 sm:gap-2.5 font-mono text-[11px] sm:text-xs md:text-xs lg:text-sm tracking-wider text-space-base transition-opacity hover:opacity-80"
        >
          <span
            class="inline-flex h-4.5 w-4.5 sm:h-6 sm:w-6 items-center justify-center rounded-full bg-space-base text-paper-white text-[9px] sm:text-xs"
            >↓</span
          >
          <span class="font-black">THE CRAFT HAS BEGUN</span>
        </a>
      </div>

      <!-- Canto Inferior Direito -->
      <div
        class="flex flex-col items-start sm:items-end text-left sm:text-right max-w-full sm:max-w-[50%] lg:max-w-md shrink-0"
      >
        <p
          class="mb-2 sm:mb-4 font-display text-xs sm:text-base md:text-lg lg:text-2xl font-black leading-snug tracking-tight text-space-base text-left sm:text-right"
        >
          TURNING COMPLEX<br />
          ARCHITECTURES INTO<br />
          CINEMATIC ART
        </p>
        <div
          class="flex flex-wrap justify-start sm:justify-end gap-1.5 sm:gap-2 lg:gap-2.5"
        >
          <a
            href="https://github.com/BrunoAndradeDinis"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block rounded-full bg-space-base px-2.5 py-1 sm:px-3 sm:py-1 md:px-3.5 md:py-1.5 lg:px-4 lg:py-1.5 font-mono text-[10px] sm:text-xs md:text-xs lg:text-sm font-bold text-paper-white transition-all hover:-translate-y-0.5 hover:bg-paper-white hover:text-space-base shadow-[0_2px_0_var(--color-space-base)]"
          >
            GITHUB
          </a>
          <a
            href="https://linkedin.com/in/brunoandradedinis"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block rounded-full bg-space-base px-2.5 py-1 sm:px-3 sm:py-1 md:px-3.5 md:py-1.5 lg:px-4 lg:py-1.5 font-mono text-[10px] sm:text-xs md:text-xs lg:text-sm font-bold text-paper-white transition-all hover:-translate-y-0.5 hover:bg-paper-white hover:text-space-base shadow-[0_2px_0_var(--color-space-base)]"
          >
            LINKEDIN
          </a>
          <a
            href="mailto:bruno.andrade.dinis@gmail.com"
            class="inline-block rounded-full bg-space-base px-2.5 py-1 sm:px-3 sm:py-1 md:px-3.5 md:py-1.5 lg:px-4 lg:py-1.5 font-mono text-[10px] sm:text-xs md:text-xs lg:text-sm font-bold text-paper-white transition-all hover:-translate-y-0.5 hover:bg-paper-white hover:text-space-base shadow-[0_2px_0_var(--color-space-base)]"
          >
            E-MAIL
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
