---
import { PROFILE } from "../data/profile";
import { ptBrDict } from "../i18n/dictionaries";
import P5Panel from "./p5/P5Panel.astro";
import P5Badge from "./p5/P5Badge.astro";
---

<div
  data-hero-ticker
  class="group flex h-[4.125rem] w-full items-center overflow-hidden border-t-3 border-b-6 border-space-base bg-bebop-red select-none box-border cursor-default [clip-path:polygon(0%_0%,100%_0%,100%_62%,0%_100%)]"
  aria-hidden="true"
>
  <div
    class="inline-flex shrink-0 items-center whitespace-nowrap animate-marquee font-display text-base sm:text-xl lg:text-2xl tracking-wider text-space-base transition-colors duration-300 group-hover:text-paper-white group-hover:[animation-play-state:paused] leading-none will-change-transform"
  >
    <span class="inline-block shrink-0 whitespace-nowrap pr-12 sm:pr-16" data-i18n="hero.ticker">
      {ptBrDict.hero.ticker}
    </span>
    <span class="inline-block shrink-0 whitespace-nowrap pr-12 sm:pr-16" data-i18n="hero.ticker">
      {ptBrDict.hero.ticker}
    </span>
  </div>
</div>

<section
  class="relative flex min-h-[calc(100vh-7rem-4.125rem)] flex-col bg-bebop-red px-4 py-4 sm:px-8 sm:py-7 md:px-10 md:py-8 lg:px-20 lg:py-10"
  id="hero"
>
  <div
    class="mx-auto flex w-full max-w-[160rem] flex-1 flex-col justify-between"
  >
    <div
      class="relative my-auto flex w-full items-center justify-center py-6 sm:py-8 md:py-10 lg:py-16"
    >
      <h1
        class="flex w-full select-none flex-row flex-nowrap items-center justify-between whitespace-nowrap font-display text-[clamp(3rem,15vw,5.5rem)] sm:text-[clamp(4.5rem,13.5vw,7rem)] md:text-[clamp(6.5rem,13.5vw,9.5rem)] lg:text-[clamp(9.5rem,14vw,14rem)] font-black leading-[0.85] tracking-tight text-space-base"
        aria-label="BRINU"
      >
        <span class="inline-block shrink-0 leading-[0.85]" aria-hidden="true" data-hero-letter="B">B</span>
        <span class="inline-block shrink-0 leading-[0.85]" aria-hidden="true" data-hero-letter="R">R</span>
        <span
          class="inline-block shrink-0 leading-[0.85] mx-3.5 sm:mx-7 md:mx-11 lg:mx-16 text-center"
          aria-hidden="true"
          data-hero-letter="I"
          >I</span
        >
        <span class="inline-block shrink-0 leading-[0.85]" aria-hidden="true" data-hero-letter="N">N</span>
        <span class="inline-block shrink-0 leading-[0.85]" aria-hidden="true" data-hero-letter="U">U</span>
      </h1>

      <div
        class="absolute left-1/2 top-1/2 z-10 -translate-x-1/2 -translate-y-1/2 pointer-events-auto"
      >
        <div
          id="hero-avatar-badge"
          data-hero-avatar
          role="button"
          tabindex="0"
          aria-label={ptBrDict.hero.avatarAria}
          data-i18n="hero.avatarAria"
          data-i18n-attr="aria-label"
          aria-haspopup="true"
          aria-expanded="false"
          class="group flex flex-col items-center cursor-pointer select-none transition-transform duration-300 ease-out hover:scale-105 active:scale-95 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-space-base"
        >
          <div
            id="avatar-comic-bubble"
            class="pointer-events-none absolute -top-9 sm:-top-12 md:-top-16 left-1/2 -translate-x-1/2 opacity-0 scale-75 transition-all duration-300 ease-out z-20"
            role="status"
            aria-live="polite"
          >
            <div
              class="relative border-2 border-space-base bg-paper-white px-2.5 py-1 sm:px-3.5 sm:py-1.5 font-display text-[9px] sm:text-xs md:text-sm font-black uppercase tracking-tight text-space-base shadow-[0_3px_0_var(--color-space-base)] sm:shadow-[0_4px_0_var(--color-space-base)] whitespace-nowrap"
            >
              <span id="avatar-comic-text" data-i18n="hero.bubbleDefault">{ptBrDict.hero.bubbleDefault}</span>
              <div
                class="absolute -bottom-1.5 sm:-bottom-2 left-1/2 -translate-x-1/2 w-0 h-0 border-l-[6px] sm:border-l-[8px] border-l-transparent border-r-[6px] sm:border-r-[8px] border-r-transparent border-t-[6px] sm:border-t-[8px] border-t-space-base"
                aria-hidden="true"
              ></div>
            </div>
          </div>

          <div
            data-hero-avatar-frame
            class="relative h-[clamp(3.2rem,13vw,4.5rem)] w-[clamp(3.2rem,13vw,4.5rem)] sm:h-[clamp(5.5rem,12vw,7.5rem)] sm:w-[clamp(5.5rem,12vw,7.5rem)] md:h-[clamp(8rem,13vw,11.5rem)] md:w-[clamp(8rem,13vw,11.5rem)] lg:h-[clamp(11.5rem,14vw,15.5rem)] lg:w-[clamp(11.5rem,14vw,15.5rem)] rotate-[5deg] bg-space-base p-[0.3rem] sm:p-[0.4rem] md:p-[0.5rem] [clip-path:polygon(9%_0%,100%_7%,91%_100%,0%_93%)]"
          >
            <div
              class="relative h-full w-full overflow-hidden bg-paper-white [clip-path:polygon(9%_0%,100%_7%,91%_100%,0%_93%)]"
            >
              <img
                src="/assets/brinu-avatar.jpg"
                alt={ptBrDict.a11y.heroPortraitAlt}
                data-i18n="a11y.heroPortraitAlt"
                data-i18n-attr="alt"
                class="h-full w-full -rotate-[5deg] scale-125 object-cover contrast-125 saturate-110 transition-transform duration-500 ease-out group-hover:scale-[1.35]"
              />
              <div
                class="pointer-events-none absolute inset-0 bg-gradient-to-t from-space-base/30 via-transparent to-transparent mix-blend-multiply"
                aria-hidden="true"
              ></div>
              <div
                class="pointer-events-none absolute inset-0 bg-[radial-gradient(#080808_1px,transparent_1px)] [background-size:6px_6px] opacity-10 mix-blend-overlay"
                aria-hidden="true"
              ></div>
            </div>
          </div>

          <div
            class="relative z-10 -mt-1.5 sm:-mt-2.5 md:-mt-3.5 transition-transform duration-300 ease-out group-hover:scale-105"
          >
            <span
              id="hero-stamp-badge"
              class="inline-flex items-center gap-1.5 -rotate-3 border-2 md:border-[0.25rem] border-space-base bg-paper-white px-2 sm:px-3 md:px-4 py-0.5 sm:py-1 font-spray text-[10px] sm:text-xs md:text-sm lg:text-base font-bold whitespace-nowrap text-space-base shadow-[0_3px_0_var(--color-space-base)] transition-all duration-200 group-hover:bg-space-base group-hover:text-paper-white"
            >
              <span class="tracking-wider" data-i18n="hero.stamp">{ptBrDict.hero.stamp}</span>
              <svg
                class="size-3 sm:size-3.5 md:size-4 shrink-0 fill-bebop-red stroke-space-base stroke-2 transition-transform duration-300 group-hover:scale-125"
                aria-hidden="true"
                viewBox="0 0 24 24"
              >
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
              </svg>
            </span>
          </div>
        </div>
      </div>
    </div>

    <div
      class="mt-6 sm:mt-10 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6 sm:gap-8 pt-2 sm:pt-4"
    >
      <P5Panel
        as="div"
        cut="a"
        data-hero-manifesto="left"
        class="-rotate-1 bg-space-base px-4 py-4 sm:px-6 sm:py-5 flex flex-col items-start text-left max-w-full sm:max-w-[48%] lg:max-w-md shrink-0"
      >
        <p
          class="mb-2 sm:mb-4 font-body text-xs sm:text-base md:text-lg lg:text-2xl font-black leading-snug tracking-tight text-paper-white uppercase"
        >
          <span data-i18n="hero.manifestoLeftLine1">{ptBrDict.hero.manifestoLeftLine1}</span><br />
          <span data-i18n="hero.manifestoLeftLine2">{ptBrDict.hero.manifestoLeftLine2}</span><br />
          <span data-i18n="hero.manifestoLeftLine3">{ptBrDict.hero.manifestoLeftLine3}</span>
        </p>
        <a
          href="#works"
          class="group/craft inline-flex items-center gap-1.5 sm:gap-2.5 font-mono text-[11px] sm:text-xs md:text-xs lg:text-sm tracking-wider text-paper-white transition-opacity hover:opacity-85 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-paper-white"
          aria-label={ptBrDict.hero.craftAria}
          data-i18n="hero.craftAria"
          data-i18n-attr="aria-label"
        >
          <span
            class="inline-flex h-5 w-5 sm:h-6 sm:w-6 items-center justify-center bg-bebop-red text-space-base transition-transform duration-200 group-hover/craft:translate-y-0.5"
            aria-hidden="true"
          >
            <svg class="size-3 sm:size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </span>
          <span class="font-black" data-i18n="hero.craftCta">{ptBrDict.hero.craftCta}</span>
        </a>
      </P5Panel>

      <div class="flex flex-col items-start sm:items-end gap-4 max-w-full sm:max-w-[50%] lg:max-w-md shrink-0">
        <P5Panel
          as="div"
          cut="b"
          data-hero-manifesto="right"
          class="rotate-1 bg-paper-white px-4 py-4 sm:px-6 sm:py-5 flex flex-col items-start sm:items-end text-left sm:text-right"
        >
          <p
            class="font-body text-xs sm:text-base md:text-lg lg:text-2xl font-black leading-snug tracking-tight text-space-base text-left sm:text-right uppercase"
          >
            <span data-i18n="hero.manifestoRightLine1">{ptBrDict.hero.manifestoRightLine1}</span><br />
            <span data-i18n="hero.manifestoRightLine2">{ptBrDict.hero.manifestoRightLine2}</span><br />
            <span data-i18n="hero.manifestoRightLine3">{ptBrDict.hero.manifestoRightLine3}</span>
          </p>
        </P5Panel>
        <div
          data-hero-socials
          class="flex flex-col items-start sm:items-end gap-2"
          role="list"
          aria-label={ptBrDict.hero.socialAria}
          data-i18n="hero.socialAria"
          data-i18n-attr="aria-label"
        >
          <a
            href={PROFILE.github.url} target="_blank" rel="noopener noreferrer"
            class="group/badge focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-space-base"
            aria-label={`GitHub (${PROFILE.github.handle})`}
          >
            <P5Badge class="inline-block bg-space-base px-3 py-1.5 sm:px-4 sm:py-2 font-mono text-[10px] sm:text-xs lg:text-sm font-bold text-paper-white transition-colors duration-150 group-hover/badge:bg-paper-white group-hover/badge:text-space-base">GITHUB</P5Badge>
          </a>
          <a
            href={PROFILE.linkedin.url} target="_blank" rel="noopener noreferrer"
            class="group/badge focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-space-base"
            aria-label={`LinkedIn (${PROFILE.linkedin.handle})`}
          >
            <P5Badge class="inline-block bg-space-base px-3 py-1.5 sm:px-4 sm:py-2 font-mono text-[10px] sm:text-xs lg:text-sm font-bold text-paper-white transition-colors duration-150 group-hover/badge:bg-paper-white group-hover/badge:text-space-base">LINKEDIN</P5Badge>
          </a>
          <a
            href={`mailto:${PROFILE.email}`}
            class="group/badge focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-space-base"
            aria-label={`E-mail (${PROFILE.email})`}
          >
            <P5Badge class="inline-block bg-space-base px-3 py-1.5 sm:px-4 sm:py-2 font-mono text-[10px] sm:text-xs lg:text-sm font-bold text-paper-white transition-colors duration-150 group-hover/badge:bg-paper-white group-hover/badge:text-space-base">E-MAIL</P5Badge>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "../utils/motion";
  import { getDictionary, getLocale } from "../i18n/index";

  function setupAvatarMicrointeraction() {
    const avatarBadge = document.getElementById("hero-avatar-badge");
    const comicBubble = document.getElementById("avatar-comic-bubble");
    const comicText = document.getElementById("avatar-comic-text");
    const stampBadge = document.getElementById("hero-stamp-badge");

    if (!avatarBadge || !comicBubble || !comicText || avatarBadge.dataset.bound === "true") return;
    avatarBadge.dataset.bound = "true";

    let phraseIndex = 0;
    let dismissTimer: ReturnType<typeof setTimeout> | null = null;

    const triggerComicPop = () => {
      const phrases = getDictionary(getLocale()).hero.phrases;
      phraseIndex = (phraseIndex + 1) % phrases.length;
      comicText.textContent = phrases[phraseIndex];
      avatarBadge.setAttribute("aria-expanded", "true");

      comicBubble.classList.remove("opacity-0", "scale-75");
      comicBubble.classList.add("opacity-100", "scale-100");

      if (stampBadge) {
        stampBadge.classList.add("scale-110", "rotate-2");
        setTimeout(() => {
          stampBadge.classList.remove("scale-110", "rotate-2");
        }, 180);
      }

      if (dismissTimer) clearTimeout(dismissTimer);
      dismissTimer = setTimeout(() => {
        comicBubble.classList.remove("opacity-100", "scale-100");
        comicBubble.classList.add("opacity-0", "scale-75");
        avatarBadge.setAttribute("aria-expanded", "false");
      }, 3000);
    };

    avatarBadge.addEventListener("click", triggerComicPop);
    avatarBadge.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        triggerComicPop();
      }
    });
  }

  function setupHeroScrollTransitions() {
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (prefersReducedMotion) return;

    const heroSection = document.getElementById("hero");
    if (!heroSection) return;

    const letterB = heroSection.querySelector('[data-hero-letter="B"]');
    const letterR = heroSection.querySelector('[data-hero-letter="R"]');
    const letterI = heroSection.querySelector('[data-hero-letter="I"]');
    const letterN = heroSection.querySelector('[data-hero-letter="N"]');
    const letterU = heroSection.querySelector('[data-hero-letter="U"]');
    const avatar = heroSection.querySelector("#hero-avatar-badge");
    const manifestoLeft = heroSection.querySelector('[data-hero-manifesto="left"]');
    const manifestoRight = heroSection.querySelector('[data-hero-manifesto="right"]');

    const heroExitTl = gsap.timeline({
      scrollTrigger: {
        trigger: heroSection,
        start: "top top",
        end: "bottom 15%",
        scrub: 0.8,
        invalidateOnRefresh: true,
      },
    });

    if (letterB && letterR) {
      heroExitTl.to(
        [letterB, letterR],
        {
          x: -32,
          opacity: 0.45,
          ease: "power2.inOut",
          force3D: true,
        },
        0
      );
    }

    if (letterN && letterU) {
      heroExitTl.to(
        [letterN, letterU],
        {
          x: 32,
          opacity: 0.45,
          ease: "power2.inOut",
          force3D: true,
        },
        0
      );
    }

    if (letterI && avatar) {
      heroExitTl.to(
        letterI,
        {
          opacity: 0.35,
          scale: 0.94,
          ease: "power2.inOut",
          force3D: true,
        },
        0
      );

      heroExitTl.to(
        avatar,
        {
          y: -24,
          scale: 0.92,
          opacity: 0.65,
          ease: "power2.inOut",
          force3D: true,
        },
        0
      );
    }

    if (manifestoLeft) {
      heroExitTl.to(
        manifestoLeft,
        {
          x: -24,
          opacity: 0.3,
          ease: "power1.inOut",
          force3D: true,
        },
        0
      );
    }

    if (manifestoRight) {
      heroExitTl.to(
        manifestoRight,
        {
          x: 24,
          opacity: 0.3,
          ease: "power1.inOut",
          force3D: true,
        },
        0
      );
    }
  }

  function initComicHero() {
    setupAvatarMicrointeraction();
    setupHeroScrollTransitions();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initComicHero);
  } else {
    initComicHero();
  }
  document.addEventListener("astro:page-load", initComicHero);
</script>
