---
import { getLocalizedCases } from "../data/cases";
import { ptBrDict } from "../i18n/dictionaries";
import P5Panel from "./p5/P5Panel.astro";

const cases = getLocalizedCases("pt-br");
---

<div data-arcana-deck class="arcana-deck mx-auto max-w-[140rem]">
  <p
    class="mb-8 font-mono text-[11px] sm:text-xs font-bold tracking-widest text-muted-gray uppercase"
    data-i18n="lab.hint"
  >
    {ptBrDict.lab.hint}
  </p>

  <div data-arcana-controls class="arcana-controls mb-4 hidden items-center justify-end gap-3">
    <button
      type="button"
      data-arcana-prev
      class="border-2 border-paper-white bg-space-base px-3 py-1.5 font-mono text-sm font-black text-paper-white hover:bg-bebop-red focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-paper-white"
      aria-label={ptBrDict.lab.prevAria}
      data-i18n="lab.prevAria"
      data-i18n-attr="aria-label"
    >
      ◀
    </button>
    <button
      type="button"
      data-arcana-next
      class="border-2 border-paper-white bg-space-base px-3 py-1.5 font-mono text-sm font-black text-paper-white hover:bg-bebop-red focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-paper-white"
      aria-label={ptBrDict.lab.nextAria}
      data-i18n="lab.nextAria"
      data-i18n-attr="aria-label"
    >
      ▶
    </button>
  </div>

  <div data-arcana-viewport class="arcana-viewport">
  <ol data-arcana-track role="list" class="grid grid-cols-1 gap-8 md:grid-cols-2 xl:grid-cols-4">
    {
      cases.map((project, index) => (
        <li class="list-none">
          <P5Panel
            as="article"
            cut={index % 2 === 0 ? "a" : "b"}
            id={`arcana-${project.id}`}
            data-arcana-card
            data-arcana-index={index}
            aria-label={`${project.arcanaCode}: ${project.title}`}
            class="arcana-card relative flex h-full flex-col bg-bebop-red text-space-base"
          >
            <div data-arcana-flip class="arcana-flip flex flex-1 flex-col">
            <div data-arcana-front class="arcana-face flex flex-col gap-3 border-b-4 border-space-base bg-bebop-red p-5 sm:p-6">
              <span
                data-arcana-code
                class="font-mono text-[11px] sm:text-xs font-black tracking-widest text-space-base uppercase"
              >
                {project.arcanaCode}
              </span>
              <h3
                data-arcana-title
                class="font-display text-2xl sm:text-3xl font-black uppercase leading-[0.95] tracking-tight text-space-base [overflow-wrap:anywhere]"
              >
                {project.title}
              </h3>
              <p
                data-arcana-category
                class="font-mono text-[11px] sm:text-xs font-bold uppercase tracking-wider text-space-base"
              >
                {project.category}
              </p>
            </div>

            <div data-arcana-back class="arcana-face flex flex-1 flex-col gap-4 bg-paper-white p-5 sm:p-6 text-space-base">
              <div>
                <h4
                  class="mb-1 font-mono text-[10px] sm:text-[11px] font-black uppercase tracking-widest text-space-base"
                  data-i18n="works.challengeLabel"
                >
                  {ptBrDict.works.challengeLabel}
                </h4>
                <p data-arcana-challenge class="text-xs sm:text-sm leading-snug">{project.challenge}</p>
              </div>
              <div>
                <h4
                  class="mb-1 font-mono text-[10px] sm:text-[11px] font-black uppercase tracking-widest text-space-base"
                  data-i18n="works.solutionLabel"
                >
                  {ptBrDict.works.solutionLabel}
                </h4>
                <p data-arcana-solution class="text-xs sm:text-sm leading-snug">{project.solution}</p>
              </div>
              <ul role="list" class="flex flex-wrap gap-1.5">
                {
                  project.stack.map((tech) => (
                    <li
                      data-arcana-stack-item
                      class="border-2 border-space-base bg-paper-white px-2 py-0.5 font-mono text-[10px] sm:text-[11px] font-bold text-space-base"
                    >
                      {tech}
                    </li>
                  ))
                }
              </ul>
              <div class="mt-auto flex flex-wrap gap-2 border-t-4 border-space-base pt-4">
                {
                  project.links.map((link) => (
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      data-arcana-link
                      aria-label={link.ariaLabel}
                      class="border-2 border-space-base bg-space-base px-3 py-1.5 font-mono text-[11px] font-black uppercase tracking-wider text-paper-white hover:bg-bebop-red focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-space-base"
                    >
                      <span data-arcana-link-label>{link.label}</span>
                    </a>
                  ))
                }
                <a
                  href={`#case-${project.id}`}
                  data-arcana-open
                  class="border-2 border-space-base bg-bebop-red px-3 py-1.5 font-mono text-[11px] font-black uppercase tracking-wider text-space-base hover:bg-space-base hover:text-paper-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-space-base"
                  data-i18n="lab.openCase"
                >
                  {ptBrDict.lab.openCase}
                </a>
              </div>
            </div>
            </div>
            <button
              type="button"
              data-arcana-toggle
              aria-pressed="false"
              aria-label={`${project.arcanaCode}: ${project.title}`}
              class="arcana-toggle absolute right-3 top-3 z-30 hidden h-9 w-9 items-center justify-center border-2 border-paper-white bg-bebop-red font-mono text-base font-black text-space-base hover:bg-paper-white focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-bebop-red"
            >
              <span aria-hidden="true">↻</span>
            </button>
          </P5Panel>
        </li>
      ))
    }
  </ol>
  </div>
</div>

<style>
  .arcana-deck.is-enhanced .arcana-viewport {
    overflow: hidden;
    padding: 1.5rem 0 2.5rem;
    touch-action: pan-y;
  }

  .arcana-deck.is-enhanced [data-arcana-track] {
    display: flex;
    width: max-content;
    gap: 1.5rem;
    cursor: grab;
  }

  .arcana-deck.is-enhanced [data-arcana-track]:active {
    cursor: grabbing;
  }

  .arcana-deck.is-enhanced [data-arcana-track] > li {
    flex: 0 0 min(80vw, 22rem);
  }

  .arcana-deck.is-enhanced .arcana-controls {
    display: flex;
  }

  .arcana-deck.is-enhanced .arcana-toggle {
    display: inline-flex;
  }

  .arcana-deck.is-enhanced .arcana-card {
    height: clamp(28rem, 72vh, 34rem);
    perspective: 1400px;
    transition: transform 350ms ease, opacity 350ms ease;
  }

  .arcana-deck.is-enhanced .arcana-card:not(.is-selected) {
    transform: scale(0.9);
    opacity: 0.75;
  }

  .arcana-deck.is-enhanced .arcana-flip {
    position: relative;
    display: grid;
    flex: 1;
    min-height: 0;
    transform-style: preserve-3d;
    transition: transform 600ms cubic-bezier(0.2, 0.9, 0.2, 1);
  }

  .arcana-deck.is-enhanced .arcana-card.is-flipped .arcana-flip {
    transform: rotateY(180deg);
  }

  .arcana-deck.is-enhanced .arcana-face {
    grid-area: 1 / 1;
    min-height: 0;
    overflow-y: auto;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .arcana-deck.is-enhanced [data-arcana-front] {
    justify-content: center;
    border-bottom: 0;
  }

  .arcana-deck.is-enhanced [data-arcana-back] {
    transform: rotateY(180deg);
  }

  .arcana-deck.is-enhanced [data-arcana-front],
  .arcana-deck.is-enhanced [data-arcana-back] {
    visibility: visible;
  }

  .arcana-deck.is-enhanced [data-arcana-front][inert],
  .arcana-deck.is-enhanced [data-arcana-back][inert] {
    visibility: hidden;
    transition: visibility 0s linear 300ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .arcana-deck.is-enhanced,
    .arcana-deck.is-enhanced * {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

<script>
  import { initArcanaDeck } from "./arcana/deck";

  function boot() {
    document.querySelectorAll<HTMLElement>("[data-arcana-deck]").forEach((deck) => {
      initArcanaDeck(deck);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot);
  } else {
    boot();
  }
  document.addEventListener("astro:page-load", boot);
</script>
