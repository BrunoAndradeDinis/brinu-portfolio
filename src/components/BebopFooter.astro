---
import { PROFILE } from "../data/profile";
import { ptBrDict } from "../i18n/dictionaries";
---

<footer
  data-bebop-footer
  class="relative border-t-4 border-paper-white bg-space-base text-paper-white select-none overflow-hidden"
  aria-label={ptBrDict.footer.sectionAria}
  data-i18n="footer.sectionAria"
  data-i18n-attr="aria-label"
>
  <div
    class="ticker-tape !bg-bebop-red !text-paper-white !border-t-0 !border-b-4 !border-space-base !text-base sm:!text-lg md:!text-xl font-black"
    aria-hidden="true"
  >
    <div class="ticker-tape__track">
      <span class="px-4" data-i18n="footer.ticker">{ptBrDict.footer.ticker}</span>
      <span class="px-4" data-i18n="footer.ticker">{ptBrDict.footer.ticker}</span>
      <span class="px-4" data-i18n="footer.ticker">{ptBrDict.footer.ticker}</span>
      <span class="px-4" data-i18n="footer.ticker">{ptBrDict.footer.ticker}</span>
    </div>
  </div>

  <div class="mx-auto max-w-[140rem] px-4 py-16 sm:px-8 sm:py-24 md:px-12 md:py-28">
    <div
      data-footer-signature
      class="relative border-4 border-paper-white bg-space-surface-1 p-8 sm:p-12 md:p-16 text-center shadow-[10px_10px_0_var(--color-bebop-red)] overflow-hidden group"
    >
      <div class="relative z-10 inline-flex items-center gap-2 px-3 py-1.5 border-2 border-paper-white bg-bebop-red mb-6 sm:mb-8 font-mono text-[11px] sm:text-xs text-paper-white uppercase tracking-widest -skew-x-6">
        <span class="w-2 h-2 bg-paper-white animate-pulse"></span>
        <span data-i18n="footer.badge">{ptBrDict.footer.badge}</span>
      </div>

      <h2
        data-footer-signature-text
        data-i18n="footer.signature"
        class="relative z-10 font-display text-[clamp(2rem,6.5vw,6.8rem)] font-black tracking-tight text-paper-white uppercase leading-none"
      >
        {ptBrDict.footer.signature}
      </h2>

      <p
        class="relative z-10 mt-4 sm:mt-6 font-mono text-xs sm:text-sm md:text-base tracking-[0.2em] text-bebop-red uppercase font-bold"
        data-i18n="footer.subtitle"
      >
        {ptBrDict.footer.subtitle}
      </p>
    </div>

    <div class="mt-12 sm:mt-16 pt-8 border-t-2 border-bebop-red flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex flex-wrap items-center justify-center md:justify-start gap-3 sm:gap-4 font-mono text-xs">
        <a
          href={PROFILE.github.url}
          target="_blank"
          rel="noopener noreferrer"
          data-footer-github-link
          class="inline-flex items-center gap-2 px-5 py-3 border-2 border-paper-white bg-space-surface-1 hover:bg-bebop-red hover:text-paper-white transition-all shadow-[4px_4px_0_var(--color-bebop-red)] font-bold uppercase"
        >
          <span>GITHUB</span>
        </a>

        <a
          href={PROFILE.linkedin.url}
          target="_blank"
          rel="noopener noreferrer"
          data-footer-linkedin-link
          class="inline-flex items-center gap-2 px-5 py-3 border-2 border-paper-white bg-space-surface-1 hover:bg-bebop-red hover:text-paper-white transition-all shadow-[4px_4px_0_var(--color-bebop-red)] font-bold uppercase"
        >
          <span>LINKEDIN</span>
        </a>

        <a
          href={`mailto:${PROFILE.email}`}
          data-footer-email-link
          class="inline-flex items-center gap-2 px-5 py-3 border-2 border-paper-white bg-space-surface-1 hover:bg-bebop-red hover:text-paper-white transition-all shadow-[4px_4px_0_var(--color-bebop-red)] font-bold uppercase"
        >
          <span>E-MAIL</span>
        </a>

        <a
          href="/whoami"
          data-footer-whoami-link
          class="inline-flex items-center gap-2 px-5 py-3 border-2 border-paper-white bg-bebop-red text-paper-white hover:bg-paper-white hover:text-space-base transition-all shadow-[4px_4px_0_var(--color-paper-white)] font-bold uppercase"
        >
          <span>/WHOAMI</span>
        </a>
      </div>

      <div>
        <a
          href="#main-content"
          data-footer-back-to-top
          class="group inline-flex items-center gap-2 px-6 py-3.5 border-3 border-paper-white bg-paper-white text-space-base font-display text-xs sm:text-sm font-black uppercase tracking-wider hover:bg-bebop-red hover:text-paper-white transition-all shadow-[4px_4px_0_var(--color-bebop-red)]"
          aria-label={ptBrDict.footer.backToTopAria}
          data-i18n="footer.backToTopAria"
          data-i18n-attr="aria-label"
        >
          <span data-i18n="footer.backToTop">{ptBrDict.footer.backToTop}</span>
          <span aria-hidden="true">↑</span>
        </a>
      </div>
    </div>

    <div class="mt-10 sm:mt-12 pt-6 border-t border-paper-white/30 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-[11px] sm:text-xs text-muted-gray text-center sm:text-left">
      <div>
        <p class="font-bold text-paper-white" data-i18n="footer.copyright">
          {ptBrDict.footer.copyright}
        </p>
        <p class="mt-0.5 text-bebop-red font-bold" data-i18n="footer.engineeredIn">
          {ptBrDict.footer.engineeredIn}
        </p>
      </div>

      <div class="sm:text-right">
        <p class="text-paper-white font-bold" data-i18n="footer.stackLine">
          {ptBrDict.footer.stackLine}
        </p>
        <p class="mt-0.5 text-muted-gray" data-i18n="footer.privacyLine">
          {ptBrDict.footer.privacyLine}
        </p>
      </div>
    </div>
  </div>
</footer>
