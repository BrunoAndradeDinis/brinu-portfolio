---
import { getLocalizedCases } from "../data/cases";
import { getLocalizedArchive } from "../data/archive";
import { ptBrDict } from "../i18n/dictionaries";

const cases = getLocalizedCases("pt-br");
const archive = getLocalizedArchive("pt-br");
const track1Cases = cases.filter((c) => c.track === 1);
const track2Cases = cases.filter((c) => c.track === 2);

const variants = {
  red: {
    card: "bg-bebop-red text-space-base border-4 border-space-base shadow-[8px_8px_0_var(--color-space-base)] hover:-translate-x-1 hover:-translate-y-1 hover:shadow-[12px_12px_0_var(--color-space-base)]",
    head: "border-b-4 border-space-base",
    meta: "text-space-base",
    badge: "bg-space-base text-paper-white",
    title: "text-space-base",
    subtitle: "text-space-base/85",
    body: "text-space-base",
    block: "border-2 border-space-base bg-space-base text-paper-white",
    label1: "text-bebop-red",
    label2: "text-paper-white",
    metric: "bg-paper-white text-space-base border-2 border-space-base",
    stack: "border-2 border-space-base bg-paper-white/90 text-space-base",
    links: "border-t-4 border-space-base",
    link: "border-2 border-space-base bg-space-base text-paper-white hover:bg-paper-white hover:text-space-base",
  },
  black: {
    card: "bg-space-base text-paper-white border-4 border-paper-white shadow-[8px_8px_0_var(--color-space-base)] hover:-translate-x-1 hover:-translate-y-1 hover:shadow-[12px_12px_0_var(--color-space-base)]",
    head: "border-b-4 border-bebop-red",
    meta: "text-bebop-red",
    badge: "bg-bebop-red text-paper-white",
    title: "text-paper-white",
    subtitle: "text-bebop-red",
    body: "text-paper-white",
    block: "border-2 border-paper-white bg-space-surface-1 text-paper-white",
    label1: "text-bebop-red",
    label2: "text-paper-white",
    metric: "bg-bebop-red text-paper-white border-2 border-paper-white",
    stack: "border-2 border-paper-white text-paper-white",
    links: "border-t-4 border-bebop-red",
    link: "border-2 border-paper-white bg-bebop-red text-paper-white hover:bg-paper-white hover:text-space-base",
  },
} as const;

const tracks = [
  { id: 1, cases: track1Cases, v: variants.red },
  { id: 2, cases: track2Cases, v: variants.black },
];
---

<section
  id="works"
  class="relative border-t-4 border-space-base bg-bebop-red px-4 py-12 sm:px-8 sm:py-16 md:px-12 md:py-20 text-space-base select-none overflow-hidden"
  aria-label={ptBrDict.works.sectionAria}
  data-i18n="works.sectionAria"
  data-i18n-attr="aria-label"
>
  <div
    id="tank-jump-cut-strip"
    data-tank-strip
    class="relative -mx-4 sm:-mx-8 md:-mx-12 -mt-12 sm:-mt-16 md:-mt-20 mb-12 sm:mb-16 md:mb-20 overflow-hidden border-b-4 border-space-base bg-space-base py-3 sm:py-4"
  >
    <div class="mx-auto flex w-full max-w-[140rem] flex-wrap items-center justify-between gap-3 px-4 sm:px-8 py-1.5">
      <div class="flex items-center gap-3">
        <span
          data-jump-cut-badge
          data-i18n="works.jumpCutBadge"
          class="inline-flex items-center border-2 border-paper-white bg-bebop-red px-2.5 py-1 font-display text-[11px] sm:text-xs md:text-sm font-black uppercase tracking-wider text-paper-white -skew-x-6"
        >
          {ptBrDict.works.jumpCutBadge}
        </span>
        <span
          class="font-mono text-[10px] sm:text-xs tracking-widest text-paper-white uppercase font-bold"
          data-i18n="works.jumpCutSub"
        >
          {ptBrDict.works.jumpCutSub}
        </span>
      </div>
      <div class="flex items-center gap-3 font-mono text-[9px] sm:text-xs tracking-wider text-paper-white uppercase">
        <span class="border-2 border-paper-white px-2.5 py-0.5 font-bold text-paper-white" data-i18n="works.sessionTag">
          {ptBrDict.works.sessionTag}
        </span>
      </div>
    </div>
  </div>

  <div class="mx-auto mb-12 sm:mb-16 max-w-[140rem]">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 pb-4 border-b-4 border-space-base">
      <div>
        <span class="mb-2 block font-mono text-xs sm:text-sm font-bold tracking-widest text-space-base uppercase" data-i18n="works.actTag">
          {ptBrDict.works.actTag}
        </span>
        <h2
          data-bounty-title
          data-i18n="works.title"
          class="font-display text-[clamp(2.2rem,6vw,5rem)] font-black tracking-tight text-space-base leading-none uppercase"
        >
          {ptBrDict.works.title}
        </h2>
      </div>
      <div class="flex flex-col sm:items-end text-left sm:text-right font-mono text-xs text-space-base uppercase">
        <span class="font-black" data-i18n="works.countLabel">{ptBrDict.works.countLabel}</span>
        <span class="text-[10px] sm:text-xs tracking-wider" data-i18n="works.domainLabel">
          {ptBrDict.works.domainLabel}
        </span>
      </div>
    </div>
  </div>

  <div data-technical-grid class="relative mx-auto max-w-[140rem]">
    <div class="flex flex-col gap-10 sm:gap-12">
      {tracks.map((track) => (
        <div data-reel-track={track.id} class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-10">
          {track.cases.map((project) => (
            <article
              id={`case-${project.id}`}
              data-reel-card
              class:list={["group relative flex flex-col justify-between transition-all duration-150", track.v.card]}
            >
              <div class="relative z-10 p-6 sm:p-8">
                <div class:list={["mb-4 flex flex-wrap items-center justify-between gap-2 pb-3 font-mono text-xs font-black uppercase", track.v.head, track.v.meta]}>
                  <span data-case-reel>[ {project.reelNumber} ] // {project.category}</span>
                  <span
                    data-badge-indicator
                    data-case-badge
                    class:list={["px-2.5 py-0.5 text-[10px] sm:text-xs font-black", track.v.badge]}
                  >
                    {project.badge}
                  </span>
                </div>

                <h3
                  data-case-title
                  class:list={["font-display text-2xl sm:text-3xl font-black uppercase leading-tight tracking-tight", track.v.title]}
                >
                  {project.title}
                </h3>
                <p
                  data-case-subtitle
                  class:list={["font-mono text-xs font-bold uppercase mb-3", track.v.subtitle]}
                >
                  {project.subtitle}
                </p>
                <p
                  data-case-description
                  class:list={["font-body text-sm sm:text-base leading-relaxed mb-5", track.v.body]}
                >
                  {project.description}
                </p>

                <div class:list={["space-y-4 p-4 mb-5 font-mono text-xs leading-relaxed", track.v.block]}>
                  <div>
                    <span
                      data-i18n="works.challengeLabel"
                      class:list={["block font-black text-[11px] uppercase tracking-widest mb-1", track.v.label1]}
                    >
                      {ptBrDict.works.challengeLabel}
                    </span>
                    <p data-case-challenge class="text-[11px] sm:text-xs">{project.challenge}</p>
                  </div>
                  <div>
                    <span
                      data-i18n="works.solutionLabel"
                      class:list={["block font-black text-[11px] uppercase tracking-widest mb-1", track.v.label2]}
                    >
                      {ptBrDict.works.solutionLabel}
                    </span>
                    <p data-case-solution class="text-[11px] sm:text-xs">{project.solution}</p>
                  </div>
                </div>

                <div class:list={["mb-5 flex items-start gap-2 px-3 py-2 font-mono text-[11px] sm:text-xs font-bold", track.v.metric]}>
                  <span class="font-black shrink-0" data-i18n="works.metricLabel">{ptBrDict.works.metricLabel}</span>
                  <span data-case-metric>{project.metric}</span>
                </div>

                <div class="mb-5 flex flex-wrap gap-2 font-mono text-[10px] sm:text-xs uppercase">
                  {project.stack.map((tech) => (
                    <span data-case-stack-item class:list={["px-2.5 py-1 font-bold", track.v.stack]}>{tech}</span>
                  ))}
                </div>

                <div class:list={["flex flex-wrap items-center gap-3 pt-4", track.v.links]}>
                  {project.links.map((link) => (
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={link.ariaLabel}
                      data-case-link
                      class:list={["inline-flex items-center gap-2 px-3.5 py-1.5 font-mono text-xs font-black uppercase transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-space-base", track.v.link]}
                    >
                      <span data-case-link-label>{link.label}</span>
                      <span aria-hidden="true">↗</span>
                    </a>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      ))}
    </div>

    <div data-archive class="mt-16 sm:mt-20 pt-10 border-t-4 border-space-base">
      <span class="mb-2 block font-mono text-xs sm:text-sm font-bold tracking-widest text-space-base uppercase" data-i18n="works.archiveTag">
        {ptBrDict.works.archiveTag}
      </span>
      <h3 class="mb-8 font-display text-[clamp(1.8rem,4vw,3rem)] font-black tracking-tight text-space-base leading-none uppercase" data-i18n="works.archiveTitle">
        {ptBrDict.works.archiveTitle}
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5 sm:gap-6">
        {archive.map((entry) => (
          <article
            id={`archive-${entry.id}`}
            data-archive-card
            class="flex flex-col justify-between gap-4 border-4 border-space-base bg-space-base p-5 text-paper-white shadow-[6px_6px_0_var(--color-space-base)]"
          >
            <div>
              <div class="mb-2 flex flex-wrap items-start justify-between gap-2">
                <h4 data-archive-title class="font-display text-lg sm:text-xl font-black uppercase leading-tight">{entry.title}</h4>
                {entry.status && (
                  <span data-archive-status class="shrink-0 bg-bebop-red px-2 py-0.5 font-mono text-[10px] font-black uppercase text-paper-white">
                    {entry.status}
                  </span>
                )}
              </div>
              <p data-archive-description class="font-body text-sm leading-relaxed text-paper-white/90">{entry.description}</p>
            </div>
            <div class="flex flex-wrap gap-1.5 font-mono text-[10px] uppercase">
              {entry.stack.map((tech) => (
                <span data-archive-stack-item class="border border-paper-white px-2 py-0.5 font-bold">{tech}</span>
              ))}
            </div>
            <div class="flex flex-wrap gap-2 border-t-2 border-bebop-red pt-3">
              {entry.links.map((link) => (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-archive-link={link.type}
                  class="inline-flex items-center gap-1.5 border-2 border-paper-white px-2.5 py-1 font-mono text-[11px] font-black uppercase transition-colors duration-150 hover:bg-paper-white hover:text-space-base focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-paper-white"
                >
                  <span data-archive-link-label>{link.label}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "../utils/motion";

  let isWorksInitialized = false;

  function setupSelectedWorksScroll() {
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (prefersReducedMotion) return;
    if (isWorksInitialized) return;
    isWorksInitialized = true;

    const worksSection = document.getElementById("works");
    const cards = document.querySelectorAll("[data-reel-card]");
    const jumpCutBadge = document.querySelector("[data-jump-cut-badge]");
    const tankStrip = document.querySelector("[data-tank-strip]");

    if (worksSection && cards.length > 0) {
      if (tankStrip && jumpCutBadge) {
        gsap.fromTo(
          jumpCutBadge,
          { scale: 0.88, opacity: 0.7 },
          {
            scrollTrigger: {
              trigger: tankStrip,
              start: "top 90%",
              end: "top 50%",
              scrub: 0.6,
            },
            scale: 1,
            opacity: 1,
            ease: "power3.out",
            force3D: true,
          }
        );
      }

      gsap.fromTo(
        cards,
        { y: 35, opacity: 0 },
        {
          scrollTrigger: {
            trigger: worksSection,
            start: "top 80%",
            once: true,
          },
          y: 0,
          opacity: 1,
          duration: 0.8,
          stagger: 0.15,
          ease: "power2.out",
          force3D: true,
        }
      );
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupSelectedWorksScroll);
  } else {
    setupSelectedWorksScroll();
  }
  document.addEventListener("astro:page-load", () => {
    isWorksInitialized = false;
    setupSelectedWorksScroll();
  });
</script>
