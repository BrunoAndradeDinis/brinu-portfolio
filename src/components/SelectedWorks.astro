---
/**
 * SelectedWorks.astro
 * Seção de Projetos Selecionados & Bounty Archive.
 * Linguagem Neo-Brutalista: vermelho absoluto, preto puro, linhas sólidas,
 * cantos retos e tipografia crua. Cartões como fichas de arquivo impressas.
 */
import { PROJECT_CASES } from "../data/cases";

const track1Cases = PROJECT_CASES.filter((c) => c.track === 1);
const track2Cases = PROJECT_CASES.filter((c) => c.track === 2);

// Classes completas (necessário para o scanner do Tailwind)
const variants = {
  red: {
    card: "bg-bebop-red text-black border-4 border-black shadow-[8px_8px_0_#000] hover:-translate-x-1 hover:-translate-y-1 hover:shadow-[12px_12px_0_#000]",
    head: "border-b-4 border-black",
    meta: "text-black",
    badge: "bg-black text-bebop-amber",
    title: "text-black",
    subtitle: "text-black/80",
    body: "text-black",
    block: "border-2 border-black bg-black text-paper-white",
    label1: "text-bebop-amber",
    label2: "text-acid-green",
    metric: "bg-bebop-amber text-black border-2 border-black",
    stack: "border-2 border-black text-black",
    links: "border-t-4 border-black",
    link: "border-2 border-black bg-black text-paper-white hover:bg-paper-white hover:text-black",
  },
  black: {
    card: "bg-black text-paper-white border-4 border-black shadow-[8px_8px_0_#000] hover:-translate-x-1 hover:-translate-y-1 hover:shadow-[12px_12px_0_#000]",
    head: "border-b-4 border-bebop-red",
    meta: "text-bebop-red",
    badge: "bg-bebop-red text-black",
    title: "text-bebop-red",
    subtitle: "text-bebop-amber",
    body: "text-paper-white",
    block: "border-2 border-bebop-red bg-black text-paper-white",
    label1: "text-bebop-amber",
    label2: "text-acid-green",
    metric: "bg-bebop-red text-black border-2 border-bebop-red",
    stack: "border-2 border-bebop-red text-bebop-red",
    links: "border-t-4 border-bebop-red",
    link: "border-2 border-bebop-red bg-bebop-red text-black hover:bg-bebop-amber hover:border-bebop-amber",
  },
} as const;

const tracks = [
  { id: 1, cases: track1Cases, v: variants.red },
  { id: 2, cases: track2Cases, v: variants.black },
];
---

<section
  id="works"
  class="relative border-t-4 border-black bg-bebop-red px-4 py-12 sm:px-8 sm:py-16 md:px-12 md:py-20 text-black select-none overflow-hidden"
  aria-label="Bounty Archive: Projetos Autorais de Bruno Dinis"
>
  <!-- Fita técnica preta (jump cut) -->
  <div
    id="tank-jump-cut-strip"
    data-tank-strip
    class="relative -mx-4 sm:-mx-8 md:-mx-12 -mt-12 sm:-mt-16 md:-mt-20 mb-12 sm:mb-16 md:mb-20 overflow-hidden border-b-4 border-black bg-black py-3 sm:py-4"
  >
    <div class="flex w-full items-center justify-between gap-2 overflow-hidden px-2" aria-hidden="true">
      {Array.from({ length: 28 }).map(() => (
        <span class="inline-block h-2 sm:h-2.5 w-3.5 sm:w-5 shrink-0 bg-bebop-red" />
      ))}
    </div>

    <div class="mx-auto flex w-full max-w-[140rem] flex-wrap items-center justify-between gap-3 px-4 sm:px-8 py-2.5 sm:py-3.5">
      <div class="flex items-center gap-3">
        <span
          data-jump-cut-badge
          class="inline-flex items-center border-2 border-bebop-red bg-bebop-red px-2.5 py-1 font-display text-[11px] sm:text-xs md:text-sm font-black uppercase tracking-wider text-black"
        >
          3, 2, 1 LET'S JAM
        </span>
        <span class="font-mono text-[10px] sm:text-xs tracking-widest text-bebop-amber uppercase font-bold">
          // CUT: 02 :: 35MM REEL ARCHIVE
        </span>
      </div>
      <div class="flex items-center gap-3 font-mono text-[9px] sm:text-xs tracking-wider text-paper-white uppercase">
        <span class="hidden md:inline">[ FRAMERATE: 60 FPS ]</span>
        <span class="border-2 border-acid-green px-2.5 py-0.5 font-bold text-acid-green">[ SESSION #01 ]</span>
      </div>
    </div>

    <div class="flex w-full items-center justify-between gap-2 overflow-hidden px-2" aria-hidden="true">
      {Array.from({ length: 28 }).map(() => (
        <span class="inline-block h-2 sm:h-2.5 w-3.5 sm:w-5 shrink-0 bg-bebop-red" />
      ))}
    </div>
  </div>

  <!-- Cabeçalho editorial -->
  <div class="mx-auto mb-12 sm:mb-16 max-w-[140rem]">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 pb-4 border-b-4 border-black">
      <div>
        <span class="mb-2 block font-mono text-xs sm:text-sm font-bold tracking-widest text-black uppercase">
          [ ACT I // 35MM FILM REEL :: BOUNTY ARCHIVE ]
        </span>
        <h2
          data-bounty-title
          class="font-display text-[clamp(2.2rem,6vw,5rem)] font-black tracking-tight text-black leading-none uppercase"
        >
          BOUNTY ARCHIVE
        </h2>
      </div>
      <div class="flex flex-col sm:items-end text-left sm:text-right font-mono text-xs text-black uppercase">
        <span class="font-black">SELECTED WORKS // 4 CASES</span>
        <span class="text-[10px] sm:text-xs tracking-wider">
          MAGALU CLOUD :: DISTRIBUTED SYSTEMS :: CREATIVE FRONTEND
        </span>
      </div>
    </div>
  </div>

  <!-- Grid de arquivo técnico -->
  <div data-technical-grid class="relative mx-auto max-w-[140rem]">
    <div
      class="mb-8 flex items-center justify-between border-b-2 border-black pb-3 font-mono text-[9px] sm:text-xs font-bold text-black uppercase"
      aria-hidden="true"
    >
      <span>:: GRID: 2-COL TECHNICAL ARCHIVE</span>
      <span>COORD: 35.6895 // SECTOR: WORKS</span>
    </div>

    <div class="flex flex-col gap-10 sm:gap-12">
      {tracks.map((track) => (
        <div data-reel-track={track.id} class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-10">
          {track.cases.map((project) => (
            <article
              id={`case-${project.id}`}
              data-reel-card
              class:list={["group relative flex flex-col justify-between rounded-none transition-all duration-150", track.v.card]}
            >
              <div class="relative z-10 p-6 sm:p-8">
                <div class:list={["mb-4 flex flex-wrap items-center justify-between gap-2 pb-3 font-mono text-xs font-black uppercase", track.v.head, track.v.meta]}>
                  <span>[ {project.reelNumber} ] // {project.category}</span>
                  <span
                    data-badge-indicator
                    class:list={["rounded-none px-2.5 py-0.5 text-[10px] sm:text-xs font-black", track.v.badge]}
                  >
                    {project.badge}
                  </span>
                </div>

                <h3 class:list={["font-display text-2xl sm:text-3xl font-black uppercase leading-tight tracking-tight", track.v.title]}>
                  {project.title}
                </h3>
                <p class:list={["font-mono text-xs font-bold uppercase mb-3", track.v.subtitle]}>
                  {project.subtitle}
                </p>
                <p class:list={["font-body text-sm sm:text-base leading-relaxed mb-5", track.v.body]}>
                  {project.description}
                </p>

                <div class:list={["space-y-4 p-4 mb-5 font-mono text-xs leading-relaxed", track.v.block]}>
                  <div>
                    <span class:list={["block font-black text-[11px] uppercase tracking-widest mb-1", track.v.label1]}>
                      // DESAFIO TÉCNICO
                    </span>
                    <p class="text-[11px] sm:text-xs">{project.challenge}</p>
                  </div>
                  <div>
                    <span class:list={["block font-black text-[11px] uppercase tracking-widest mb-1", track.v.label2]}>
                      :: SOLUÇÃO ARQUITETURAL
                    </span>
                    <p class="text-[11px] sm:text-xs">{project.solution}</p>
                  </div>
                </div>

                <div class:list={["mb-5 flex items-start gap-2 px-3 py-2 font-mono text-[11px] sm:text-xs font-bold", track.v.metric]}>
                  <span class="font-black shrink-0">[ METRIC ]</span>
                  <span>{project.metric}</span>
                </div>

                <div class="mb-5 flex flex-wrap gap-2 font-mono text-[10px] sm:text-xs uppercase">
                  {project.stack.map((tech) => (
                    <span class:list={["rounded-none px-2.5 py-1 font-bold", track.v.stack]}>{tech}</span>
                  ))}
                </div>

                <div class:list={["flex flex-wrap items-center gap-3 pt-4", track.v.links]}>
                  {project.links.map((link) => (
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={link.ariaLabel}
                      class:list={["inline-flex items-center gap-2 rounded-none px-3.5 py-1.5 font-mono text-xs font-black uppercase transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-black", track.v.link]}
                    >
                      <span>{link.label}</span>
                      <span aria-hidden="true">↗</span>
                    </a>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from "../utils/motion";

  let isWorksInitialized = false;

  function setupSelectedWorksScroll() {
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (prefersReducedMotion) return;
    if (isWorksInitialized) return;
    isWorksInitialized = true;

    const worksSection = document.getElementById("works");
    const track1 = document.querySelector('[data-reel-track="1"]');
    const track2 = document.querySelector('[data-reel-track="2"]');
    const cards = document.querySelectorAll("[data-reel-card]");
    const jumpCutBadge = document.querySelector("[data-jump-cut-badge]");
    const tankStrip = document.querySelector("[data-tank-strip]");

    if (worksSection && cards.length > 0) {
      // Efeito de corte seco Tank! no banner analógico
      if (tankStrip && jumpCutBadge) {
        gsap.fromTo(
          jumpCutBadge,
          { scale: 0.88, opacity: 0.7 },
          {
            scrollTrigger: {
              trigger: tankStrip,
              start: "top 90%",
              end: "top 50%",
              scrub: 0.6,
            },
            scale: 1,
            opacity: 1,
            ease: "power3.out",
            force3D: true,
          }
        );
      }

      // Revelação em cascata dos cards com ScrollTrigger
      gsap.fromTo(
        cards,
        { y: 35, opacity: 0 },
        {
          scrollTrigger: {
            trigger: worksSection,
            start: "top 80%",
            once: true,
          },
          y: 0,
          opacity: 1,
          duration: 0.8,
          stagger: 0.15,
          ease: "power2.out",
          force3D: true,
        }
      );

      // Parallax sutil oposto nas tiras de película simulando celuloide 35mm
      if (track1 && track2) {
        gsap.to(track1, {
          scrollTrigger: {
            trigger: worksSection,
            start: "top bottom",
            end: "bottom top",
            scrub: 1.2,
          },
          x: -25,
          ease: "none",
          force3D: true,
        });

        gsap.to(track2, {
          scrollTrigger: {
            trigger: worksSection,
            start: "top bottom",
            end: "bottom top",
            scrub: 1.2,
          },
          x: 25,
          ease: "none",
          force3D: true,
        });
      }
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupSelectedWorksScroll);
  } else {
    setupSelectedWorksScroll();
  }
  document.addEventListener("astro:page-load", () => {
    isWorksInitialized = false;
    setupSelectedWorksScroll();
  });
</script>

<style>
  @keyframes scanline-sweep {
    0% {
      transform: translateY(-100%);
    }
    100% {
      transform: translateY(200%);
    }
  }

  .group:hover .distortion-scanline {
    animation: scanline-sweep 1.2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .distortion-scanline {
      animation: none !important;
      display: none !important;
    }
  }
</style>
