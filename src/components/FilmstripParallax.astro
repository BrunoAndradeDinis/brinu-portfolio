---
import { ptBrDict, enDict } from "../i18n/dictionaries";

interface FilmSlide {
  id: string;
  reel: string;
  titleKey: string;
  titleDefault: string;
  bgColor: string;
  imgSrc: string;
  alt: string;
}

interface NarrativeToken {
  text: string;
  badgeClass?: string;
  badgeInnerClass?: string;
}

const FILM_SLIDES: FilmSlide[] = [
  {
    id: "slide-aurastream",
    reel: "FRAME 01 // AURASTREAM 24/7",
    titleKey: "filmstrip.slides.s1Title",
    titleDefault: ptBrDict.filmstrip.slides.s1Title,
    bgColor: "#FE0000",
    imgSrc: "/assets/filmstrip/slide-1.svg",
    alt: "Storyboard Frame 01: AuraStream 24/7 Cloud Engine com FFmpeg, Xvfb e S3",
  },
  {
    id: "slide-quake-parser",
    reel: "FRAME 02 // QUAKE TELEMETRY",
    titleKey: "filmstrip.slides.s2Title",
    titleDefault: ptBrDict.filmstrip.slides.s2Title,
    bgColor: "#080808",
    imgSrc: "/assets/filmstrip/slide-2.svg",
    alt: "Storyboard Frame 02: Quake Log Parser API com cobertura 100% Jest e Docker",
  },
  {
    id: "slide-jokenpo-franky",
    reel: "FRAME 03 // ARENA FRANKY",
    titleKey: "filmstrip.slides.s3Title",
    titleDefault: ptBrDict.filmstrip.slides.s3Title,
    bgColor: "#FE0000",
    imgSrc: "/assets/filmstrip/slide-3.svg",
    alt: "Storyboard Frame 03: Jokenpo Arena Franky Gamified State Machine",
  },
  {
    id: "slide-the-warriors",
    reel: "FRAME 04 // THE WARRIORS",
    titleKey: "filmstrip.slides.s4Title",
    titleDefault: ptBrDict.filmstrip.slides.s4Title,
    bgColor: "#080808",
    imgSrc: "/assets/filmstrip/slide-4.svg",
    alt: "Storyboard Frame 04: The Warriors Design Editorial Noir e Pipeline Gulp",
  },
  {
    id: "slide-cloud-infra",
    reel: "FRAME 05 // CLOUD INFRA",
    titleKey: "filmstrip.slides.s5Title",
    titleDefault: ptBrDict.filmstrip.slides.s5Title,
    bgColor: "#FE0000",
    imgSrc: "/assets/filmstrip/slide-5.svg",
    alt: "Storyboard Frame 05: Arquitetura de Sistemas Distribuídos e Cloud Computing",
  },
  {
    id: "slide-space-cowboy",
    reel: "FRAME 06 // SPACE COWBOY",
    titleKey: "filmstrip.slides.s6Title",
    titleDefault: ptBrDict.filmstrip.slides.s6Title,
    bgColor: "#080808",
    imgSrc: "/assets/filmstrip/slide-6.svg",
    alt: "Storyboard Frame 06: Space Cowboy Creative Technologist e Helena's Dad",
  },
];

const NARRATIVE_CONFIG: Record<string, NarrativeToken[][]> = {
  "pt-br": [
    [{ text: ptBrDict.filmstrip.p1 }],
    [{ text: ptBrDict.filmstrip.p2 }],
    [
      { text: ptBrDict.filmstrip.p3Part1 },
      {
        text: ptBrDict.filmstrip.p3Highlight1,
        badgeClass: "inline-block border-2 sm:border-3 border-space-base bg-space-base px-2 sm:px-3 py-0.5 text-paper-white -skew-x-6 shadow-[3px_3px_0_var(--color-paper-white)] align-baseline my-1",
        badgeInnerClass: "inline-block skew-x-6",
      },
      { text: ptBrDict.filmstrip.p3Part2 },
      {
        text: ptBrDict.filmstrip.p3Highlight2,
        badgeClass: "inline-block border-2 sm:border-3 border-space-base bg-paper-white px-2 sm:px-3 py-0.5 text-space-base skew-x-3 shadow-[3px_3px_0_var(--color-space-base)] align-baseline my-1",
        badgeInnerClass: "inline-block -skew-x-3",
      },
      { text: ptBrDict.filmstrip.p3Part3 },
      {
        text: ptBrDict.filmstrip.p3Highlight3,
        badgeClass: "inline-block border-2 sm:border-3 border-space-base bg-space-base px-2 sm:px-3 py-0.5 text-bebop-red -skew-x-6 shadow-[3px_3px_0_var(--color-paper-white)] align-baseline my-1",
        badgeInnerClass: "inline-block skew-x-6",
      },
      { text: ptBrDict.filmstrip.p3Part4 },
    ],
  ],
  en: [
    [{ text: enDict.filmstrip.p1 }],
    [{ text: enDict.filmstrip.p2 }],
    [
      { text: enDict.filmstrip.p3Part1 },
      {
        text: enDict.filmstrip.p3Highlight1,
        badgeClass: "inline-block border-2 sm:border-3 border-space-base bg-space-base px-2 sm:px-3 py-0.5 text-paper-white -skew-x-6 shadow-[3px_3px_0_var(--color-paper-white)] align-baseline my-1",
        badgeInnerClass: "inline-block skew-x-6",
      },
      { text: enDict.filmstrip.p3Part2 },
      {
        text: enDict.filmstrip.p3Highlight2,
        badgeClass: "inline-block border-2 sm:border-3 border-space-base bg-paper-white px-2 sm:px-3 py-0.5 text-space-base skew-x-3 shadow-[3px_3px_0_var(--color-space-base)] align-baseline my-1",
        badgeInnerClass: "inline-block -skew-x-3",
      },
      { text: enDict.filmstrip.p3Part3 },
      {
        text: enDict.filmstrip.p3Highlight3,
        badgeClass: "inline-block border-2 sm:border-3 border-space-base bg-space-base px-2 sm:px-3 py-0.5 text-bebop-red -skew-x-6 shadow-[3px_3px_0_var(--color-paper-white)] align-baseline my-1",
        badgeInnerClass: "inline-block skew-x-6",
      },
      { text: enDict.filmstrip.p3Part4 },
    ],
  ],
};

function splitWords(text: string): string[] {
  return text.trim().split(/\s+/).filter(Boolean);
}
---

<section
  id="filmstrip-motto"
  data-filmstrip-section
  aria-label={ptBrDict.filmstrip.sectionAria}
  data-i18n="filmstrip.sectionAria"
  data-i18n-attr="aria-label"
  class="motto relative z-[3] overflow-hidden border-t-4 border-space-base bg-bebop-red text-space-base select-none"
>
  <div class="relative overflow-hidden pt-10 sm:pt-14">
    <div class="mx-auto max-w-[140rem] px-4 text-center">
      <span
        class="mb-2 inline-block border-2 border-space-base bg-space-base px-3 py-0.5 font-mono text-[10px] sm:text-xs font-bold tracking-widest text-paper-white uppercase"
        data-i18n="filmstrip.tag"
      >
        {ptBrDict.filmstrip.tag}
      </span>
      <h2
        class="title-xxl font-display text-[clamp(1.75rem,5.2vw,4.75rem)] font-black uppercase leading-[0.95] tracking-tight text-space-base mx-auto max-w-[90rem]"
        data-i18n="filmstrip.heading"
      >
        {ptBrDict.filmstrip.heading}
      </h2>
    </div>
  </div>

  <div class="overflow-hidden pt-14 pb-16 sm:pt-24 sm:pb-24">
    <div data-film-wrapper class="relative z-[2] rotate-[2.5deg] scale-[1.2] origin-center">
      <div class="flex pl-[100vw]">
        <div
          data-filmstrip-parallax
          class="parallax relative flex items-stretch"
          style="--x: 0px; --progress: 0;"
        >
          <div class="relative flex shrink-0 self-stretch bg-space-base py-3 sm:py-5">
            <figure class="media relative media-fit mx-2 sm:mx-3.5 w-[1rem] sm:w-[1.25rem] self-stretch overflow-hidden">
              <img
                src="/film-strip-border.svg"
                alt=""
                decoding="async"
                draggable="false"
                class="media__image is-loaded absolute inset-0 h-full w-full object-contain"
              />
            </figure>
          </div>

          {FILM_SLIDES.map((slide) => (
            <div
              data-film-slide
              class="relative shrink-0 bg-space-base py-3 pr-3 sm:py-5 sm:pr-5"
            >
              <figure
                class="media relative media-fill min-w-[18rem] max-w-[18rem] sm:min-w-[28rem] sm:max-w-[28rem] lg:min-w-[36rem] lg:max-w-[36rem] overflow-hidden border-2 border-paper-white"
              >
                <div class="pt-[62%]"></div>
                <div
                  class="absolute inset-0"
                  style={`background-color: ${slide.bgColor};`}
                ></div>
                <img
                  src={slide.imgSrc}
                  alt={slide.alt}
                  decoding="async"
                  draggable="false"
                  class="media__image is-loaded absolute inset-0 h-full w-full object-cover"
                />
                <figcaption class="pointer-events-none absolute top-2.5 left-2.5 z-10 flex items-center gap-1.5 border-2 border-paper-white bg-space-base/95 px-2.5 py-1 font-mono text-[9px] sm:text-[11px] font-bold tracking-wider text-paper-white uppercase">
                  <span class="inline-block h-1.5 w-1.5 bg-bebop-red"></span>
                  <span>{slide.reel}</span>
                  <span class="hidden sm:inline text-muted-gray">::</span>
                  <span class="hidden sm:inline" data-i18n={slide.titleKey}>{slide.titleDefault}</span>
                </figcaption>
              </figure>
            </div>
          ))}

          <div class="relative -ml-2 sm:-ml-3.5 flex shrink-0 self-stretch bg-space-base py-3 sm:py-5">
            <figure class="media relative media-fit mx-2 sm:mx-3.5 w-[1rem] sm:w-[1.25rem] self-stretch overflow-hidden">
              <img
                src="/film-strip-border.svg"
                alt=""
                decoding="async"
                draggable="false"
                class="media__image is-loaded absolute inset-0 h-full w-full object-contain"
              />
            </figure>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="py-12 sm:py-24 px-4 sm:px-8">
    <div class="site-max --s mx-auto flex max-w-[90rem] flex-col items-center">
      <div
        data-motto-text
        class="motto__text title-m w-full max-w-[82rem] text-center font-body text-[clamp(1.5rem,3.6vw,3.5rem)] font-black leading-[1.08] tracking-tight text-space-base uppercase"
      >
        {NARRATIVE_CONFIG["pt-br"].map((paragraphTokens) => (
          <p>
            {paragraphTokens.map((token) => {
              const words = splitWords(token.text);
              if (token.badgeClass) {
                return (
                  <>
                    <span class={token.badgeClass}>
                      <span class={token.badgeInnerClass || "inline-block"}>
                        {words.map((word, wIdx) => (
                          <>
                            <span class="motto__word" style="position:relative;display:inline-block;">
                              {Array.from(word).map((ch) => (
                                <span
                                  class="char char-flip"
                                  data-char-flip
                                  style="position: relative; display: inline-block; transform: rotateX(90deg);"
                                >{ch}</span>
                              ))}
                            </span>
                            {wIdx < words.length - 1 ? " " : ""}
                          </>
                        ))}
                      </span>
                    </span>{" "}
                  </>
                );
              }
              return words.map((word) => (
                <>
                  <span class="motto__word" style="position:relative;display:inline-block;">
                    {Array.from(word).map((ch) => (
                      <span
                        class="char char-flip"
                        data-char-flip
                        style="position: relative; display: inline-block; transform: rotateX(90deg);"
                      >{ch}</span>
                    ))}
                  </span>{" "}
                </>
              ));
            })}
          </p>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger } from "../utils/motion";
  import { LOCALE_CHANGE_EVENT, type Locale, getLocale } from "../i18n";
  import { ptBrDict, enDict } from "../i18n/dictionaries";

  interface NarrativeToken {
    text: string;
    badgeClass?: string;
    badgeInnerClass?: string;
  }

  const NARRATIVE_CONFIG: Record<string, NarrativeToken[][]> = {
    "pt-br": [
      [{ text: ptBrDict.filmstrip.p1 }],
      [{ text: ptBrDict.filmstrip.p2 }],
      [
        { text: ptBrDict.filmstrip.p3Part1 },
        {
          text: ptBrDict.filmstrip.p3Highlight1,
          badgeClass: "inline-block border-2 sm:border-3 border-space-base bg-space-base px-2 sm:px-3 py-0.5 text-paper-white -skew-x-6 shadow-[3px_3px_0_var(--color-paper-white)] align-baseline my-1",
          badgeInnerClass: "inline-block skew-x-6",
        },
        { text: ptBrDict.filmstrip.p3Part2 },
        {
          text: ptBrDict.filmstrip.p3Highlight2,
          badgeClass: "inline-block border-2 sm:border-3 border-space-base bg-paper-white px-2 sm:px-3 py-0.5 text-space-base skew-x-3 shadow-[3px_3px_0_var(--color-space-base)] align-baseline my-1",
          badgeInnerClass: "inline-block -skew-x-3",
        },
        { text: ptBrDict.filmstrip.p3Part3 },
        {
          text: ptBrDict.filmstrip.p3Highlight3,
          badgeClass: "inline-block border-2 sm:border-3 border-space-base bg-space-base px-2 sm:px-3 py-0.5 text-bebop-red -skew-x-6 shadow-[3px_3px_0_var(--color-paper-white)] align-baseline my-1",
          badgeInnerClass: "inline-block skew-x-6",
        },
        { text: ptBrDict.filmstrip.p3Part4 },
      ],
    ],
    en: [
      [{ text: enDict.filmstrip.p1 }],
      [{ text: enDict.filmstrip.p2 }],
      [
        { text: enDict.filmstrip.p3Part1 },
        {
          text: enDict.filmstrip.p3Highlight1,
          badgeClass: "inline-block border-2 sm:border-3 border-space-base bg-space-base px-2 sm:px-3 py-0.5 text-paper-white -skew-x-6 shadow-[3px_3px_0_var(--color-paper-white)] align-baseline my-1",
          badgeInnerClass: "inline-block skew-x-6",
        },
        { text: enDict.filmstrip.p3Part2 },
        {
          text: enDict.filmstrip.p3Highlight2,
          badgeClass: "inline-block border-2 sm:border-3 border-space-base bg-paper-white px-2 sm:px-3 py-0.5 text-space-base skew-x-3 shadow-[3px_3px_0_var(--color-space-base)] align-baseline my-1",
          badgeInnerClass: "inline-block -skew-x-3",
        },
        { text: enDict.filmstrip.p3Part3 },
        {
          text: enDict.filmstrip.p3Highlight3,
          badgeClass: "inline-block border-2 sm:border-3 border-space-base bg-space-base px-2 sm:px-3 py-0.5 text-bebop-red -skew-x-6 shadow-[3px_3px_0_var(--color-paper-white)] align-baseline my-1",
          badgeInnerClass: "inline-block skew-x-6",
        },
        { text: enDict.filmstrip.p3Part4 },
      ],
    ],
  };

  function buildMottoHTML(tokensByParagraph: NarrativeToken[][]): string {
    return tokensByParagraph.map((tokens) => {
      const paragraphContent = tokens.map((token) => {
        const words = token.text.trim().split(/\s+/).filter(Boolean);
        const wordsHtml = words.map((word, wIdx) => {
          const charsHtml = Array.from(word).map((ch) =>
            `<span class="char char-flip" data-char-flip style="position: relative; display: inline-block; transform: rotateX(90deg);">${ch}</span>`
          ).join("");
          const space = wIdx < words.length - 1 ? " " : "";
          return `<span class="motto__word" style="position:relative;display:inline-block;">${charsHtml}</span>${space}`;
        }).join("");

        if (token.badgeClass) {
          return `<span class="${token.badgeClass}"><span class="${token.badgeInnerClass || 'inline-block'}">${wordsHtml}</span></span> `;
        }
        return `${wordsHtml} `;
      }).join("");

      return `<p>${paragraphContent}</p>`;
    }).join("");
  }

  let cleanupFilmstrip: (() => void) | null = null;

  function initFilmstripParallax() {
    if (cleanupFilmstrip) {
      cleanupFilmstrip();
      cleanupFilmstrip = null;
    }

    const mottoSection = document.querySelector<HTMLElement>("[data-filmstrip-section]");
    const parallaxEl = document.querySelector<HTMLElement>("[data-filmstrip-parallax]");
    const mottoText = document.querySelector<HTMLElement>("[data-motto-text]");

    if (!mottoSection || !parallaxEl || !mottoText) return;

    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const updateParallaxBounds = () => {
      const slides = parallaxEl.querySelectorAll<HTMLElement>("[data-film-slide]");
      const lastSlide = slides[slides.length - 1];
      if (!lastSlide) return;

      parallaxEl.style.setProperty("--x", "0px");

      const rect = lastSlide.getBoundingClientRect();
      const windowWidth = window.innerWidth;
      const scaleFactor = lastSlide.offsetWidth > 0 ? rect.width / lastSlide.offsetWidth : 1;
      const travelDistance = -(rect.right - windowWidth) / scaleFactor;

      parallaxEl.style.setProperty("--x", `${travelDistance}px`);
      requestAnimationFrame(() => {
        parallaxEl.style.setProperty("--x", `${travelDistance}px`);
      });
    };

    updateParallaxBounds();

    if (prefersReducedMotion) {
      parallaxEl.style.setProperty("--progress", "0.25");
      mottoSection.classList.add("is-active");
      const chars = Array.from(mottoText.querySelectorAll<HTMLElement>(".char-flip"));
      chars.forEach((ch) => {
        ch.style.transform = "rotateX(0deg)";
        ch.style.opacity = "1";
      });
      return;
    }

    const parallaxTween = gsap.fromTo(
      parallaxEl,
      { "--progress": 0 },
      {
        "--progress": 1,
        ease: "none",
        scrollTrigger: {
          trigger: parallaxEl,
          start: "top 85%",
          end: "bottom 15%",
          scrub: 0.25,
          invalidateOnRefresh: true,
        },
      }
    );

    let textTween: gsap.core.Tween | null = null;
    let textTrigger: ScrollTrigger | null = null;
    let maxProgress = 0;

    const setupTextTween = () => {
      if (textTrigger) {
        textTrigger.kill();
        textTrigger = null;
      }
      if (textTween) {
        textTween.kill();
        textTween = null;
      }

      const chars = Array.from(mottoText.querySelectorAll<HTMLElement>(".char-flip"));

      textTween = gsap.fromTo(
        chars,
        {
          rotateX: 90,
        },
        {
          rotateX: 0,
          duration: 0.03,
          stagger: 0.03,
          ease: "none",
          paused: true,
        }
      );

      textTrigger = ScrollTrigger.create({
        trigger: mottoText,
        start: "top 82%",
        end: "bottom 35%",
        scrub: 0.25,
        onUpdate: (self) => {
          if (self.progress > maxProgress) {
            maxProgress = self.progress;
            textTween?.progress(maxProgress);
          }
          if (maxProgress >= 0.95) {
            mottoSection.classList.add("is-active");
          }
        },
        onLeave: () => {
          maxProgress = 1;
          textTween?.progress(1);
          mottoSection.classList.add("is-active");
        },
      });

      if (maxProgress > 0) {
        textTween.progress(maxProgress);
      }
    };

    setupTextTween();

    const onLocaleChange = (e: Event) => {
      const custom = e as CustomEvent<{ locale: Locale }>;
      const nextLocale = custom.detail?.locale || getLocale();
      const tokens = NARRATIVE_CONFIG[nextLocale] || NARRATIVE_CONFIG["pt-br"];
      mottoText.innerHTML = buildMottoHTML(tokens);

      if (prefersReducedMotion) {
        const chars = Array.from(mottoText.querySelectorAll<HTMLElement>(".char-flip"));
        chars.forEach((ch) => {
          ch.style.transform = "rotateX(0deg)";
          ch.style.opacity = "1";
        });
        return;
      }

      setupTextTween();
      ScrollTrigger.refresh();
    };

    window.addEventListener(LOCALE_CHANGE_EVENT, onLocaleChange);

    const onResize = () => {
      updateParallaxBounds();
    };

    window.addEventListener("resize", onResize, { passive: true });
    ScrollTrigger.addEventListener("refreshInit", updateParallaxBounds);

    cleanupFilmstrip = () => {
      window.removeEventListener("resize", onResize);
      window.removeEventListener(LOCALE_CHANGE_EVENT, onLocaleChange);
      ScrollTrigger.removeEventListener("refreshInit", updateParallaxBounds);
      parallaxTween.scrollTrigger?.kill();
      parallaxTween.kill();
      if (textTrigger) {
        textTrigger.kill();
        textTrigger = null;
      }
      if (textTween) {
        textTween.kill();
        textTween = null;
      }
    };
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initFilmstripParallax);
  } else {
    initFilmstripParallax();
  }
  document.addEventListener("astro:page-load", initFilmstripParallax);
</script>

<style>
  .parallax {
    --x: 0px;
    --progress: 0;
    transform: translateX(calc(var(--progress) * var(--x)));
    will-change: transform;
  }

  .radius-fix {
    border-radius: 0.75rem;
  }

  .motto__text {
    perspective: 1000px;
  }

  .motto__text > :not(:last-child) {
    margin-bottom: 2.5rem;
  }

  @media (min-width: 640px) {
    .motto__text > :not(:last-child) {
      margin-bottom: 4rem;
    }
  }

  .char-flip {
    transform-origin: 50% 50%;
    backface-visibility: hidden;
  }
</style>
