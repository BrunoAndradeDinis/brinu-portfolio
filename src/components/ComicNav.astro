---
/**
 * ComicNav.astro
 * Barra de navegação superior estilo manga brutalista inspirado em mew.xyz.
 * Estilizada integralmente via Tailwind CSS v4 & Bebop Design Tokens.
 * Layout relative (fluxo natural com a página) conforme especificação do projeto.
 */
---

<header
  class="relative z-hud flex h-[7rem] w-full items-center justify-between border-b-[3.5px] border-space-base bg-bebop-red px-4 sm:px-8 md:px-10 lg:px-20 select-none box-border"
>
  <!-- Brand / Avatar Micro-Badge & Nome Editorial -->
  <a
    href="/"
    class="group flex items-center gap-3 sm:gap-5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-space-base rounded-full"
    aria-label="Ir para o topo da página — Bruno Dinis (Brinu)"
  >
    <div
      class="flex h-12 w-12 sm:h-16 sm:w-16 shrink-0 items-center justify-center overflow-hidden rounded-full border-4 sm:border-[0.35rem] border-space-base bg-paper-white shadow-[0_3px_0_var(--color-space-base)] transition-transform duration-200 group-hover:scale-105 group-hover:-rotate-3"
    >
      <img
        src="/assets/brinu-avatar.jpg"
        alt="Micro-badge de Bruno Dinis (Brinu)"
        class="h-full w-full object-cover contrast-125"
      />
    </div>
    <span
      class="font-display text-lg sm:text-2xl lg:text-3xl font-black tracking-tight text-space-base leading-none transition-opacity duration-150 group-hover:opacity-90"
    >
      <span class="hidden sm:inline">BRUNO DINIS // BRINU</span>
      <span class="inline sm:hidden">BRINU</span>
    </span>
  </a>

  <!-- Ações de Navegação Editorial -->
  <nav
    class="flex items-center gap-2.5 sm:gap-4"
    aria-label="Navegação Principal"
  >
    <!-- Botão Pílula Selected Works -->
    <a
      href="#works"
      class="group inline-flex h-10 sm:h-14 items-center gap-1.5 sm:gap-2.5 rounded-full border-3 sm:border-4 border-space-base bg-contrast-pink px-3.5 sm:px-8 font-display text-xs sm:text-base lg:text-lg font-black text-space-base shadow-[0_3px_0_var(--color-space-base)] transition-all duration-150 hover:-translate-y-0.5 hover:bg-paper-white hover:shadow-[0_4px_0_var(--color-space-base)] active:translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-space-base leading-none"
      aria-label="Ir para a seção de projetos selecionados (Selected Works)"
    >
      <span class="hidden xs:inline sm:inline">SELECTED WORKS</span>
      <span class="inline xs:hidden sm:hidden">WORKS</span>
      <span
        aria-hidden="true"
        class="text-[10px] sm:text-xs transition-transform duration-200 group-hover:translate-y-0.5"
        >▾</span
      >
    </a>

    <!-- Botão Circular Verde Ácido com Ícone Estilizado de Quadrinhos -->
    <button
      type="button"
      id="cockpit-trigger-btn"
      class="group relative flex h-10 w-10 sm:h-14 sm:w-14 shrink-0 items-center justify-center rounded-full border-3 sm:border-4 border-space-base bg-acid-green shadow-[0_3px_0_var(--color-space-base)] transition-all duration-200 hover:-translate-y-0.5 hover:scale-105 hover:shadow-[0_5px_0_var(--color-space-base)] active:translate-y-0.5 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-space-base"
      aria-label="Abrir Menu Cockpit"
      aria-expanded="false"
    >
      <span
        class="relative flex flex-col justify-center gap-1 sm:gap-1.5 w-4 sm:w-6 h-4 sm:h-6"
        aria-hidden="true"
      >
        <span
          id="menu-bar-1"
          class="block h-[2.5px] sm:h-[3.5px] w-full rounded-sm bg-space-base transition-all duration-200 origin-center"
        ></span>
        <span
          id="menu-bar-2"
          class="block h-[2.5px] sm:h-[3.5px] w-3/4 self-end rounded-sm bg-space-base transition-all duration-200"
        ></span>
        <span
          id="menu-bar-3"
          class="block h-[2.5px] sm:h-[3.5px] w-full rounded-sm bg-space-base transition-all duration-200 origin-center"
        ></span>
      </span>
    </button>
  </nav>
</header>

<script>
  function setupCockpitTrigger() {
    const cockpitBtn = document.getElementById("cockpit-trigger-btn");
    const bar1 = document.getElementById("menu-bar-1");
    const bar2 = document.getElementById("menu-bar-2");
    const bar3 = document.getElementById("menu-bar-3");

    if (!cockpitBtn) return;

    cockpitBtn.addEventListener("click", () => {
      const isExpanded = cockpitBtn.getAttribute("aria-expanded") === "true";
      const nextState = !isExpanded;
      cockpitBtn.setAttribute("aria-expanded", String(nextState));

      // Transição tátil das barras estilizadas de quadrinhos
      if (bar1 && bar2 && bar3) {
        if (nextState) {
          bar1.classList.add("rotate-45", "translate-y-[6.5px]", "sm:translate-y-[8.5px]");
          bar2.classList.add("opacity-0", "scale-x-0");
          bar3.classList.add("-rotate-45", "-translate-y-[6.5px]", "sm:-translate-y-[8.5px]");
        } else {
          bar1.classList.remove("rotate-45", "translate-y-[6.5px]", "sm:translate-y-[8.5px]");
          bar2.classList.remove("opacity-0", "scale-x-0");
          bar3.classList.remove("-rotate-45", "-translate-y-[6.5px]", "sm:-translate-y-[8.5px]");
        }
      }

      window.dispatchEvent(
        new CustomEvent("cockpit:open", {
          detail: { isOpen: nextState },
        })
      );
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupCockpitTrigger);
  } else {
    setupCockpitTrigger();
  }
  document.addEventListener("astro:page-load", setupCockpitTrigger);
</script>
