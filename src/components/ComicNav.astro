---
/**
 * ComicNav.astro
 * Barra de navegação superior estilo manga brutalista inspirado em mew.xyz.
 * Estilizada integralmente via Tailwind CSS v4 & Bebop Design Tokens.
 */
---

<header
  class="relative z-hud flex h-[7rem] w-full items-center justify-between border-b-[3.5px] border-space-base bg-bebop-red px-4 sm:px-8 md:px-10 lg:px-20 select-none box-border"
>
  <!-- Brand / Avatar & Nome -->
  <div class="flex items-center gap-3 sm:gap-5">
    <div
      class="flex h-12 w-12 sm:h-16 sm:w-16 shrink-0 items-center justify-center overflow-hidden rounded-full border-4 sm:border-[0.35rem] border-space-base bg-paper-white shadow-[0_3px_0_var(--color-space-base)]"
    >
      <img
        src="/assets/brinu-avatar.jpg"
        alt="Bruno Dinis (Brinu)"
        class="h-full w-full object-cover"
      />
    </div>
    <span
      class="font-display text-lg sm:text-2xl lg:text-3xl font-black tracking-tight text-space-base leading-none"
    >
      <span class="hidden sm:inline">BRUNO DINIS // BRINU</span>
      <span class="inline sm:hidden">BRINU</span>
    </span>
  </div>

  <!-- Ações de Navegação -->
  <nav
    class="flex items-center gap-2.5 sm:gap-4"
    aria-label="Navegação Principal"
  >
    <a
      href="#works"
      class="inline-flex h-10 sm:h-14 items-center gap-1.5 sm:gap-2.5 rounded-full border-3 sm:border-4 border-space-base bg-contrast-pink px-3.5 sm:px-8 font-display text-xs sm:text-base lg:text-lg font-black text-space-base shadow-[0_3px_0_var(--color-space-base)] transition-transform duration-150 hover:-translate-y-0.5 active:translate-y-0.5 leading-none"
    >
      <span class="hidden xs:inline sm:inline">SELECTED WORKS</span>
      <span class="inline xs:hidden sm:hidden">WORKS</span>
      <span aria-hidden="true" class="text-[10px] sm:text-xs">▾</span>
    </a>

    <button
      type="button"
      id="cockpit-trigger-btn"
      class="flex h-10 w-10 sm:h-14 sm:w-14 shrink-0 items-center justify-center rounded-full border-3 sm:border-4 border-space-base bg-acid-green shadow-[0_3px_0_var(--color-space-base)] transition-transform duration-150 hover:-translate-y-0.5 hover:scale-105 active:translate-y-0.5 cursor-pointer"
      aria-label="Abrir Menu Cockpit"
      aria-expanded="false"
    >
      <span
        class="flex flex-col gap-1 sm:gap-1.5 w-4 sm:w-6"
        aria-hidden="true"
      >
        <span
          class="block h-[2.5px] sm:h-[3.5px] w-full rounded-sm bg-space-base"
        ></span>
        <span
          class="block h-[2.5px] sm:h-[3.5px] w-full rounded-sm bg-space-base"
        ></span>
        <span
          class="block h-[2.5px] sm:h-[3.5px] w-full rounded-sm bg-space-base"
        ></span>
      </span>
    </button>
  </nav>
</header>

<script>
  const cockpitBtn = document.getElementById("cockpit-trigger-btn");
  if (cockpitBtn) {
    cockpitBtn.addEventListener("click", () => {
      const isExpanded = cockpitBtn.getAttribute("aria-expanded") === "true";
      cockpitBtn.setAttribute("aria-expanded", String(!isExpanded));
      window.dispatchEvent(
        new CustomEvent("cockpit:open", {
          detail: { isOpen: !isExpanded },
        })
      );
    });
  }
</script>

