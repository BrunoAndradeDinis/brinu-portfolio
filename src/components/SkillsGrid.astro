---
import { getLocalizedSkillCategories } from "../data/cases";
import { ptBrDict } from "../i18n/dictionaries";

const categories = getLocalizedSkillCategories("pt-br");
---

<div class="mt-14 sm:mt-16 pt-12 border-t-4 border-bebop-red" data-skills-matrix>
  <div class="mb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
    <div>
      <span
        class="font-mono text-xs font-bold uppercase tracking-widest text-bebop-red"
        data-i18n="about.skillsTag"
      >
        {ptBrDict.about.skillsTag}
      </span>
      <h3
        class="mt-1 font-display text-2xl sm:text-3xl md:text-4xl font-black text-paper-white uppercase tracking-tight"
        data-i18n="about.skillsTitle"
      >
        {ptBrDict.about.skillsTitle}
      </h3>
    </div>
    <div
      class="font-mono text-xs font-bold text-paper-white border-2 border-paper-white bg-bebop-red px-3 py-1 -skew-x-6 self-start sm:self-end"
      data-i18n="about.skillsCount"
    >
      {ptBrDict.about.skillsCount}
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
    {categories.map((cat, idx) => {
      const isRedHeader = idx % 2 === 0;
      return (
        <div
          data-skill-vignette={cat.id}
          class="group relative flex flex-col justify-between border-4 border-paper-white bg-space-surface-1 p-5 sm:p-7 shadow-[6px_6px_0_var(--color-bebop-red)] transition-transform duration-200 hover:-translate-y-1"
        >
          <div>
            <div class="flex items-center justify-between pb-3 mb-4 border-b-2 border-bebop-red">
              <span
                class:list={[
                  "font-mono text-[10px] sm:text-xs font-black uppercase tracking-wider px-2.5 py-0.5 border-2",
                  isRedHeader
                    ? "bg-bebop-red text-paper-white border-paper-white"
                    : "bg-paper-white text-space-base border-paper-white",
                ]}
              >
                {cat.arcana}
              </span>
              <span class="font-mono text-[10px] font-black text-bebop-red uppercase tracking-widest">
                {cat.rank}
              </span>
            </div>

            <h4
              data-skill-title
              class="font-display text-xl sm:text-2xl font-black text-paper-white uppercase leading-tight"
            >
              {cat.title}
            </h4>
            <p
              data-skill-subtitle
              class="mt-1 font-mono text-xs text-muted-gray leading-normal"
            >
              {cat.subtitle}
            </p>
          </div>

          <div class="mt-6 flex flex-wrap gap-2 sm:gap-2.5">
            {cat.skills.map((skill) => (
              <span
                data-skill-badge
                class="inline-flex items-center border-2 border-paper-white bg-space-base px-3 py-1.5 font-mono text-xs font-bold text-paper-white shadow-[3px_3px_0_var(--color-bebop-red)] transition-colors duration-150 hover:bg-bebop-red hover:text-paper-white cursor-default select-none"
              >
                <span class="mr-1.5 text-bebop-red group-hover:text-paper-white text-[10px]">■</span>
                <span data-skill-badge-text>{skill}</span>
              </span>
            ))}
          </div>
        </div>
      );
    })}
  </div>
</div>
