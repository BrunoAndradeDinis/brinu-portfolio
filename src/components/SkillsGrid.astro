---
import { getArsenalCounter, getLocalizedArsenal } from "../data/arsenal";
import { ptBrDict } from "../i18n/dictionaries";

const domains = getLocalizedArsenal("pt-br");
const counter = getArsenalCounter("pt-br");
---

<div class="mt-14 sm:mt-16 pt-12 border-t-4 border-bebop-red" data-skills-matrix>
  <div class="mb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
    <div>
      <span
        class="font-mono text-xs font-bold uppercase tracking-widest text-bebop-red"
        data-i18n="about.skillsTag"
      >
        {ptBrDict.about.skillsTag}
      </span>
      <h3
        class="mt-1 font-display text-2xl sm:text-3xl md:text-4xl font-black text-paper-white uppercase tracking-tight"
        data-i18n="about.skillsTitle"
      >
        {ptBrDict.about.skillsTitle}
      </h3>
    </div>
    <div
      class="font-mono text-xs font-bold text-paper-white border-2 border-paper-white bg-bebop-red px-3 py-1 -skew-x-6 self-start sm:self-end"
      data-arsenal-counter
    >
      {counter}
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8">
    {domains.map((domain, idx) => (
      <div
        data-skill-vignette={domain.id}
        class="relative flex flex-col border-4 border-paper-white bg-space-surface-1 p-5 sm:p-7 shadow-[6px_6px_0_var(--color-bebop-red)]"
      >
        <div class="flex items-center justify-between pb-3 mb-5 border-b-2 border-bebop-red">
          <h4
            data-skill-title
            class="font-display text-xl sm:text-2xl font-black text-paper-white uppercase leading-tight"
          >
            {domain.title}
          </h4>
          <span class:list={[
            "font-mono text-[10px] sm:text-xs font-black px-2 py-0.5 border-2 border-paper-white",
            idx % 2 === 0 ? "bg-bebop-red text-paper-white" : "bg-paper-white text-space-base",
          ]}>
            0{idx + 1}
          </span>
        </div>
        <ul class="flex flex-col gap-3">
          {domain.skills.map((skill) => (
            <li data-skill-badge class="flex flex-wrap items-center gap-x-2 gap-y-1.5 border-b border-paper-white/15 pb-2.5 last:border-b-0">
              <span data-skill-badge-text class="font-mono text-xs sm:text-sm font-black text-paper-white uppercase">
                {skill.name}
              </span>
              <span class="font-mono text-[10px] text-muted-gray" aria-hidden="true">→</span>
              {skill.evidence.map((evidence) => (
                <a
                  href={`#${evidence.anchor}`}
                  data-evidence-link={evidence.ref}
                  class="border border-bebop-red px-1.5 py-0.5 font-mono text-[10px] sm:text-[11px] font-bold uppercase text-paper-white transition-colors duration-150 hover:bg-bebop-red focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-paper-white"
                >
                  {evidence.label}
                </a>
              ))}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</div>
