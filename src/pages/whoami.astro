---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ptBrDict } from "../i18n/dictionaries";
import { PROFILE } from "../data/profile";
---

<BaseLayout
  title={ptBrDict.meta.whoamiTitle}
  description={ptBrDict.meta.whoamiDescription}
>
  <main id="main-content" tabindex="-1" class="min-h-screen bg-space-base px-4 py-12 sm:px-8 sm:py-16 md:px-12 md:py-20 flex flex-col justify-center items-center select-none focus:outline-none">
    <div class="w-full max-w-4xl">
      <div
        data-terminal-window
        class="border-4 border-paper-white bg-space-surface-1 shadow-[10px_10px_0_var(--color-bebop-red)] overflow-hidden text-paper-white"
      >
        <div class="flex flex-wrap items-center justify-between gap-2 px-5 py-3.5 bg-space-base border-b-4 border-bebop-red font-mono text-xs">
          <div class="flex items-center gap-2">
            <span class="w-3.5 h-3.5 bg-bebop-red border border-paper-white inline-block" />
            <span class="w-3.5 h-3.5 bg-paper-white border border-paper-white inline-block" />
            <span class="w-3.5 h-3.5 bg-space-base border border-paper-white inline-block" />
          </div>

          <div class="text-[11px] sm:text-xs text-paper-white font-bold tracking-wider uppercase text-center truncate px-2">
            PHANTOM SHELL v2.0 // {PROFILE.handle} — {PROFILE.location.label}
          </div>

          <div class="flex items-center gap-2.5">
            <button
              type="button"
              id="whoami-lang-toggle-btn"
              data-lang-toggle
              data-active-locale="pt-br"
              class="inline-flex items-center justify-center border-2 border-paper-white bg-bebop-red px-2.5 py-1 font-mono text-[10px] font-black uppercase tracking-wider text-paper-white hover:bg-paper-white hover:text-space-base transition-colors cursor-pointer"
              aria-label={ptBrDict.nav.langToggleAria}
              data-i18n="nav.langToggleAria"
              data-i18n-attr="aria-label"
            >
              <span data-lang-toggle-label>PT-BR</span>
            </button>

            <button
              id="skip-typing-btn"
              type="button"
              class="inline-flex items-center gap-1.5 px-3 py-1 border-2 border-paper-white bg-space-base text-[10px] font-mono font-bold text-paper-white hover:bg-bebop-red hover:text-paper-white transition-all cursor-pointer"
            >
              <span data-i18n="whoami.skipCta">{ptBrDict.whoami.skipCta}</span>
            </button>

            <span class="inline-flex items-center gap-1.5 text-bebop-red font-bold text-[10px] hidden sm:inline-flex">
              <span class="w-2 h-2 bg-bebop-red animate-ping" />
              <span data-i18n="whoami.onlineBadge">{ptBrDict.whoami.onlineBadge}</span>
            </span>
          </div>
        </div>

        <div
          id="terminal-output"
          data-terminal-body
          class="p-6 sm:p-8 md:p-10 font-mono text-xs sm:text-sm leading-relaxed space-y-6 min-h-[26rem] bg-space-base overflow-x-auto relative"
        >
        </div>

        <div class="px-6 py-4 bg-space-surface-1 border-t-2 border-bebop-red flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs">
          <div class="text-muted-gray text-[11px] text-center sm:text-left">
            <span data-i18n="whoami.footerHint">{ptBrDict.whoami.footerHint}</span>
          </div>

          <a
            id="return-home-btn"
            href="/"
            data-return-home
            class="inline-flex items-center gap-2 px-5 py-2.5 border-2 border-paper-white bg-bebop-red text-paper-white font-display font-black text-xs uppercase tracking-wider hover:bg-paper-white hover:text-space-base transition-all duration-150 shadow-[4px_4px_0_var(--color-paper-white)]"
          >
            <span aria-hidden="true">←</span>
            <span data-i18n="whoami.returnHomeCta">{ptBrDict.whoami.returnHomeCta}</span>
          </a>
        </div>
      </div>
    </div>
  </main>

  <script>
    import { audioSynth } from "../utils/audio";
    import { getDictionary, getLocale, LOCALE_CHANGE_EVENT } from "../i18n/index";

    interface CommandStep {
      command: string;
      output: string;
      highlightClass?: string;
    }

    function buildCommandSteps(): CommandStep[] {
      const t = getDictionary(getLocale());
      return [
        {
          command: "whoami",
          output: t.whoami.steps.whoamiOut,
          highlightClass: "text-paper-white font-bold",
        },
        {
          command: "uptime",
          output: t.whoami.steps.uptimeOut,
          highlightClass: "text-bebop-red font-semibold",
        },
        {
          command: "cat /etc/location",
          output: t.whoami.steps.locationOut,
          highlightClass: "text-paper-white font-bold",
        },
        {
          command: "cat /etc/current-mission",
          output: t.whoami.steps.missionOut,
          highlightClass: "text-muted-gray font-semibold",
        },
        {
          command: "ls -la skills/",
          output: t.whoami.steps.skillsOut,
          highlightClass: "text-paper-white",
        },
        {
          command: "echo $PHILOSOPHY",
          output: t.whoami.steps.philosophyOut,
          highlightClass: "text-bebop-red italic font-bold",
        },
      ];
    }

    const terminalEl = document.getElementById("terminal-output");
    const skipBtn = document.getElementById("skip-typing-btn");

    let isSkipped = false;

    function renderAllInstant(): void {
      if (!terminalEl) return;
      isSkipped = true;
      terminalEl.innerHTML = "";

      const t = getDictionary(getLocale());
      const steps = buildCommandSteps();

      steps.forEach((step) => {
        const block = document.createElement("div");
        block.className = "space-y-1.5";
        block.innerHTML = `
          <div class="flex items-center gap-2 text-bebop-red font-bold">
            <span class="text-paper-white">&gt;</span>
            <span>${step.command}</span>
          </div>
          <div class="pl-4 border-l-2 border-bebop-red ${step.highlightClass || "text-paper-white"} whitespace-pre-line">
            ${step.output}
          </div>
        `;
        terminalEl.appendChild(block);
      });

      const sessionComplete = document.createElement("div");
      sessionComplete.className = "pt-4 text-xs font-bold text-paper-white tracking-wider uppercase flex items-center gap-2 border-t border-paper-white/30 mt-6";
      sessionComplete.innerHTML = `<span class="w-2 h-2 bg-bebop-red"></span> <span>${t.whoami.sessionComplete}</span>`;
      terminalEl.appendChild(sessionComplete);
    }

    async function runTypingSimulator(): Promise<void> {
      if (!terminalEl) return;
      terminalEl.innerHTML = "";

      const steps = buildCommandSteps();
      const t = getDictionary(getLocale());

      for (const step of steps) {
        if (isSkipped) return;

        const block = document.createElement("div");
        block.className = "space-y-1.5";

        const promptLine = document.createElement("div");
        promptLine.className = "flex items-center gap-2 text-bebop-red font-bold";
        promptLine.innerHTML = `<span class="text-paper-white">&gt;</span> <span class="typed-command"></span><span class="cursor inline-block w-2 h-4 bg-bebop-red animate-pulse"></span>`;
        block.appendChild(promptLine);
        terminalEl.appendChild(block);

        const commandSpan = promptLine.querySelector(".typed-command");
        const cursorEl = promptLine.querySelector(".cursor");

        for (let i = 0; i < step.command.length; i++) {
          if (isSkipped) {
            renderAllInstant();
            return;
          }
          if (commandSpan) commandSpan.textContent += step.command[i];
          if (!audioSynth.isMuted()) {
            audioSynth.playKeypressBeep(800 + Math.random() * 200, 0.03, 0.08);
          }
          await new Promise((r) => setTimeout(r, 30));
        }

        if (cursorEl) cursorEl.remove();

        await new Promise((r) => setTimeout(r, 140));
        if (isSkipped) {
          renderAllInstant();
          return;
        }

        const outputLine = document.createElement("div");
        outputLine.className = `pl-4 border-l-2 border-bebop-red ${step.highlightClass || "text-paper-white"} whitespace-pre-line`;
        outputLine.textContent = step.output;
        block.appendChild(outputLine);

        terminalEl.scrollTop = terminalEl.scrollHeight;

        await new Promise((r) => setTimeout(r, 240));
      }

      const sessionComplete = document.createElement("div");
      sessionComplete.className = "pt-4 text-xs font-bold text-paper-white tracking-wider uppercase flex items-center gap-2 border-t border-paper-white/30 mt-6";
      sessionComplete.innerHTML = `<span class="w-2 h-2 bg-bebop-red"></span> <span>${t.whoami.sessionComplete}</span>`;
      terminalEl.appendChild(sessionComplete);
    }

    if (skipBtn) {
      skipBtn.addEventListener("click", () => renderAllInstant());
    }

    window.addEventListener("keydown", (e) => {
      if (!isSkipped && e.key !== "Tab") {
        renderAllInstant();
      }
    });

    window.addEventListener(LOCALE_CHANGE_EVENT, () => {
      renderAllInstant();
    });

    runTypingSimulator();
  </script>
</BaseLayout>
