---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ptBrDict } from "../i18n/dictionaries";
import { PROFILE } from "../data/profile";
import { MAX_INPUT_LENGTH } from "../utils/terminal/sanitize";
---

<BaseLayout
  title={ptBrDict.meta.whoamiTitle}
  description={ptBrDict.meta.whoamiDescription}
>
  <main
    id="main-content"
    data-whoami-main
    tabindex="-1"
    class="relative -mt-[5.5rem] sm:-mt-[6.5rem] md:-mt-[7rem] min-h-[100dvh] box-border bg-space-base px-4 py-16 sm:px-8 md:px-12 flex flex-col justify-center items-center select-none focus:outline-none"
  >
    <div class="w-full max-w-[57rem] my-auto">
      <div
        data-terminal-window
        data-lenis-prevent
        class="flex h-[clamp(22rem,calc(100dvh-8rem),45rem)] flex-col border-4 border-paper-white bg-space-surface-1 shadow-[10px_10px_0_var(--color-bebop-red)] overflow-hidden text-paper-white"
      >
        <div class="flex shrink-0 flex-wrap items-center justify-between gap-2 px-5 py-3.5 bg-space-base border-b-4 border-bebop-red font-mono text-xs">
          <div class="flex items-center gap-2">
            <span class="w-3.5 h-3.5 bg-bebop-red border border-paper-white inline-block" />
            <span class="w-3.5 h-3.5 bg-paper-white border border-paper-white inline-block" />
            <span class="w-3.5 h-3.5 bg-space-base border border-paper-white inline-block" />
          </div>

          <div class="text-[11px] sm:text-xs text-paper-white font-bold tracking-wider uppercase text-center truncate px-2">
            PHANTOM SHELL v2.0 // {PROFILE.handle} — {PROFILE.location.label}
          </div>

          <div class="flex items-center gap-2.5">
            <button
              type="button"
              id="whoami-lang-toggle-btn"
              data-lang-toggle
              data-active-locale="pt-br"
              class="inline-flex items-center justify-center whitespace-nowrap border-2 border-paper-white bg-bebop-red px-2.5 py-1 font-mono text-[10px] font-black uppercase tracking-wider text-paper-white hover:bg-paper-white hover:text-space-base transition-colors cursor-pointer"
              aria-label={ptBrDict.nav.langToggleAria}
              data-i18n="nav.langToggleAria"
              data-i18n-attr="aria-label"
            >
              <span data-lang-toggle-label>PT-BR</span>
            </button>

            <button
              id="skip-typing-btn"
              type="button"
              class="inline-flex items-center gap-1.5 whitespace-nowrap px-3 py-1 border-2 border-paper-white bg-space-base text-[10px] font-mono font-bold text-paper-white hover:bg-bebop-red hover:text-paper-white transition-all cursor-pointer"
            >
              <span data-i18n="whoami.skipCta">{ptBrDict.whoami.skipCta}</span>
            </button>

            <span class="hidden sm:inline-flex items-center gap-1.5 text-bebop-red font-bold text-[10px]">
              <span class="w-2 h-2 bg-bebop-red animate-ping" />
              <span data-i18n="whoami.onlineBadge">{ptBrDict.whoami.onlineBadge}</span>
            </span>
          </div>
        </div>

        <div class="flex min-h-0 flex-1 flex-col bg-space-base select-text">
          <div
            id="terminal-output"
            data-terminal-body
            data-lenis-prevent
            role="log"
            aria-live="polite"
            aria-relevant="additions"
            class="px-6 pt-6 sm:px-8 sm:pt-8 md:px-10 md:pt-10 pb-2 font-mono text-xs sm:text-sm leading-relaxed scroll-area min-h-0 flex-1 overflow-y-auto overflow-x-hidden overscroll-contain"
          ></div>
          <form data-terminal-form class="flex shrink-0 items-center gap-2 px-6 pb-6 sm:px-8 sm:pb-8 md:px-10 md:pb-10 font-mono text-xs sm:text-sm" autocomplete="off">
            <label for="terminal-input" class="shrink-0 font-bold text-bebop-red">
              <span class="sr-only" data-i18n="whoami.promptLabel">{ptBrDict.whoami.promptLabel}</span>
              <span aria-hidden="true">{PROFILE.handle.toLowerCase()}@bebop:~$</span>
            </label>
            <input
              id="terminal-input"
              data-terminal-input
              type="text"
              inputmode="text"
              maxlength={MAX_INPUT_LENGTH}
              spellcheck="false"
              autocapitalize="off"
              autocomplete="off"
              enterkeyhint="send"
              placeholder={ptBrDict.whoami.inputPlaceholder}
              data-i18n="whoami.inputPlaceholder"
              data-i18n-attr="placeholder"
              class="min-w-0 flex-1 border-0 border-b-2 border-paper-white/30 bg-transparent px-1 py-1 text-paper-white caret-bebop-red outline-none placeholder:text-muted-gray focus:border-bebop-red"
            />
          </form>
        </div>

        <div class="shrink-0 px-4 py-3 sm:px-6 sm:py-4 bg-space-surface-1 border-t-2 border-bebop-red flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs">
          <div class="hidden sm:block text-muted-gray text-[11px] text-left">
            <span data-i18n="whoami.footerHint">{ptBrDict.whoami.footerHint}</span>
          </div>

          <a
            id="return-home-btn"
            href="/"
            data-return-home
            class="inline-flex w-full sm:w-auto items-center justify-center gap-2 px-4 sm:px-5 py-2.5 border-2 border-paper-white bg-bebop-red text-paper-white font-display font-black text-[10px] sm:text-xs uppercase sm:tracking-wider hover:bg-paper-white hover:text-space-base transition-all duration-150 shadow-[4px_4px_0_var(--color-paper-white)]"
          >
            <span aria-hidden="true">←</span>
            <span data-i18n="whoami.returnHomeCta">{ptBrDict.whoami.returnHomeCta}</span>
          </a>
        </div>
      </div>
    </div>
  </main>

  <script>
    import { audioSynth } from "../utils/audio";
    import { getLocale, setLocale } from "../i18n/index";
    import { onPageReady } from "../utils/page-lifecycle";
    import { runCommand, completeInput, type TerminalLine, type TerminalResult } from "../utils/terminal/commands";

    const OPENING = ["whoami", "help"] as const;
    const TYPE_MS = 45;
    const TONES: Record<TerminalLine["tone"], string> = {
      plain: "text-paper-white",
      accent: "text-bebop-red font-bold",
      strong: "text-paper-white font-bold",
      muted: "text-muted-gray",
    };

    const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
    const prefersStill = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function bootTerminal(): (() => void) | undefined {
      const output = document.querySelector<HTMLElement>("[data-terminal-body]");
      const form = document.querySelector<HTMLFormElement>("[data-terminal-form]");
      const input = document.querySelector<HTMLInputElement>("[data-terminal-input]");
      const skipBtn = document.getElementById("skip-typing-btn");
      if (!output || !form || !input) return undefined;

      const history: string[] = [];
      let cursor = 0;
      let opening = true;
      let disposed = false;

      const scrollDown = () => {
        output.scrollTop = output.scrollHeight;
      };

      const echo = (command: string) => {
        const row = document.createElement("div");
        row.className = "mt-4 first:mt-0 flex gap-2 font-bold";
        const prompt = document.createElement("span");
        prompt.className = "shrink-0 text-bebop-red";
        prompt.setAttribute("aria-hidden", "true");
        prompt.textContent = "$";
        const text = document.createElement("span");
        text.dataset.terminalEcho = "";
        text.className = "min-w-0 text-paper-white [overflow-wrap:anywhere]";
        text.textContent = command;
        row.append(prompt, text);
        output.append(row);
        return text;
      };

      const print = (lines: readonly TerminalLine[]) => {
        for (const entry of lines) {
          const row = document.createElement("div");
          row.dataset.terminalLine = entry.tone;
          if (entry.term && entry.detail) {
            row.className = "flex flex-wrap gap-x-3 [overflow-wrap:anywhere]";
            const term = document.createElement("span");
            term.className = "min-w-[19ch] font-bold text-paper-white";
            term.textContent = entry.term;
            const detail = document.createElement("span");
            detail.className = "text-muted-gray";
            detail.textContent = entry.detail;
            row.append(term, detail);
          } else {
            row.className = `whitespace-pre-wrap [overflow-wrap:anywhere] ${TONES[entry.tone]}`;
            row.textContent = entry.text;
          }
          output.append(row);
        }
        scrollDown();
      };

      const download = (filename: string, href: string) => {
        const link = document.createElement("a");
        link.href = href;
        link.download = filename;
        link.hidden = true;
        document.body.append(link);
        link.click();
        link.remove();
      };

      const apply = (result: TerminalResult) => {
        const effect = result.effect;
        if (!effect) return;
        if (effect.type === "clear") output.replaceChildren();
        else if (effect.type === "download") download(effect.filename, effect.href);
        else if (effect.type === "locale") setLocale(effect.locale, { animate: false });
        else if (effect.type === "navigate") window.location.assign(effect.href);
        else if (effect.type === "mail") window.location.href = effect.href;
        else if (effect.type === "cilada") window.dispatchEvent(new CustomEvent("bebop:cilada-trigger"));
      };

      const execute = (raw: string) => {
        const result = runCommand(raw, getLocale());
        echo(result.input);
        print(result.lines);
        apply(result);
        return result;
      };

      const finishOpening = () => {
        if (!opening) return;
        opening = false;
        output.replaceChildren();
        OPENING.forEach((command) => execute(command));
        input.focus({ preventScroll: true });
      };

      const typeOpening = async () => {
        for (const command of OPENING) {
          const text = echo("");
          for (const char of command) {
            if (!opening || disposed) return;
            text.textContent += char;
            if (!audioSynth.isMuted()) audioSynth.playKeypressBeep(800 + Math.random() * 200, 0.03, 0.08);
            await wait(TYPE_MS);
          }
          if (!opening || disposed) return;
          print(runCommand(command, getLocale()).lines);
          await wait(240);
        }
        if (!opening || disposed) return;
        opening = false;
        input.focus({ preventScroll: true });
      };

      const onSubmit = (event: SubmitEvent) => {
        event.preventDefault();
        finishOpening();
        const result = execute(input.value);
        if (result.input) {
          history.push(result.input);
          cursor = history.length;
        }
        input.value = "";
      };

      const onInputKey = (event: KeyboardEvent) => {
        if (event.key === "ArrowUp" || event.key === "ArrowDown") {
          if (!history.length) return;
          event.preventDefault();
          cursor = Math.min(history.length, Math.max(0, cursor + (event.key === "ArrowUp" ? -1 : 1)));
          input.value = history[cursor] ?? "";
          input.setSelectionRange(input.value.length, input.value.length);
        } else if (event.key === "Tab" && input.value.trim()) {
          event.preventDefault();
          const completion = completeInput(input.value, getLocale());
          if (completion.value) input.value = completion.value;
          else if (completion.options.length > 1) {
            echo(input.value);
            print([{ text: completion.options.join("  "), tone: "muted" }]);
          }
        }
      };

      const onWindowKey = (event: KeyboardEvent) => {
        if (opening && event.key !== "Tab") finishOpening();
      };

      const onSkip = () => finishOpening();

      form.addEventListener("submit", onSubmit);
      input.addEventListener("keydown", onInputKey);
      window.addEventListener("keydown", onWindowKey);
      skipBtn?.addEventListener("click", onSkip);

      if (prefersStill()) finishOpening();
      else void typeOpening();

      return () => {
        disposed = true;
        form.removeEventListener("submit", onSubmit);
        input.removeEventListener("keydown", onInputKey);
        window.removeEventListener("keydown", onWindowKey);
        skipBtn?.removeEventListener("click", onSkip);
      };
    }

    onPageReady(bootTerminal);
  </script>
</BaseLayout>
