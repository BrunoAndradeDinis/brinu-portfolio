---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Bruno Dinis // Brinu — Portfolio">
  <main id="main-content">
    <section id="hero-preview" style="min-height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: center; background-color: #0B0B12; color: #EDEAE5; font-family: monospace; text-align: center; padding: 2rem;">
      <p style="color: #E5A93C; font-size: 0.875rem; letter-spacing: 0.2em; text-transform: uppercase; margin-bottom: 0.5rem;">[ SYSTEM INITIALIZED // ASTRO 5 ]</p>
      <h1 style="font-size: 2.5rem; margin: 0 0 1rem 0; letter-spacing: -0.02em;">Bruno de Andrade Dinis // Brinu</h1>
      <p style="color: #A5A5B2; max-width: 600px; line-height: 1.6; margin: 0;">
        Retro-futuristic engineering substrate online. Core infrastructure ready for tokens, motion coordinator, and reactive islands.
      </p>
    </section>
  </main>
</BaseLayout>
