---
/**
 * index.astro
 * Bebop Manga Brutalist Noir — Portfolio Landing
 * Orquestrador limpo e modular das seções principais.
 * Zero código chumbado. Estilos centralizados e desacoplados por componente e domínio.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import ComicNav from "../components/ComicNav.astro";
import ComicHero from "../components/ComicHero.astro";
import SelectedWorks from "../components/SelectedWorks.astro";
import About from "../components/About.astro";
import CreativeLab from "../components/CreativeLab.astro";
import Contact from "../components/Contact.astro";
import BebopFooter from "../components/BebopFooter.astro";
---

<BaseLayout title="Brinu - Software Engineer & Creative Technologist">
  <!-- Top Bar Editorial Manga / mew.xyz -->
  <ComicNav />

  <main id="main-content" class="flex min-h-screen flex-col overflow-x-hidden bg-bebop-red text-space-base">
    <!-- Hero Monumental Carmesim & Tipografia Colossal "BRINU" -->
    <ComicHero />

    <!-- Vitrine de Projetos & Bounty Archive -->
    <SelectedWorks />

    <!-- Dossiê do Autor & Trajetória Técnica -->
    <About />

    <!-- Creative Lab: Experimentos Visuais & Áudio Analógico -->
    <CreativeLab />

    <!-- Ato 5: Contato e Envio de Propostas (Bounty Board) -->
    <Contact />

    <!-- Rodapé Minimalista Noir -->
    <BebopFooter />
  </main>
</BaseLayout>
