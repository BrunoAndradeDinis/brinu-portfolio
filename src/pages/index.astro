---
/**
 * index.astro
 * Bebop Manga Brutalist Noir — Portfolio Landing
 * Heurística visual inspirada no mew.xyz (Quarta Imagem) e na abertura (Tank!) de Cowboy Bebop.
 * Fundo vermelho carmesim (#FE0000), tipografia colossal em preto profundo (#070612),
 * top bar limpa sem ruído técnico e composição de quadrinhos editorial.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Bruno Dinis // Brinu — Software Engineer & Creative Technologist">
  <main id="main-content" class="bebop-home">
    <!-- Top Bar Editorial Estilo Manga / mew.xyz -->
    <header class="comic-nav">
      <div class="comic-nav__brand">
        <div class="brand-avatar-badge">
          <img
            src="/assets/brinu-avatar.jpg"
            alt="Bruno Dinis (Brinu)"
            class="brand-avatar-img"
          />
        </div>
        <span class="brand-title font-display">BRUNO DINIS // BRINU</span>
      </div>

      <nav class="comic-nav__actions" aria-label="Navegação Principal">
        <a href="#works" class="btn-pill-action font-display">
          <span>SELECTED WORKS</span>
          <span aria-hidden="true" class="btn-arrow">▾</span>
        </a>

        <button
          type="button"
          class="btn-circle-menu"
          aria-label="Abrir Menu de Cenas"
          onclick="alert('Menu Cockpit em desenvolvimento para a próxima epic!')"
        >
          <span class="menu-icon-bars" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </button>
      </nav>
    </header>

    <!-- Fita Ticker Tape Contínua de Abertura -->
    <div class="hero-ticker" aria-hidden="true">
      <div class="hero-ticker__track font-display">
        <span>• ARCHITECTING RESILIENT DISTRIBUTED SYSTEMS • CREATIVE TECHNOLOGIST • MAGALU CLOUD • PAI DA HELENA • NOIVO • 60 FPS • SEE YOU SPACE COWBOY •</span>
        <span>• ARCHITECTING RESILIENT DISTRIBUTED SYSTEMS • CREATIVE TECHNOLOGIST • MAGALU CLOUD • PAI DA HELENA • NOIVO • 60 FPS • SEE YOU SPACE COWBOY •</span>
      </div>
    </div>

    <!-- Hero Monumental Carmesim com Tipografia Preta Colossal -->
    <section class="comic-hero" id="hero">
      <div class="comic-hero__stage">
        <!-- Letras Monumentais "BRINU" em Preto Sólido -->
        <h1 class="hero-monument font-display" aria-label="BRINU">
          <span class="letter">B</span>
          <span class="letter">R</span>
          <span class="letter letter--center">
            I
            <!-- Personagem / Avatar Integrado no Glifo Central (Estilo Mew.xyz) -->
            <div class="hero-avatar-cutout">
              <img
                src="/assets/brinu-avatar.jpg"
                alt="Retrato Noir do Bruno"
                class="avatar-cutout-img"
              />
              <span class="avatar-tag font-spray">HELENA'S DAD</span>
            </div>
          </span>
          <span class="letter">N</span>
          <span class="letter">U</span>
        </h1>

        <!-- Textos de Canto Estilo Editorial de Quadrinhos (Quarta Imagem) -->
        <div class="comic-hero__footer">
          <div class="footer-block footer-block--left">
            <p class="comic-headline font-display">
              FOR TOO LONG<br />
              BORING CODE<br />
              HAS RULED THE WEB
            </p>
            <a href="#works" class="comic-scroll-cta font-mono">
              <span class="arrow-down">↓</span>
              <span>THE CRAFT HAS BEGUN</span>
            </a>
          </div>

          <div class="footer-block footer-block--right">
            <p class="comic-headline font-display">
              TURNING COMPLEX<br />
              ARCHITECTURES INTO<br />
              CINEMATIC ART
            </p>
            <div class="social-comic-links">
              <a
                href="https://github.com/BrunoAndradeDinis"
                target="_blank"
                rel="noopener noreferrer"
                class="social-pill font-mono"
              >
                GITHUB
              </a>
              <a
                href="https://linkedin.com/in/brunoandradedinis"
                target="_blank"
                rel="noopener noreferrer"
                class="social-pill font-mono"
              >
                LINKEDIN
              </a>
              <a
                href="mailto:bruno.andrade.dinis@gmail.com"
                class="social-pill font-mono"
              >
                E-MAIL
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Transição de Storyboard para os Cases Autorais (Tiras de Película 35mm) -->
    <section id="works" class="film-storyboard-section">
      <div class="section-badge-bar">
        <span class="comic-section-tag font-mono">[ ACT I // 35MM FILM REEL ]</span>
        <h2 class="section-title font-display">SELECTED WORKS</h2>
      </div>

      <div class="film-tracks-container">
        <!-- Trilho 1 Inclinado -->
        <div class="film-track rotate-angle-neg">
          <article class="film-card">
            <div class="film-card__meta font-mono">
              <span>REEL 01 // CLOUD BACKEND</span>
              <span class="pill-badge">DISTRIBUTED</span>
            </div>
            <h3 class="film-card__title font-display">AuraStream & Painel Stream</h3>
            <p class="film-card__desc font-body">
              Engine de transmissão e infraestrutura de nuvem resiliente operando pipelines de mídia de alta disponibilidade.
            </p>
          </article>

          <article class="film-card">
            <div class="film-card__meta font-mono">
              <span>REEL 02 // CONCURRENCY</span>
              <span class="pill-badge">PARSER</span>
            </div>
            <h3 class="film-card__title font-display">Quake Log Parser</h3>
            <p class="film-card__desc font-body">
              Parser assíncrono de logs de partidas em tempo real construído com TypeScript puro, Docker e testes automatizados.
            </p>
          </article>
        </div>

        <!-- Trilho 2 Inclinado com Parallax Oposto -->
        <div class="film-track rotate-angle-pos">
          <article class="film-card film-card--alt">
            <div class="film-card__meta font-mono">
              <span>REEL 03 // FRONTEND</span>
              <span class="pill-badge">GAMIFIED</span>
            </div>
            <h3 class="film-card__title font-display">Jokenpo Franky</h3>
            <p class="film-card__desc font-body">
              Arena retrô com lógica orientada a eventos, animações táteis a 60 FPS e experiência imersiva de jogo.
            </p>
          </article>

          <article class="film-card film-card--alt">
            <div class="film-card__meta font-mono">
              <span>REEL 04 // EDITORIAL</span>
              <span class="pill-badge">NOIR DESIGN</span>
            </div>
            <h3 class="film-card__title font-display">The Warriors</h3>
            <p class="film-card__desc font-body">
              Design editorial cru de alta fidelidade homenageando o clássico cult, com arquitetura frontend minimalista.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- Rodapé Minimalista Estilo Cowboy Bebop -->
    <footer class="bebop-manga-footer">
      <div class="footer-wrap font-mono">
        <p>BRINU.DEV // BRUNO DE ANDRADE DINIS // 2026</p>
        <p class="bebop-signature">"SEE YOU SPACE COWBOY..."</p>
      </div>
    </footer>
  </main>
</BaseLayout>

<style>
  /* ==========================================================================
     LAYOUT PRINCIPAL: VERMELHO BEBOP DOMINANTE (QUARTA IMAGEM)
     ========================================================================== */
  .bebop-home {
    background-color: var(--color-bebop-red);
    color: var(--color-space-base);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
  }

  /* ==========================================================================
     1. TOP BAR LIMPA (COMIC NAV)
     ========================================================================== */
  .comic-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-4) var(--space-6);
    background-color: var(--color-bebop-red);
    border-bottom: var(--border-comic-medium) solid var(--color-space-base);
    position: sticky;
    top: 0;
    z-index: var(--z-hud);
  }

  .comic-nav__brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .brand-avatar-badge {
    width: 3.6rem;
    height: 3.6rem;
    border-radius: 50%;
    border: var(--border-comic-medium) solid var(--color-space-base);
    overflow: hidden;
    background-color: var(--color-paper-white);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0.2rem 0 var(--color-space-base);
  }

  .brand-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .brand-title {
    font-size: 1.8rem;
    color: var(--color-space-base);
    letter-spacing: -0.02em;
  }

  .comic-nav__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .btn-pill-action {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background-color: var(--color-contrast-pink);
    color: var(--color-space-base);
    border: var(--border-comic-heavy) solid var(--color-space-base);
    border-radius: var(--radius-pill);
    font-size: 1.4rem;
    font-weight: 900;
    text-decoration: none;
    box-shadow: 0 0.3rem 0 var(--color-space-base);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .btn-pill-action:hover {
    transform: translateY(-0.2rem);
    box-shadow: 0 0.5rem 0 var(--color-space-base);
  }

  .btn-pill-action:active {
    transform: translateY(0.1rem);
    box-shadow: 0 0.1rem 0 var(--color-space-base);
  }

  .btn-arrow {
    font-size: 1.2rem;
  }

  .btn-circle-menu {
    width: 4.4rem;
    height: 4.4rem;
    border-radius: 50%;
    background-color: var(--color-acid-green);
    border: var(--border-comic-heavy) solid var(--color-space-base);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 0.3rem 0 var(--color-space-base);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .btn-circle-menu:hover {
    transform: translateY(-0.2rem) scale(1.04);
    box-shadow: 0 0.5rem 0 var(--color-space-base);
  }

  .menu-icon-bars {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    width: 1.8rem;
  }

  .menu-icon-bars span {
    display: block;
    height: 0.3rem;
    background-color: var(--color-space-base);
    border-radius: 0.1rem;
  }

  /* ==========================================================================
     2. TICKER TAPE
     ========================================================================== */
  .hero-ticker {
    width: 100%;
    overflow: hidden;
    background-color: var(--color-bebop-red);
    border-bottom: var(--border-comic-heavy) solid var(--color-space-base);
    padding: var(--space-2) 0;
    user-select: none;
  }

  .hero-ticker__track {
    display: inline-flex;
    width: max-content;
    animation: marquee 28s linear infinite;
    font-size: 1.4rem;
    color: var(--color-space-base);
    letter-spacing: -0.01em;
  }

  /* ==========================================================================
     3. HERO MONUMENTAL PRETO SOBRE VERMELHO (HEURÍSTICA MEW.XYZ)
     ========================================================================== */
  .comic-hero {
    position: relative;
    padding: var(--space-8) var(--space-6) var(--space-12);
    min-height: calc(100vh - 12rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background-color: var(--color-bebop-red);
  }

  .comic-hero__stage {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1;
    max-width: 160rem;
    margin: 0 auto;
    width: 100%;
  }

  .hero-monument {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: clamp(8rem, 21vw, 26rem);
    line-height: 0.82;
    color: var(--color-space-base);
    margin: var(--space-4) 0;
    user-select: none;
    letter-spacing: -0.04em;
    width: 100%;
  }

  .hero-monument .letter {
    display: inline-block;
    position: relative;
  }

  .letter--center {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  /* Avatar / Personagem Recortado Integrado no Centro do Nome */
  .hero-avatar-cutout {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: clamp(7rem, 14vw, 18rem);
    height: clamp(7rem, 14vw, 18rem);
    border-radius: var(--radius-lg);
    border: var(--border-comic-thick) solid var(--color-space-base);
    overflow: hidden;
    background-color: var(--color-paper-white);
    box-shadow: 0 0.8rem 0 var(--color-space-base);
    z-index: 10;
  }

  .avatar-cutout-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.15);
  }

  .avatar-tag {
    position: absolute;
    bottom: -0.2rem;
    left: 50%;
    transform: translateX(-50%) rotate(-4deg);
    background-color: var(--color-bebop-amber);
    color: var(--color-space-base);
    font-size: 1rem;
    padding: 0.2rem 0.6rem;
    white-space: nowrap;
    border: 2px solid var(--color-space-base);
    border-radius: var(--radius-sm);
  }

  /* Footer Editorial com Textos nos Cantos */
  .comic-hero__footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: var(--space-8);
    flex-wrap: wrap;
    gap: var(--space-6);
  }

  .comic-headline {
    font-size: clamp(1.8rem, 2.5vw, 3.2rem);
    color: var(--color-space-base);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }

  .comic-scroll-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-space-base);
    text-decoration: none;
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .arrow-down {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    background-color: var(--color-space-base);
    color: var(--color-paper-white);
    border-radius: 50%;
    font-size: 1.2rem;
  }

  .social-comic-links {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .social-pill {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    background-color: var(--color-space-base);
    color: var(--color-paper-white);
    text-decoration: none;
    border-radius: var(--radius-pill);
    font-size: 1.2rem;
    font-weight: 700;
    transition: transform var(--transition-fast), background-color var(--transition-fast);
  }

  .social-pill:hover {
    background-color: var(--color-paper-white);
    color: var(--color-space-base);
    transform: translateY(-0.2rem);
  }

  /* ==========================================================================
     4. SEÇÃO SELECTED WORKS (TIRAS DE PELÍCULA 35MM)
     ========================================================================== */
  .film-storyboard-section {
    background-color: var(--color-space-base);
    color: var(--color-paper-white);
    padding: var(--space-16) var(--space-6);
    border-top: var(--border-comic-thick) solid var(--color-space-base);
  }

  .section-badge-bar {
    max-width: 140rem;
    margin: 0 auto var(--space-8);
  }

  .comic-section-tag {
    color: var(--color-bebop-amber);
    font-size: 1.3rem;
    letter-spacing: 0.15em;
    display: block;
    margin-bottom: var(--space-1);
  }

  .section-title {
    font-size: clamp(3rem, 6vw, 6.4rem);
    color: var(--color-paper-white);
    letter-spacing: -0.03em;
  }

  .film-tracks-container {
    max-width: 140rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .film-track {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(32rem, 1fr));
    gap: var(--space-6);
    transition: transform var(--transition-smooth);
  }

  .film-card {
    background-color: var(--color-space-surface-1);
    border: var(--border-comic-heavy) solid var(--color-bebop-red);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: 0 0.8rem 0 rgba(254, 0, 0, 0.4);
    transition: transform var(--transition-fast);
  }

  .film-card--alt {
    border-color: var(--color-acid-green);
    box-shadow: 0 0.8rem 0 rgba(46, 254, 12, 0.3);
  }

  .film-card:hover {
    transform: translateY(-0.4rem) scale(1.02);
  }

  .film-card__meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 1.1rem;
    color: var(--color-muted-gray);
    margin-bottom: var(--space-4);
  }

  .pill-badge {
    background-color: var(--color-space-surface-2);
    padding: 0.2rem 0.8rem;
    border-radius: var(--radius-pill);
    color: var(--color-paper-white);
  }

  .film-card__title {
    font-size: 2.4rem;
    margin-bottom: var(--space-2);
    color: var(--color-paper-white);
  }

  .film-card__desc {
    font-size: 1.4rem;
    color: var(--color-muted-gray);
    line-height: 1.5;
  }

  /* ==========================================================================
     5. RODAPÉ MINIMALISTA
     ========================================================================== */
  .bebop-manga-footer {
    background-color: var(--color-space-surface-1);
    border-top: var(--border-technical-thin) solid var(--color-space-border);
    padding: var(--space-6);
  }

  .footer-wrap {
    max-width: 140rem;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 1.2rem;
    color: var(--color-muted-gray);
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .bebop-signature {
    color: var(--color-bebop-amber);
    letter-spacing: 0.15em;
  }
</style>
