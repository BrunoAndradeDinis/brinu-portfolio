---
/**
 * index.astro
 * Bebop Manga Brutalist Noir — Portfolio Landing
 * Orquestrador limpo e modular das seções principais.
 * Zero código chumbado. Estilos centralizados e desacoplados por componente e domínio.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ComicNav from '../components/ComicNav.astro';
import ComicHero from '../components/ComicHero.astro';
import StoryboardReel from '../components/StoryboardReel.astro';
import BebopFooter from '../components/BebopFooter.astro';
---

<BaseLayout title="Bruno Dinis // Brinu — Software Engineer & Creative Technologist">
  <main id="main-content" class="bebop-home">
    <!-- Top Bar Editorial Manga / mew.xyz -->
    <ComicNav />

    <!-- Hero Monumental Carmesim & Tipografia Colossal "BRINU" -->
    <ComicHero />

    <!-- Tiras de Película 35mm & Cases Autorais -->
    <StoryboardReel />

    <!-- Rodapé Minimalista Noir -->
    <BebopFooter />
  </main>
</BaseLayout>

<style>
  .bebop-home {
    background-color: var(--color-bebop-red);
    color: var(--color-space-base);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
  }
</style>
