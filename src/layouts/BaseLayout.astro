---
import "../styles/tokens.css";
import "../styles/global.css";
import IntroPreloader from "../components/IntroPreloader.astro";
import CockpitMenu from "../components/CockpitMenu";
import RightClickGuard from "../components/RightClickGuard";
import CiladaAlert from "../components/CiladaAlert";
import { ptBrDict } from "../i18n/dictionaries";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = ptBrDict.meta.title,
  description = ptBrDict.meta.description,
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,100..900;1,62..125,100..900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Permanent+Marker&family=Space+Mono:ital,wght@0,400;0,700;1,400&family=Syne:wght@700;800;900&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <IntroPreloader />

    <div id="p5-wipe-overlay" aria-hidden="true">
      <div class="p5-wipe-blade-red"></div>
    </div>

    <div id="app-root">
      <slot />
    </div>

    <CockpitMenu client:load />
    <RightClickGuard client:load />
    <CiladaAlert client:load />

    <script>
      import { initMotionCoordinator } from "../utils/motion";
      import { audioSynth } from "../utils/audio";
      import { initTelemetry } from "../utils/telemetry";
      import { initI18nBindings } from "../i18n/index";

      function bootstrapRuntime() {
        if (typeof window !== "undefined") {
          (window as unknown as { bebopAudio: typeof audioSynth }).bebopAudio = audioSynth;
          initTelemetry();
          initI18nBindings();
        }
        initMotionCoordinator();
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", bootstrapRuntime);
      } else {
        bootstrapRuntime();
      }
      document.addEventListener("astro:page-load", bootstrapRuntime);
    </script>
  </body>
</html>
