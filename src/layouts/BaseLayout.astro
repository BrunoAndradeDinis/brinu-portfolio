---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import "../styles/tokens.css";
import "../styles/global.css";
import IntroPreloader from "../components/IntroPreloader.astro";
import ComicNav from "../components/ComicNav.astro";
import CockpitMenu from "../components/CockpitMenu";
import CiladaAlert from "../components/CiladaAlert";
import { ptBrDict } from "../i18n/dictionaries";
import { PROFILE, buildPersonJsonLd } from "../data/profile";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalPath?: string;
  intro?: boolean;
}

const {
  title = ptBrDict.meta.title,
  description = ptBrDict.meta.description,
  ogImage = "/assets/brinu-avatar.jpg",
  canonicalPath,
  intro = false,
} = Astro.props;

const personJsonLd = JSON.stringify(buildPersonJsonLd());
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />

    <Font cssVariable="--font-syne" preload />
    <Font cssVariable="--font-archivo" preload />
    <Font cssVariable="--font-space-mono" />
    <Font cssVariable="--font-permanent-marker" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={PROFILE.fullName} />
    <meta name="theme-color" content="#FE0000" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalPath && <link rel="canonical" href={canonicalPath} />}
    {canonicalPath && <meta property="og:url" content={canonicalPath} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="pt_BR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script
      is:inline
      type="application/ld+json"
      id="profile-jsonld"
      set:html={personJsonLd}
    />
  </head>
  <body>
    <a
      id="skip-to-content-link"
      href="#main-content"
      data-i18n="a11y.skipToContent"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[9999] focus:border-4 focus:border-paper-white focus:bg-bebop-red focus:px-5 focus:py-3 focus:font-mono focus:text-xs focus:font-black focus:uppercase focus:tracking-widest focus:text-paper-white focus:shadow-[6px_6px_0_var(--color-space-base)] focus:outline-none"
    >
      {ptBrDict.a11y.skipToContent}
    </a>

    {intro && <IntroPreloader />}

    <div id="p5-wipe-overlay" aria-hidden="true" transition:persist="p5-wipe-overlay">
      <div class="p5-wipe-blade-red"></div>
    </div>

    <ComicNav />

    <div id="app-root" class="pt-[5.5rem] sm:pt-[6.5rem] md:pt-[7rem]">
      <slot />
    </div>

    <div transition:persist="cockpit-menu"><CockpitMenu client:load /></div>
    <div transition:persist="cilada-alert"><CiladaAlert client:load /></div>

    <script>
      import { initMotionCoordinator } from "../utils/motion";
      import { audioSynth } from "../utils/audio";
      import { initTelemetry } from "../utils/telemetry";
      import { initI18nBindings } from "../i18n/index";
      import { installRouterLifecycle, onPageReady } from "../utils/page-lifecycle";

      let sessionBooted = false;

      installRouterLifecycle();
      onPageReady(() => {
        if (!sessionBooted) {
          sessionBooted = true;
          (window as unknown as { bebopAudio: typeof audioSynth }).bebopAudio = audioSynth;
          initTelemetry();
        }
        initI18nBindings();
        initMotionCoordinator();
      });
    </script>
  </body>
</html>
