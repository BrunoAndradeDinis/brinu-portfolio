---
/**
 * BaseLayout.astro
 * Root HTML shell for the Bebop Brutalist Portfolio.
 * Centralizes design tokens, global styles, Google Fonts typography, Intro Preloader, and CRT overlay.
 */
import "../styles/tokens.css";
import "../styles/global.css";
// import CrtOverlay from '../components/CrtOverlay.astro';
import IntroPreloader from "../components/IntroPreloader.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Bruno Dinis // Brinu — Software Engineer & Creative Technologist",
  description = "Portfólio de engenharia de software e experiências digitais de Bruno de Andrade Dinis (Brinu). Foco em TypeScript, React, Astro e arquitetura de alta performance.",
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts Preconnect & Load (Syne, Permanent Marker, Space Mono, Inter) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Permanent+Marker&family=Space+Mono:ital,wght@0,400;0,700;1,400&family=Syne:wght@700;800;900&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <!-- Abertura Cinemática com Transição de Cortina "BRINU" -->
    <IntroPreloader />

    <div id="app-root">
      <slot />
    </div>

    <!-- Retro CRT Scanline & Phosphor Overlay (Sutil e Atmosférico) -->
    {/*<CrtOverlay />*/}

    <!-- Coordenador de Movimento Unificado (Lenis + GSAP ScrollTrigger) -->
    <script>
      import { initMotionCoordinator } from "../utils/motion";

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", () => {
          initMotionCoordinator();
        });
      } else {
        initMotionCoordinator();
      }
    </script>
  </body>
</html>

