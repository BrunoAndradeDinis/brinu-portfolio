www.brinu.xyz {
	redir https://brinu.xyz{uri} permanent
}

brinu.xyz {
	root * /var/www/brinu/current
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@html path / */ *.html
	header @html Cache-Control "no-cache"

	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	header ?Cache-Control "public, max-age=604800"

	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}

	log {
		output file /var/log/caddy/brinu.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
